---
import type { PreviewEdge, PreviewGraph, PreviewNode } from "../lib/stack-preview";

interface Props {
  graph: PreviewGraph;
  size?: "wide" | "path";
}

const { graph, size = "path" } = Astro.props;
const gradientId = `sp-edge-${graph.id}`;

function pct(value: string) {
  return Number.parseFloat(value);
}

function quad(from: { x: string; y: string }, to: { x: string; y: string }) {
  const x1 = pct(from.x);
  const y1 = pct(from.y);
  const x2 = pct(to.x);
  const y2 = pct(to.y);
  const cx = (x1 + x2) / 2 + (y1 - y2) * 0.12;
  const cy = (y1 + y2) / 2 + (x2 - x1) * 0.12;
  return {
    d: `M ${x1} ${y1} Q ${cx} ${cy} ${x2} ${y2}`,
    mx: (x1 + x2) / 2 + (y1 - y2) * 0.06,
    my: (y1 + y2) / 2 + (x2 - x1) * 0.06,
  };
}

function nodeById(id: string): PreviewNode {
  return graph.nodes.find((n) => n.id === id)!;
}
---

<figure class="sp-field" data-sp-root={graph.id}>
  {graph.title ? <p class="sp-path-kicker">{graph.title}</p> : null}
  <div
    class:list={[
      "sp-canvas",
      size === "wide" ? "sp-canvas--wide" : "sp-canvas--path",
    ]}
    role="group"
    aria-label={graph.aria}
  >
    <div class="sp-orbits" aria-hidden="true">
      <span class="sp-orbit sp-orbit--a"></span>
      <span class="sp-orbit sp-orbit--b"></span>
    </div>
    <svg
      class="sp-edges"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id={gradientId} x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="rgba(14,165,233,0.85)"></stop>
          <stop offset="100%" stop-color="rgba(212,160,23,0.7)"></stop>
        </linearGradient>
      </defs>
      {
        graph.edges.map((edge: PreviewEdge) => {
          const path = quad(nodeById(edge.from), nodeById(edge.to));
          return (
            <g
              data-edge={`${edge.from}-${edge.to}`}
              data-from={edge.from}
              data-to={edge.to}
            >
              <path
                d={path.d}
                fill="none"
                stroke={`url(#${gradientId})`}
                stroke-width={edge.dotted ? "0.55" : "0.45"}
                stroke-linecap="round"
                stroke-dasharray={edge.dotted ? "2.4 1.8" : undefined}
                class="sp-edge"
              ></path>
            </g>
          );
        })
      }
    </svg>
    {
      graph.edges.map((edge: PreviewEdge) => {
        const path = quad(nodeById(edge.from), nodeById(edge.to));
        return (
          <span
            class="sp-edge-label"
            data-from={edge.from}
            data-to={edge.to}
            style={`left:${path.mx}%;top:${path.my}%`}
          >
            {edge.label}
            {edge.sublabel ? <em>{edge.sublabel}</em> : null}
          </span>
        );
      })
    }
    {
      graph.nodes.map((node) => (
        <button
          type="button"
          class:list={[
            "sp-node",
            node.hub && "sp-node--hub",
            node.gold && "sp-node--gold",
          ]}
          style={`left:${node.x};top:${node.y}`}
          data-node={node.id}
          aria-pressed="false"
          aria-label={`${node.label}: ${node.sentence}`}
        >
          <span class="sp-node__disk">
            <span class="sp-node__name">{node.label}</span>
          </span>
          {node.sublabel ? (
            <span class="sp-node__sub">{node.sublabel}</span>
          ) : null}
        </button>
      ))
    }
  </div>
  <figcaption class="sp-caption">{graph.caption}</figcaption>
  <aside class="sp-drawer" data-sp-drawer hidden aria-live="polite">
    <p class="sp-drawer__name" data-sp-drawer-name></p>
    <p class="sp-drawer__sentence" data-sp-drawer-sentence></p>
  </aside>
</figure>

<style>
  .sp-field {
    margin: 0;
    min-width: 0;
  }

  .sp-canvas {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(63, 75, 95, 0.85);
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 42%,
        rgba(14, 165, 233, 0.1),
        transparent 60%
      ),
      radial-gradient(
        ellipse 40% 35% at 80% 25%,
        rgba(212, 160, 23, 0.08),
        transparent 50%
      ),
      linear-gradient(180deg, rgba(12, 18, 32, 0.95), rgba(8, 12, 22, 0.98));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 24px 48px -24px rgba(0, 0, 0, 0.55);
  }

  .sp-canvas--wide {
    height: clamp(30rem, 84vw, 38rem);
  }

  .sp-canvas--path {
    height: clamp(26rem, 78vw, 30rem);
  }

  .sp-orbits {
    pointer-events: none;
    position: absolute;
    inset: 0;
  }

  .sp-orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 9999px;
    border: 1px solid rgba(14, 165, 233, 0.12);
    transform: translate(-50%, -50%);
  }

  .sp-orbit--a {
    width: min(42%, 12rem);
    height: min(42%, 12rem);
  }

  .sp-orbit--b {
    width: min(72%, 21rem);
    height: min(72%, 21rem);
    border-color: rgba(212, 160, 23, 0.12);
    border-style: dashed;
  }

  .sp-edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sp-edge {
    opacity: 0.88;
    transition: opacity 0.25s ease;
  }

  .sp-edge--dim {
    opacity: 0.12 !important;
  }

  .sp-edge--lit {
    opacity: 1 !important;
  }

  .sp-edge-label {
    position: absolute;
    z-index: 4;
    transform: translate(-50%, -50%);
    pointer-events: none;
    max-width: 8.5rem;
    text-align: center;
    font-size: 0.625rem;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: #e4e4e7;
    text-shadow: 0 1px 8px rgba(10, 18, 32, 0.95);
    transition: opacity 0.25s ease;
  }

  .sp-edge-label em {
    display: block;
    font-style: normal;
    color: #a1a1aa;
  }

  .sp-edge-label.sp-edge--dim {
    opacity: 0.16;
  }

  .sp-node {
    position: absolute;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    transform: translate(-50%, -50%);
    cursor: pointer;
    appearance: none;
    transition:
      opacity 0.25s ease,
      filter 0.25s ease;
  }

  .sp-node__disk {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 9999px;
    border: 1px solid rgba(14, 165, 233, 0.45);
    background: rgba(14, 165, 233, 0.16);
    box-shadow: 0 0 22px rgba(14, 165, 233, 0.18);
    backdrop-filter: blur(8px);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .sp-node--hub .sp-node__disk {
    width: 7.15rem;
    height: 7.15rem;
    border-color: rgba(212, 160, 23, 0.65);
    background: rgba(212, 160, 23, 0.16);
    box-shadow: 0 0 28px rgba(212, 160, 23, 0.22);
  }

  .sp-node--gold .sp-node__disk {
    border-color: rgba(212, 160, 23, 0.55);
    background: rgba(212, 160, 23, 0.14);
    box-shadow: 0 0 20px rgba(212, 160, 23, 0.16);
  }

  .sp-node__name {
    max-width: 5.4rem;
    padding: 0 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-align: center;
    color: #fafafa;
  }

  .sp-node--hub .sp-node__name {
    font-size: 0.95rem;
  }

  .sp-node__sub {
    position: absolute;
    top: calc(100% + 0.28rem);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 9.5rem;
    text-align: center;
    font-size: 0.625rem;
    line-height: 1.25;
    color: #d4a017;
  }

  .sp-node:hover .sp-node__disk,
  .sp-node:focus-visible .sp-node__disk,
  .sp-node--selected .sp-node__disk {
    transform: scale(1.06);
  }

  .sp-node:focus-visible .sp-node__disk {
    outline: 2px solid rgba(14, 165, 233, 0.75);
    outline-offset: 3px;
  }

  .sp-node--selected .sp-node__disk {
    box-shadow:
      0 0 0 1px rgba(212, 160, 23, 0.4),
      0 0 32px rgba(212, 160, 23, 0.28);
  }

  .sp-node--dim {
    opacity: 0.22;
    filter: saturate(0.55);
  }

  .sp-node--lit {
    opacity: 1;
    filter: none;
  }

  .sp-caption {
    margin-top: 0.85rem;
    max-width: 36rem;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #a1a1aa;
  }

  .sp-path-kicker {
    margin: 0 0 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #38bdf8;
  }

  .sp-drawer {
    margin-top: 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(63, 75, 95, 0.85);
    background: rgba(10, 18, 32, 0.72);
    padding: 1rem 1.15rem;
  }

  .sp-drawer__name {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fafafa;
  }

  .sp-drawer__sentence {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: #a1a1aa;
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-node,
    .sp-node__disk,
    .sp-edge,
    .sp-edge-label {
      transition: none;
    }
  }
</style>
