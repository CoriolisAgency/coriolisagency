---
import type { FaqItem } from "../lib/faq";

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = "Questions we get" } = Astro.props;
---

<section class="border-t border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
    <h2 class="text-lg font-semibold text-white">{heading}</h2>
    <dl class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        items.map((item) => (
          <div class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-5">
            <dt class="text-sm font-semibold text-zinc-100">{item.q}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-zinc-400">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
