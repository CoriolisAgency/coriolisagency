---
import { withBase } from "../lib/base";
import { LINKS } from "../lib/links";

const items = [
  { href: "ecommerce", label: "FFL website plans" },
  { href: "ecommerce", hash: "ffl-accelerator", label: "FFL Accelerator" },
  { href: "firearms-dropshipping", label: "Firearms dropshipping" },
  { href: "ffl-cockpit", label: "FFL Cockpit websites" },
  { href: "gun-friendly-hosting", label: "Gun-friendly hosting" },
  { href: "ammoready-alternative", label: "AmmoReady alternative" },
  { href: "gearfire-alternative", label: "Gearfire alternative" },
  { href: "best-ffl-ecommerce-website", label: "Best FFL ecommerce website" },
  { href: "email-marketing-for-ffl-ecommerce", label: "FFL email marketing" },
  { href: "ffl-payment-processing", label: "FFL payment processing" },
  { href: "woocommerce-vs-shopify-for-gun-stores", label: "WooCommerce vs Shopify" },
  { href: "websites-for-ranges-gunsmiths-instructors", label: "Range and gunsmith websites" },
  { href: "ffl-seo", label: "FFL SEO automation" },
  { href: LINKS.gse, label: "GunSearchEngine.com", external: true },
] as const;

interface Props {
  current?: (typeof items)[number]["href"];
}

const { current } = Astro.props;
---

<nav
  class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-sm text-zinc-400"
  aria-label="FFL ecommerce"
>
  {
    items.map((item) => {
      const external = "external" in item && item.external;
      const hash = "hash" in item && item.hash ? `#${item.hash}` : "";
      const isCurrent = !external && !hash && item.href === current;
      return isCurrent ? (
        <span class="text-zinc-200">{item.label}</span>
      ) : (
        <a
          href={external ? item.href : `${withBase(item.href)}${hash}`}
          class="text-sky-400 hover:underline underline-offset-2"
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
        >
          {item.label}
        </a>
      );
    })
  }
</nav>
