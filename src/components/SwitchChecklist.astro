---
import { SWITCH_FOUNDER, SWITCH_STEPS } from "../lib/switch";

interface Props {
  founderNote?: boolean;
  /** Override the default steps (e.g. SWITCH_STEPS_NEUTRAL). */
  steps?: readonly string[];
}

const { founderNote = false, steps = SWITCH_STEPS } = Astro.props;
---

<ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-zinc-400">
  {steps.map((step) => <li>{step}</li>)}
</ol>
{
  founderNote && (
    <p class="mt-4 text-sm leading-relaxed text-zinc-400">{SWITCH_FOUNDER}</p>
  )
}
