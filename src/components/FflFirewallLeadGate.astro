---
/**
 * FFLFW-LANDING: accessible early-access lead modal for the two
 * data-early-access buttons on /ffl-firewall. Modeled on the FFL Filters
 * download gate, with no file to download and without starting a download.
 * Posts to the existing /api/lead path; this file does not touch the handler.
 */
---

<div
  hidden
  data-fflfw-ea-gate
  data-action="/api/lead"
  data-page="/ffl-firewall"
  data-min-fill-ms="3000"
>
  <div data-fflfw-ea-backdrop class="fflfw-ea-backdrop"></div>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="fflfw-ea-title"
    aria-describedby="fflfw-ea-desc"
    data-fflfw-ea-dialog
    class="fflfw-ea-dialog"
  >
    <button type="button" class="fflfw-ea-close" data-fflfw-ea-close aria-label="Close">
      <span aria-hidden="true">&times;</span>
    </button>
    <div data-fflfw-ea-form-view>
      <h2 id="fflfw-ea-title" class="fflfw-ea-title">Get early access</h2>
      <p id="fflfw-ea-desc" class="fflfw-ea-desc">Enter your company name, website URL, and email.</p>
      <form data-fflfw-ea-form class="fflfw-ea-form" novalidate>
        <label class="fflfw-ea-field">
          Company Name
          <input name="company" type="text" required autocomplete="organization" maxlength="200" />
        </label>
        <label class="fflfw-ea-field">
          URL
          <input name="website" type="text" required autocomplete="url" inputmode="url" maxlength="300" placeholder="https://" />
        </label>
        <label class="fflfw-ea-field">
          Email
          <input name="email" type="email" required autocomplete="email" maxlength="200" />
        </label>
        <label class="fflfw-ea-hp" aria-hidden="true">
          Company URL
          <input name="company_url" tabindex="-1" autocomplete="off" />
        </label>
        <p class="fflfw-ea-error" data-fflfw-ea-error role="alert"></p>
        <button type="submit" class="fflfw-ea-submit" data-fflfw-ea-submit>Get early access</button>
      </form>
    </div>
    <div data-fflfw-ea-thanks hidden>
      <h2 id="fflfw-ea-thanks-title" class="fflfw-ea-title">Thank you</h2>
      <p class="fflfw-ea-desc">
        We'll write when FFL Firewall is ready to try. If you need help in the meantime, write to{' '}
        <a href="mailto:support@coriolisagency.com" class="fflfw-ea-mail">support@coriolisagency.com</a>.
      </p>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  var KEY = "lf_touch_v1";
  var ATTR_PARAMS = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid", "gbraid", "wbraid", "fbclid", "twclid"];
  var gate = document.querySelector("[data-fflfw-ea-gate]");
  if (!gate || gate.getAttribute("data-fflfw-ready") === "1") return;
  gate.setAttribute("data-fflfw-ready", "1");

  var dialog = gate.querySelector("[data-fflfw-ea-dialog]");
  var formView = gate.querySelector("[data-fflfw-ea-form-view]");
  var thanksView = gate.querySelector("[data-fflfw-ea-thanks]");
  var form = gate.querySelector("[data-fflfw-ea-form]");
  var errorEl = gate.querySelector("[data-fflfw-ea-error]");
  var submitBtn = gate.querySelector("[data-fflfw-ea-submit]");
  var closeBtn = gate.querySelector("[data-fflfw-ea-close]");
  var action = gate.getAttribute("data-action") || "/api/lead";
  var pagePath = gate.getAttribute("data-page") || "/ffl-firewall";
  var minFillMs = Number(gate.getAttribute("data-min-fill-ms") || "3000");
  if (!Number.isFinite(minFillMs) || minFillMs < 0) minFillMs = 3000;

  var openedAt = 0;
  var lastTrigger = null;
  var previousOverflow = "";
  var sending = false;

  function isOpen() {
    return !gate.hasAttribute("hidden");
  }

  function readTouch() {
    try {
      var data = JSON.parse(localStorage.getItem(KEY) || "null");
      if (!data || typeof data !== "object" || !(data.expires > Date.now())) return null;
      return data;
    } catch (err) {
      return null;
    }
  }

  function externalRef() {
    if (!document.referrer) return "";
    try {
      var host = new URL(document.referrer).host;
      if (!host || host === location.host) return "";
      return host.slice(0, 200);
    } catch (err) {
      return "";
    }
  }

  function currentParams() {
    var out = {};
    var query = new URLSearchParams(location.search);
    for (var i = 0; i < ATTR_PARAMS.length; i++) {
      var value = query.get(ATTR_PARAMS[i]);
      if (value) out[ATTR_PARAMS[i]] = value.trim().slice(0, 200);
    }
    return out;
  }

  function normalizeUrl(raw) {
    var value = String(raw || "").trim();
    if (!value) return "";
    if (!/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(value)) value = "https://" + value;
    try {
      var url = new URL(value);
      if (url.protocol !== "http:" && url.protocol !== "https:") return "";
      return url.href;
    } catch (err) {
      return "";
    }
  }

  function setError(message) {
    if (!errorEl) return;
    errorEl.replaceChildren();
    if (message) errorEl.appendChild(document.createTextNode(message));
  }

  function setSendFailedError() {
    if (!errorEl) return;
    errorEl.replaceChildren();
    errorEl.appendChild(document.createTextNode("We couldn't send that. Try again, or write to "));
    var a = document.createElement("a");
    a.href = "mailto:support@coriolisagency.com";
    a.className = "fflfw-ea-mail";
    a.textContent = "support@coriolisagency.com";
    errorEl.appendChild(a);
    errorEl.appendChild(document.createTextNode("."));
  }

  function focusables() {
    if (!dialog) return [];
    var nodes = dialog.querySelectorAll(
      'a[href], button:not([disabled]), input:not([disabled]):not([tabindex="-1"]), textarea:not([disabled]), select:not([disabled])'
    );
    return Array.prototype.filter.call(nodes, function (el) {
      if (el.closest("[hidden]")) return false;
      if (el.getAttribute("aria-hidden") === "true") return false;
      return true;
    });
  }

  function showForm() {
    if (formView) formView.removeAttribute("hidden");
    if (thanksView) thanksView.setAttribute("hidden", "");
    if (dialog) {
      dialog.setAttribute("aria-labelledby", "fflfw-ea-title");
      dialog.setAttribute("aria-describedby", "fflfw-ea-desc");
    }
    setError("");
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = "Get early access";
    }
  }

  function showThanks() {
    if (formView) formView.setAttribute("hidden", "");
    if (thanksView) thanksView.removeAttribute("hidden");
    if (dialog) {
      dialog.setAttribute("aria-labelledby", "fflfw-ea-thanks-title");
      dialog.removeAttribute("aria-describedby");
    }
    var mail = thanksView && thanksView.querySelector("a");
    if (mail && typeof mail.focus === "function") mail.focus();
    else if (closeBtn && typeof closeBtn.focus === "function") closeBtn.focus();
  }

  function openModal(trigger) {
    if (sending) return;
    lastTrigger = trigger || lastTrigger;
    openedAt = Date.now();
    showForm();
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    gate.removeAttribute("hidden");
    var company = form && form.querySelector('input[name="company"]');
    if (company && typeof company.focus === "function") company.focus();
  }

  function closeModal() {
    if (!isOpen()) return;
    gate.setAttribute("hidden", "");
    document.body.style.overflow = previousOverflow;
    if (form && !sending) {
      if (thanksView && !thanksView.hasAttribute("hidden")) {
        form.reset();
        showForm();
      }
    }
    if (lastTrigger && typeof lastTrigger.focus === "function") lastTrigger.focus();
  }

  function startedAtStamp() {
    var now = Date.now();
    var started = openedAt || now;
    if (now - started < minFillMs) return now - minFillMs - 1000;
    return started;
  }

  function onClick(event) {
    if (event.defaultPrevented) return;
    if (event.button != null && event.button !== 0) return;
    var target = event.target;
    if (!target || !target.closest) return;
    var link = target.closest("a[data-early-access]");
    if (!link) return;
    event.preventDefault();
    event.stopPropagation();
    openModal(link);
  }

  function onKeydown(event) {
    if (!isOpen()) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeModal();
      return;
    }
    if (event.key !== "Tab") return;
    var items = focusables();
    if (!items.length) return;
    var first = items[0];
    var last = items[items.length - 1];
    if (event.shiftKey) {
      if (document.activeElement === first || !dialog.contains(document.activeElement)) {
        event.preventDefault();
        last.focus();
      }
    } else if (document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  function validate(company, website, email) {
    if (!company) return "Company name is required.";
    if (!email) return "Email is required.";
    if (!EMAIL_RE.test(email)) return "That email does not look valid.";
    if (!website) return "URL is required.";
    return "";
  }

  function onSubmit(event) {
    event.preventDefault();
    if (sending || !form) return;
    var data = new FormData(form);
    var company = String(data.get("company") || "").trim();
    var email = String(data.get("email") || "").trim();
    var website = normalizeUrl(data.get("website"));
    var message = validate(company, website, email);
    if (message) {
      setError(message);
      if (!company) form.querySelector('input[name="company"]').focus();
      else if (!email || !EMAIL_RE.test(email)) form.querySelector('input[name="email"]').focus();
      else form.querySelector('input[name="website"]').focus();
      return;
    }
    setError("");
    sending = true;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending\u2026";
    }

    var touch = readTouch();
    var params = Object.assign({}, touch || {}, currentParams());
    var landing =
      touch && typeof touch.landing === "string" && touch.landing.charAt(0) === "/"
        ? touch.landing
        : location.pathname;
    var ref = touch && typeof touch.ref === "string" ? touch.ref : externalRef();
    var payload = {
      name: company,
      company: company,
      email: email,
      phone: "",
      website: website,
      pillar: "Ecommerce",
      message: "FFL Firewall early access",
      company_url: String(data.get("company_url") || ""),
      site: "coriolisagency",
      page: pagePath,
      landing: landing,
      ref: ref,
      started_at: startedAtStamp(),
    };
    for (var i = 0; i < ATTR_PARAMS.length; i++) {
      var key = ATTR_PARAMS[i];
      payload[key] = params[key] || "";
    }

    var settled = false;
    function finish(ok, status, errName) {
      if (settled) return;
      settled = true;
      sending = false;
      if (ok) {
        if (isOpen()) showThanks();
        return;
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Get early access";
      }
      setSendFailedError();
      console.error("early-access gate: lead failed", status || 0, errName || "error");
    }

    var ctrl = typeof AbortController === "function" ? new AbortController() : null;
    var timer = setTimeout(function () {
      if (ctrl) ctrl.abort();
    }, 15000);

    var opts = {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    };
    if (ctrl) opts.signal = ctrl.signal;

    fetch(action, opts)
      .then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (json) {
          finish(Boolean(res.ok && json && json.ok), res.status, "");
        });
      })
      .catch(function (err) {
        finish(false, 0, err && err.name ? err.name : "error");
      })
      .then(function () {
        clearTimeout(timer);
      });
  }

  document.addEventListener("click", onClick, true);
  document.addEventListener("keydown", onKeydown, true);
  if (closeBtn) closeBtn.addEventListener("click", function () { closeModal(); });
  if (form) form.addEventListener("submit", onSubmit);
})();
</script>

<style>
  [data-fflfw-ea-gate] {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  [data-fflfw-ea-gate][hidden] {
    display: none;
  }
  .fflfw-ea-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 8, 15, 0.72);
  }
  .fflfw-ea-dialog {
    position: relative;
    z-index: 1;
    width: min(28rem, 100%);
    max-height: min(90vh, 40rem);
    overflow: auto;
    box-sizing: border-box;
    padding: 1.5rem 1.5rem 1.25rem;
    border: 1px solid #27272a;
    border-radius: 2px;
    background: #0a1220;
    color: #e4e4e7;
    color-scheme: dark;
  }
  .fflfw-ea-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    background: transparent;
    color: #a1a1aa;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .fflfw-ea-close:hover {
    color: #fff;
  }
  .fflfw-ea-close:focus-visible,
  .fflfw-ea-field input:focus-visible,
  .fflfw-ea-submit:focus-visible,
  .fflfw-ea-mail:focus-visible {
    outline: 2px solid #c8960c;
    outline-offset: 2px;
  }
  .fflfw-ea-title {
    margin: 0 2rem 0 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .fflfw-ea-desc {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #a1a1aa;
  }
  .fflfw-ea-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.15rem;
  }
  .fflfw-ea-field {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: #d4d4d8;
  }
  .fflfw-ea-field input {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-top: 0.25rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid #3f3f46;
    border-radius: 2px;
    background: #07080c;
    color: #f4f4f5;
    font: inherit;
    font-size: 0.875rem;
  }
  .fflfw-ea-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .fflfw-ea-error {
    min-height: 1.25rem;
    margin: 0;
    font-size: 0.875rem;
    color: #fcd34d;
  }
  .fflfw-ea-submit {
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    margin-top: 0.15rem;
    border: 1px solid #8a6a0a;
    border-radius: 2px;
    background: #c8960c;
    color: #05080f;
    padding: 0.75rem 1.25rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }
  .fflfw-ea-submit:hover {
    background: #e0a910;
  }
  .fflfw-ea-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .fflfw-ea-mail {
    color: #38bdf8;
    font-weight: 500;
    text-underline-offset: 2px;
  }
  .fflfw-ea-mail:hover {
    text-decoration: underline;
  }
  @media (min-width: 640px) {
    .fflfw-ea-submit {
      width: auto;
      align-self: flex-start;
    }
  }
</style>
