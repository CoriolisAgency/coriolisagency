---
/** Service glyphs from Brandy's v2 landing mock (decorative). */
interface Props {
  kind: "active-defense" | "overwatch" | "recon";
  size?: number;
}
const { kind, size = 36 } = Astro.props;
---
{kind === "active-defense" && (
  <svg class="glyph" width={size} height={size} viewBox="0 0 96 96" aria-hidden="true"><path d="M48 8 L84 21 V46 C84 68 68 82 48 90 C28 82 12 68 12 46 V21 Z" fill="none" stroke="#E4E4E7" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><g transform="translate(0 -3.125)"><line x1="48" y1="43" x2="48" y2="37.5" stroke="#E53E3E" stroke-width="3.5" stroke-linecap="round"/><circle cx="48" cy="35.5" r="2.5" fill="#E53E3E"/><rect x="35.5" y="43" width="25" height="22" rx="5.5" fill="none" stroke="#E53E3E" stroke-width="3.5" stroke-linejoin="round"/><circle cx="42.5" cy="53.5" r="2.5" fill="#E53E3E"/><circle cx="53.5" cy="53.5" r="2.5" fill="#E53E3E"/></g></svg>
)}
{kind === "overwatch" && (
  <svg class="glyph" width={size} height={size} viewBox="0 0 96 96" aria-hidden="true"><circle cx="48" cy="48" r="38" fill="none" stroke="#E4E4E7" stroke-width="5"/><circle cx="48" cy="48" r="20" fill="none" stroke="#E4E4E7" stroke-width="3" opacity=".6"/><path d="M48 48 L48 10 A38 38 0 0 1 75 21 Z" fill="#E53E3E" opacity=".85"/><path d="M48 48 L48 10" stroke="#E53E3E" stroke-width="4" stroke-linecap="round"/><circle cx="48" cy="48" r="4" fill="#E4E4E7"/><circle cx="30" cy="66" r="4" fill="#E4E4E7" opacity=".8"/></svg>
)}
{kind === "recon" && (
  <svg class="glyph" width={size} height={size} viewBox="0 0 96 96" aria-hidden="true"><circle cx="48" cy="48" r="36" fill="none" stroke="#E4E4E7" stroke-width="5"/><circle cx="48" cy="48" r="22" fill="none" stroke="#E4E4E7" stroke-width="3" opacity=".6"/><circle cx="48" cy="48" r="6" fill="#E53E3E"/><path d="M33 30 A24 24 0 0 1 44 25" stroke="#E4E4E7" stroke-width="3" fill="none" stroke-linecap="round" opacity=".8"/></svg>
)}
