---
import { linkClass } from "../lib/links";
import {
  GOOGLE_REVIEW_COUNT,
  GOOGLE_REVIEW_QUOTES,
  GOOGLE_REVIEW_RATING,
  GOOGLE_REVIEWS_HREF,
} from "../lib/google-reviews";

const starIndexes = [0, 1, 2, 3, 4] as const;
const ratingLabel = `${GOOGLE_REVIEW_RATING.toFixed(1)} out of 5 stars from ${GOOGLE_REVIEW_COUNT} Google reviews`;
---

<section class="border-b border-zinc-800/80 bg-zinc-950/40">
  <div class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex min-w-0 items-start gap-3 sm:gap-4">
        <span
          class="mt-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white shadow-[0_0_0_1px_rgba(255,255,255,0.08)]"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" class="h-6 w-6" role="img">
            <title>Google</title>
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
        </span>
        <div>
          <p
            class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold"
          >
            Google reviews
          </p>
          <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="text-3xl font-semibold tracking-tight text-white"
              >{GOOGLE_REVIEW_RATING.toFixed(1)}</span
            >
            <span
              class="inline-flex items-center gap-0.5 text-[#fbbc04]"
              aria-hidden="true"
            >
              {
                starIndexes.map(() => (
                  <svg
                    class="h-6 w-6 drop-shadow-[0_0_6px_rgba(251,188,4,0.45)]"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                  </svg>
                ))
              }
            </span>
            <span class="sr-only">{ratingLabel}</span>
            <span class="text-sm text-zinc-400">
              {GOOGLE_REVIEW_COUNT} reviews on Google
            </span>
          </p>
        </div>
      </div>
      <a
        href={GOOGLE_REVIEWS_HREF}
        class={linkClass}
        target="_blank"
        rel="noopener noreferrer"
      >
        Read on Google →
      </a>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        GOOGLE_REVIEW_QUOTES.map((q) => (
          <blockquote class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6 ring-1 ring-gold/15">
            <p
              class="inline-flex items-center gap-0.5 text-[#fbbc04]"
              aria-hidden="true"
            >
              {starIndexes.map(() => (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                </svg>
              ))}
            </p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-300">
              “{q.body}”
            </p>
            <footer class="mt-4 text-sm">
              <p class="font-medium text-zinc-100">{q.shop}</p>
              <p class="mt-0.5 text-zinc-500">{q.name}</p>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
