---
/**
 * Homepage partner logo row (OPS-30, decision 2026-10-08-gun-store-pos-pillar).
 * Official logos from each partner's own site, shown as one light-gray
 * silhouette style. Not links, except UNUM. No captions or stats.
 * width/height are the intrinsic aspect ratio at 40px tall, so the row has no layout shift.
 *
 * HOMEPAGE-PARTNERS-BAR (Paul 2026-11-07 4:57 AM ET): FFLM iOS tile (PTT/walkie
 * icon only, no wordmark, no link) immediately right of GunSearchEngine, then
 * MicroBiz POS and OtterText. Full-width slow horizontal scroll. Existing order
 * and FFL Cockpit mark unchanged. Logos stay unlinked.
 * HOMEPAGE-PARTNERS-LOGOS (Paul 2026-11-07 11:42 AM ET): greyscale the FFLM
 * tile (desaturate only). Crop MicroBiz POS to the mark so it reads at row height.
 * HOMEPAGE-PARTNERS-FFLM (Paul 2026-11-07 11:50 AM ET): FFLM walkie as a white
 * silhouette like the other logos (tile background punched out), slightly larger.
 * HOMEPAGE-PARTNERS-FFLM-REMOVE (Paul 2026-11-07 11:55 AM ET): remove the FFLM
 * walkie from the partners bar for now. Remaining logos and scroll unchanged.
 * HOMEPAGE-PARTNERS-UNUM (Paul 2026-11-07 12:03 PM ET): add UNUM after OtterText
 * with the shared silhouette class, linked to https://unumnow.com in a new tab.
 */
import { withBase } from "../lib/base";

const PARTNERS: {
  name: string;
  src: string;
  width: number;
  height: number;
  href?: string;
}[] = [
  { name: "WP Engine", src: "partners/wp-engine.svg", width: 205, height: 40 },
  { name: "FFL Cockpit", src: "partners/ffl-cockpit.svg", width: 130, height: 40 },
  { name: "AIM POS", src: "partners/aim-pos.svg", width: 99, height: 40 },
  { name: "FastBound", src: "partners/fastbound.svg", width: 169, height: 40 },
  { name: "GOAT Payments", src: "partners/goat-payments.png", width: 72, height: 40 },
  { name: "GunSearchEngine.com", src: "partners/gunsearchengine.png", width: 204, height: 40 },
  { name: "MicroBiz POS", src: "partners/microbiz-pos.png", width: 142, height: 40 },
  { name: "OtterText", src: "partners/ottertext.svg", width: 210, height: 40 },
  { name: "UNUM", src: "partners/unum.png", width: 41, height: 40, href: "https://unumnow.com" },
];
---

<section
  class="overflow-hidden border-b border-zinc-800/80 bg-zinc-950/40"
  aria-labelledby="partners-heading"
  data-partner-logos
>
  <div class="w-full py-8 sm:py-10">
    <h2
      id="partners-heading"
      class="text-center text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500"
    >
      Partners
    </h2>
    <div class="partner-marquee mt-6">
      <ul class="partner-track">
        {
          PARTNERS.map((p) => (
            <li class="flex items-center">
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener noreferrer">
                  <img
                    src={withBase(p.src)}
                    alt={`${p.name} logo`}
                    width={p.width}
                    height={p.height}
                    loading="lazy"
                    decoding="async"
                    class="h-7 w-auto opacity-70 brightness-0 invert sm:h-10"
                  />
                </a>
              ) : (
                <img
                  src={withBase(p.src)}
                  alt={`${p.name} logo`}
                  width={p.width}
                  height={p.height}
                  loading="lazy"
                  decoding="async"
                  class="h-7 w-auto opacity-70 brightness-0 invert sm:h-10"
                />
              )}
            </li>
          ))
        }
      </ul>
      <ul class="partner-track" aria-hidden="true">
        {
          PARTNERS.map((p) => (
            <li class="flex items-center">
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener noreferrer" tabindex="-1">
                  <img
                    src={withBase(p.src)}
                    alt=""
                    width={p.width}
                    height={p.height}
                    loading="lazy"
                    decoding="async"
                    class="h-7 w-auto opacity-70 brightness-0 invert sm:h-10"
                  />
                </a>
              ) : (
                <img
                  src={withBase(p.src)}
                  alt=""
                  width={p.width}
                  height={p.height}
                  loading="lazy"
                  decoding="async"
                  class="h-7 w-auto opacity-70 brightness-0 invert sm:h-10"
                />
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .partner-marquee {
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .partner-track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 5.5rem;
    padding-right: 5.5rem;
    animation: partner-scroll 70s linear infinite;
  }

  @keyframes partner-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-marquee {
      overflow-x: auto;
    }

    .partner-track {
      animation: none;
    }

    .partner-marquee > .partner-track[aria-hidden="true"] {
      display: none;
    }
  }
</style>
