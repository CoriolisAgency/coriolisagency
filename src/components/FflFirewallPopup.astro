---
/**
 * CA-FFLF-POPUP: site-wide FFL Firewall promo pop-up (white card F01 on desktop,
 * bottom sheet F02 v2b on phones). Spec: Brandy's popup-v2 BEHAVIOUR.md + COPY.md.
 * No event tracking. The map hero loads only when it opens.
 * BaseLayout renders this only when the older claim pop-up is not mounted, so the
 * two can never stack.
 */
import {
  FFW_POPUP_COPY as C,
  FFW_POPUP_HREF,
  FFW_POPUP_DISMISS_KEY,
  FFW_POPUP_CLICKED_KEY,
  FFW_POPUP_SESSION_KEY,
  FFW_POPUP_DISMISS_DAYS,
  FFW_POPUP_DENY_PREFIXES,
  ffwPopupDenied,
} from "../lib/ffl-firewall-popup";
import { withBase } from "../lib/base";

const base = import.meta.env.BASE_URL || "/";
const raw = Astro.url.pathname;
const path = raw.startsWith(base) ? raw.slice(base.length - 1) : raw;
const show = !ffwPopupDenied(path);

const href = withBase("ffl-firewall/");
const heroSrc = withBase("brand/ffl-firewall/popup/ffl-firewall-us-map-hero.webp");
const lockSrc = withBase("brand/ffl-firewall/ffl-firewall-lockup-on-light.svg");
const iconSrc = withBase("brand/ffl-firewall/icon/ffl-firewall-icon-512.png");
const cfg = JSON.stringify({
  dismissKey: FFW_POPUP_DISMISS_KEY,
  clickedKey: FFW_POPUP_CLICKED_KEY,
  sessionKey: FFW_POPUP_SESSION_KEY,
  days: FFW_POPUP_DISMISS_DAYS,
  deny: FFW_POPUP_DENY_PREFIXES,
}).replace(/</g, "\\u003c");
---

{
  show && (
    <div id="ffw-popup-root" data-ffw-popup hidden>
      <div class="ffw-scrim" data-ffw-scrim />
      <div
        class="ffw-card ffw-modal"
        id="ffw-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="ffw-modal-t"
        tabindex="-1"
        data-ffw-dialog="modal"
      >
        <button type="button" class="ffw-x" data-ffw-close aria-label={C.close}>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        </button>
        <div class="ffw-hero"><img alt="" width="1200" height="768" data-src={heroSrc} decoding="async" /></div>
        <div class="ffw-bd">
          <img class="ffw-lock" alt="FFL Firewall" height="34" data-src={lockSrc} decoding="async" />
          <p class="ffw-eb">{C.eyebrow}</p>
          <h2 id="ffw-modal-t" class="ffw-h">{C.title}</h2>
          <p class="ffw-p">{C.body}</p>
          <p class="ffw-p ffw-pr">{C.price}</p>
        </div>
        <div class="ffw-ft">
          <a class="ffw-go" href={href} data-ffw-cta>{C.cta}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          <button type="button" class="ffw-no" data-ffw-close>{C.later}</button>
          <p class="ffw-fine">{C.fine}</p>
        </div>
      </div>
      <div
        class="ffw-card ffw-sheet"
        id="ffw-sheet"
        role="dialog"
        aria-modal="false"
        aria-labelledby="ffw-sheet-t"
        data-ffw-dialog="sheet"
      >
        <div class="ffw-grab" aria-hidden="true"></div>
        <button type="button" class="ffw-x" data-ffw-close aria-label={C.close}>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
        </button>
        <div class="ffw-hero"><img alt="" width="1200" height="768" data-src={heroSrc} decoding="async" /></div>
        <div class="ffw-bd">
          <div class="ffw-row"><img class="ffw-ico" alt="FFL Firewall" width="30" height="30" data-src={iconSrc} decoding="async" /><h2 id="ffw-sheet-t" class="ffw-h">{C.sheetTitle}</h2></div>
          <p class="ffw-p">{C.sheetBody}</p>
          <div class="ffw-acts">
            <a class="ffw-go" href={href} data-ffw-cta>{C.cta}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <button type="button" class="ffw-no" data-ffw-close>{C.later}</button>
          </div>
        </div>
      </div>
      <script type="application/json" id="ffw-popup-cfg" set:html={cfg} />
      <script is:inline src={withBase("popup/ffl-firewall-popup.js")} defer />
    </div>
  )
}

<style is:global>
  #ffw-popup-root[hidden]{display:none}
  #ffw-popup-root{font-family:"Noto Sans","Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  #ffw-popup-root *{box-sizing:border-box}
  .ffw-scrim{position:fixed;inset:0;z-index:2147483000;background:rgba(3,6,12,.62);opacity:0;transition:opacity .25s ease}
  .ffw-card{position:fixed;z-index:2147483001;background:#fff;color:#18181b;border-radius:12px;box-shadow:0 30px 80px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.08);overflow:hidden;display:none;flex-direction:column;opacity:0;transition:opacity .25s ease,transform .3s ease}
  .ffw-x{position:absolute;top:10px;right:10px;width:40px;height:40px;border:0;border-radius:999px;background:rgba(255,255,255,.85);color:#3f3f46;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;padding:0}
  .ffw-x:focus-visible,.ffw-no:focus-visible,.ffw-go:focus-visible{outline:3px solid #2563eb;outline-offset:2px}
  .ffw-hero{flex:none;background:linear-gradient(180deg,#fff 0%,#f4f4f5 100%);border-bottom:1px solid #e4e4e7;display:flex;align-items:center;justify-content:center}
  .ffw-hero img{display:block;width:100%;height:100%;object-fit:contain}
  .ffw-bd{padding:18px 32px 8px;overflow-y:auto;flex:1 1 auto;min-height:0}
  .ffw-lock{display:block;height:34px;width:auto;margin:0 0 12px -4px}
  .ffw-eb{margin:0;font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#52525b}
  .ffw-h{margin:6px 0 0;font-size:25px;line-height:1.22;font-weight:700;letter-spacing:-.015em;color:#18181b}
  .ffw-p{margin:10px 0 0;font-size:15px;line-height:1.55;color:#3f3f46}
  .ffw-pr{color:#18181b}
  .ffw-ft{flex:none;padding:8px 32px 16px}
  .ffw-go{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;background:#18181b;color:#fff;font-weight:700;font-size:16px;padding:15px 20px;border-radius:8px;text-decoration:none}
  .ffw-go:hover{background:#27272a}
  .ffw-no{display:block;margin:10px auto 0;border:0;background:none;color:#52525b;font:600 14px/1.4 inherit;padding:8px 12px;cursor:pointer}
  .ffw-fine{margin:6px 0 0;text-align:center;font-size:12px;color:#71717a}
  /* desktop modal (F01): 640 px, hero 350 / 240, 90vh cap */
  .ffw-modal{left:50%;top:50%;width:640px;max-width:calc(100vw - 32px);max-height:90vh;transform:translate(-50%,-48%)}
  .ffw-modal .ffw-hero{height:350px;padding:20px 28px 14px}
  @media (max-height:859px){.ffw-modal .ffw-hero{height:240px}}
  /* phone sheet (F02 v2b): 126 px hero, 96 px under 700 px tall */
  .ffw-sheet{left:0;right:0;bottom:0;border-radius:18px 18px 0 0;transform:translateY(24px);touch-action:pan-x}
  .ffw-sheet .ffw-hero{height:126px;padding:14px 14px 4px}
  .ffw-sheet .ffw-bd{padding:12px 18px 6px;overflow:visible}
  .ffw-sheet .ffw-h{font-size:18px;margin:0}
  .ffw-sheet .ffw-p{font-size:14px;margin-top:8px}
  .ffw-row{display:flex;align-items:center;gap:10px}
  .ffw-ico{width:30px;height:30px;flex:none;border-radius:7px}
  .ffw-acts{display:flex;align-items:center;gap:10px;margin:14px 0 0}
  .ffw-acts .ffw-go{flex:1;padding:13px 16px;font-size:15px}
  .ffw-acts .ffw-no{margin:0;flex:none;min-height:44px}
  .ffw-sheet .ffw-x{top:12px;right:8px}
  .ffw-grab{position:absolute;top:8px;left:50%;margin-left:-20px;width:40px;height:4px;border-radius:2px;background:#a1a1aa;z-index:2}
  .ffw-sheet{padding-bottom:6px}
  @media (max-height:699px){.ffw-sheet .ffw-hero{height:96px;padding-top:12px}}
  /* which card shows */
  #ffw-popup-root[data-mode="modal"] .ffw-modal,#ffw-popup-root[data-mode="sheet"] .ffw-sheet{display:flex}
  #ffw-popup-root[data-mode="sheet"] .ffw-scrim{display:none}
  #ffw-popup-root[data-open] .ffw-scrim{opacity:1}
  #ffw-popup-root[data-open] .ffw-modal{opacity:1;transform:translate(-50%,-50%)}
  #ffw-popup-root[data-open] .ffw-sheet{opacity:1;transform:translateY(0)}
  @media (prefers-reduced-motion:reduce){
    .ffw-scrim,.ffw-card{transition:opacity .15s linear}
    .ffw-modal,#ffw-popup-root[data-open] .ffw-modal{transform:translate(-50%,-50%)}
    .ffw-sheet,#ffw-popup-root[data-open] .ffw-sheet{transform:none}
  }
</style>
