---
import { LINKS, btnPlan, btnSky, btnSecondary } from "../lib/links";
import { withBase } from "../lib/base";

interface Props {
  primary?: "contact" | "ecommerce" | "demo";
  ecommerceHash?: string;
  showGsa?: boolean;
  showAccelerator?: boolean;
  class?: string;
}

const {
  primary = "contact",
  ecommerceHash,
  showGsa = true,
  showAccelerator = false,
  class: className,
} = Astro.props;

const ecommerceHref = `${withBase("ecommerce")}${ecommerceHash ? `#${ecommerceHash}` : ""}`;
const acceleratorHref = `${withBase("ecommerce")}#ffl-accelerator`;
---

<div
  class:list={[
    "flex w-full min-w-0 flex-col gap-2.5 sm:flex-row sm:flex-wrap",
    className,
  ]}
>
  {
    primary === "demo" ? (
      <a
        href={LINKS.demandIntel}
        target="_blank"
        rel="noopener noreferrer"
        class={btnPlan}
      >
        Demand Intelligence Home
      </a>
    ) : primary === "ecommerce" ? (
      <a href={ecommerceHref} class={btnPlan}>
        FFL Ecommerce Plans
      </a>
    ) : (
      <a href={withBase("contact")} class={btnPlan}>
        Talk to Coriolis
      </a>
    )
  }
  {
    showGsa && (
      <a
        href={LINKS.gsa}
        target="_blank"
        rel="noopener noreferrer"
        class={primary === "demo" ? btnSecondary : btnSky}
      >
        Put Betsy AI on my website
      </a>
    )
  }
  {
    primary === "demo" && (
      <a
        href={LINKS.betsyLive}
        target="_blank"
        rel="noopener noreferrer"
        class={btnSky}
      >
        Betsy Live
      </a>
    )
  }
  {
    primary !== "contact" && (
      <a href={withBase("contact")} class={btnSecondary}>
        Talk to Coriolis
      </a>
    )
  }
  {
    showAccelerator && (
      <a href={acceleratorHref} class={btnSecondary}>
        FFL Accelerator $569
      </a>
    )
  }
</div>
