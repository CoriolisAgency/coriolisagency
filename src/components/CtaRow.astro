---
import { LINKS, btnPlan, btnSky, btnSecondary } from "../lib/links";
import { withBase } from "../lib/base";

interface Props {
  primary?: "contact" | "ecommerce" | "demo" | "stack";
  ecommerceHash?: string;
  showGsa?: boolean;
  showAccelerator?: boolean;
  class?: string;
}

const {
  primary = "contact",
  ecommerceHash,
  showGsa = true,
  showAccelerator = false,
  class: className,
} = Astro.props;

const ecommerceHref = `${withBase("ecommerce")}${ecommerceHash ? `#${ecommerceHash}` : ""}`;
const acceleratorHref = `${withBase("ecommerce")}#ffl-accelerator`;
---

<div
  class:list={[
    "flex w-full min-w-0 flex-col gap-2.5 sm:flex-row sm:flex-wrap",
    className,
  ]}
>
  {
    primary === "stack" ? (
      <>
        <a href={withBase("ecommerce")} class={btnPlan}>
          FFL Ecommerce
        </a>
        <a
          href={LINKS.demandIntel}
          target="_blank"
          rel="noopener noreferrer"
          class={btnSky}
        >
          Demand Intelligence
        </a>
      </>
    ) : primary === "demo" ? (
      <a
        href={LINKS.demandIntel}
        target="_blank"
        rel="noopener noreferrer"
        class={btnPlan}
      >
        Demand Intelligence Home
      </a>
    ) : primary === "ecommerce" ? (
      <a href={ecommerceHref} class={btnPlan}>
        FFL Ecommerce Plans
      </a>
    ) : null
  }
  {
    showGsa && primary !== "stack" && (
      <a
        href={LINKS.gsa}
        target="_blank"
        rel="noopener noreferrer"
        class={primary === "demo" ? btnSecondary : primary === "contact" ? btnPlan : btnSky}
      >
        Claim GunSearchAgent.com Beta Account
      </a>
    )
  }
  {
    primary === "demo" && (
      <a
        href={LINKS.betsyLive}
        target="_blank"
        rel="noopener noreferrer"
        class={btnSky}
      >
        Betsy Live
      </a>
    )
  }

  {
    showAccelerator && (
      <a href={acceleratorHref} class={btnSecondary}>
        FFL Accelerator $569
      </a>
    )
  }
</div>
