---
import { btnPlan } from "../lib/links";
import { withBase } from "../lib/base";

interface Props {
  eyebrow: string;
  h1: string;
  lede: string;
  jumpLabel: string;
  jumpHref?: string;
  image: { src: string; alt: string; width: number; height: number };
}

const {
  eyebrow,
  h1,
  lede,
  jumpLabel,
  jumpHref = "#talk",
  image,
} = Astro.props;
---

<section class="relative overflow-hidden border-b border-zinc-800/80">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,160,23,0.10),transparent_50%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 py-14 sm:px-6 lg:py-20 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"
  >
    <div class="flex min-h-0 w-full min-w-0 flex-col">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        {eyebrow}
      </p>
      <h1
        class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-4xl leading-[1.2]"
      >
        {h1}
      </h1>
      <p class="mt-5 text-base leading-relaxed text-zinc-300 sm:text-lg">
        {lede}
      </p>
      <div class="mt-5 w-full min-w-0">
        <a href={jumpHref} class={btnPlan}>{jumpLabel}</a>
      </div>
    </div>
    <div
      class="relative order-first w-full min-w-0 overflow-hidden rounded-2xl ring-1 ring-white/10 xl:order-none"
    >
      <img
        src={withBase(image.src)}
        alt={image.alt}
        width={image.width}
        height={image.height}
        class="h-auto w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
