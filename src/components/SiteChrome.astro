---
import { MAIN_NAV } from "../lib/nav";
import { CANON_PATHS as CANON, SITE } from "../lib/site";
import { STACK_FOOTER } from "../lib/stack";
import { withBase } from "../lib/base";

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1)
    : rawPath
  ).replace(/\/$/, "") || "/";

const ecommercePaths = new Set([
  "/ecommerce",
  "/firearms-dropshipping",
  "/ffl-cockpit",
  "/ammoready-alternative",
  "/gearfire-alternative",
  "/best-ffl-ecommerce-website",
  "/email-marketing-for-ffl-ecommerce",
  "/woocommerce-vs-shopify-for-gun-stores",
  "/leave-ammoready",
  "/leave-gearfire",
  "/ffl-website-cost",
]);

// Gun Store POS pillar and its four POS pages.
const posPaths = new Set([
  "/gun-store-pos",
  "/aim-pos",
  "/gunbiz-pos",
  "/trident-1-pos",
  "/rapid-gun-systems-pos",
]);

function active(slug: string) {
  const p = `/${slug}`;
  if (slug === "ecommerce") return ecommercePaths.has(path);
  if (slug === "gun-store-pos") return posPaths.has(path);
  return path === p || path.startsWith(p + "/");
}

const family = [
  { href: "https://www.gunsearchengine.com/", label: "GunSearchEngine.com" },
  { href: "https://www.gunstoregame.com/", label: "GunStoreGame.com" },
  { href: "https://fflintel.com/", label: "FFLIntel" },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-zinc-800/80 bg-[color-mix(in_srgb,#0a1220_94%,transparent)] backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6"
  >
    <a href={withBase("/")} class="shrink-0">
      <img
        src={withBase(CANON.logo)}
        alt={SITE.legalName}
        width="215"
        height="28"
        class="box-content h-3.5 w-auto py-[11px] sm:h-4 sm:py-3"
      />
    </a>
    <nav
      class="hidden flex-wrap items-center justify-end gap-1 md:flex sm:gap-1.5"
      aria-label="Main"
    >
      {
        MAIN_NAV.map((item) => {
          const external = "external" in item && item.external;
          const children = "children" in item ? item.children : undefined;
          const pillActive = !external && active(item.href);
          const pillClass = [
            "rounded-sm border px-2.5 py-1.5 text-xs font-medium transition-colors sm:text-sm",
            pillActive
              ? "border-gold/50 bg-gold/10 text-gold"
              : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
          ];
          if (children) {
            return (
              <div class="pos-nav relative" data-pos-nav>
                <div
                  class:list={[
                    "flex items-stretch overflow-hidden rounded-sm border",
                    pillActive
                      ? "border-gold/50 bg-gold/10 text-gold"
                      : "border-zinc-700 text-zinc-200",
                  ]}
                >
                  <a
                    href={withBase(item.href)}
                    class="px-2.5 py-1.5 text-xs font-medium sm:text-sm"
                  >
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class:list={[
                      "pos-nav-toggle inline-flex items-center border-l px-1.5",
                      pillActive ? "border-gold/40" : "border-zinc-700",
                    ]}
                    aria-expanded="false"
                    aria-controls="pos-menu"
                    aria-label="Gun Store POS pages"
                  >
                    <svg
                      viewBox="0 0 20 20"
                      class="h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="M5 7.5l5 5 5-5"></path>
                    </svg>
                  </button>
                </div>
                <ul
                  id="pos-menu"
                  class="pos-menu absolute right-0 top-full z-50 mt-1 min-w-56 border border-zinc-700 bg-zinc-950 py-1"
                >
                  {
                    children.map((child) => (
                      <li>
                        <a
                          href={withBase(child.href)}
                          class:list={[
                            "block px-3 py-2 text-sm hover:bg-zinc-800",
                            path === `/${child.href}`
                              ? "text-gold"
                              : "text-zinc-200",
                          ]}
                          aria-current={
                            path === `/${child.href}` ? "page" : undefined
                          }
                        >
                          {child.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            );
          }
          return (
            <a
              href={external ? item.href : withBase(item.href)}
              class:list={pillClass}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href={withBase("contact")}
        class="rounded-sm border border-[#8a6a0a] bg-[#c8960c] px-2.5 py-1.5 text-xs font-semibold !text-[#05080f] hover:bg-[#e0a910] sm:text-sm"
      >
        Talk to Coriolis
      </a>
    </nav>
    <button
      type="button"
      id="nav-toggle"
      class="inline-flex items-center justify-center rounded-sm border border-zinc-700 p-2 text-zinc-200 hover:bg-zinc-800 md:hidden"
      aria-controls="nav-drawer"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<div id="nav-drawer" class="fixed inset-0 z-50 md:hidden" hidden>
  <div id="nav-overlay" class="absolute inset-0 bg-black/60"></div>
  <div
    id="nav-panel"
    class="absolute inset-y-0 right-0 flex w-72 max-w-[85%] flex-col gap-2 border-l border-zinc-800 bg-ink p-4 shadow-xl"
    role="dialog"
    aria-modal="true"
    aria-label="Main"
    tabindex="-1"
  >
    <button
      type="button"
      id="nav-close"
      class="mb-2 self-end rounded-sm border border-zinc-700 p-2 text-zinc-200 hover:bg-zinc-800"
      aria-label="Close menu"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    <nav aria-label="Mobile" class="contents">
    {
      MAIN_NAV.map((item) => {
        const external = "external" in item && item.external;
        const children = "children" in item ? item.children : undefined;
        return (
          <>
            <a
              href={external ? item.href : withBase(item.href)}
              class:list={[
                "rounded-sm border px-3 py-2 text-sm font-medium transition-colors",
                !external && active(item.href)
                  ? "border-gold/50 bg-gold/10 text-gold"
                  : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
              ]}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
            >
              {item.label}
            </a>
            {
              children && (
                <ul class="ml-4 flex flex-col gap-1">
                  {children.map((child) => (
                    <li>
                      <a
                        href={withBase(child.href)}
                        class:list={[
                          "flex min-h-11 items-center rounded-sm border px-3 py-2 text-sm font-medium transition-colors",
                          path === `/${child.href}`
                            ? "border-gold/50 bg-gold/10 text-gold"
                            : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
                        ]}
                        aria-current={
                          path === `/${child.href}` ? "page" : undefined
                        }
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </>
        );
      })
    }
    <a
      href={withBase("contact")}
      class="rounded-sm border border-[#8a6a0a] bg-[#c8960c] px-3 py-2 text-sm font-semibold !text-[#05080f] hover:bg-[#e0a910]"
    >
      Talk to Coriolis
    </a>
    </nav>
  </div>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("nav-drawer");
  const panel = document.getElementById("nav-panel");
  const overlay = document.getElementById("nav-overlay");
  const close = document.getElementById("nav-close");

  if (toggle && drawer && panel && overlay && close) {
    const open = () => {
      drawer.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      panel.focus();
    };

    const shut = ({ restoreFocus = true } = {}) => {
      drawer.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener("click", () =>
      drawer.hidden ? open() : shut(),
    );
    close.addEventListener("click", () => shut());
    overlay.addEventListener("click", () => shut());

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !drawer.hidden) shut();
    });

    // Desktop restores the inline pill row, so drop the drawer and its scroll lock.
    const desktop = window.matchMedia("(min-width: 48rem)");
    desktop.addEventListener("change", (event) => {
      if (event.matches && !drawer.hidden) shut({ restoreFocus: false });
    });
  }

  const posNav = document.querySelector("[data-pos-nav]");
  const posToggle = posNav?.querySelector(".pos-nav-toggle");
  if (posNav instanceof HTMLElement && posToggle instanceof HTMLButtonElement) {
    const setOpen = (open) => {
      posNav.classList.toggle("is-open", open);
      posToggle.setAttribute("aria-expanded", open ? "true" : "false");
    };
    posToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(posToggle.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (posToggle.getAttribute("aria-expanded") !== "true") return;
      setOpen(false);
      posToggle.focus();
    });
    document.addEventListener("click", (event) => {
      if (!posNav.contains(event.target)) setOpen(false);
    });
  }
</script>

<style>
  .pos-menu {
    display: none;
  }
  .pos-nav:hover .pos-menu,
  .pos-nav:focus-within .pos-menu,
  .pos-nav.is-open .pos-menu {
    display: block;
  }
</style>

<main class="flex min-w-0 flex-1 flex-col">
  <slot />
</main>

<footer class="border-t border-zinc-800/80 bg-[#070b12]">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:px-6 lg:flex-row lg:items-start lg:justify-between"
  >
    <div class="space-y-3 max-w-md">
      <img
        src={withBase(CANON.logo)}
        alt={SITE.legalName}
        width="215"
        height="28"
        class="box-content h-3.25 w-auto py-2.5"
      />
      <p class="text-sm text-zinc-400">
        <a href={withBase("ecommerce")} class="hover:text-sky-300">FFL Ecommerce</a>
        {" · "}
        <a href={withBase("gun-store-pos")} class="hover:text-sky-300">Gun Store POS</a>
        {" · "}
        <a href={withBase("ffl-analytics")} class="hover:text-sky-300">FFL Analytics</a>
      </p>
      <p class="text-xs leading-relaxed text-zinc-500">
        {SITE.legalName} · {SITE.origin}.
      </p>
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-zinc-500">
        <a href={withBase("case-studies")} class="hover:text-sky-300">Case studies</a>
        <a href={withBase("press")} class="hover:text-sky-300">Press</a>
        <a href={withBase("stack")} class="hover:text-sky-300">Stack</a>
        <a href={withBase("privacy")} class="hover:text-sky-300">Privacy</a>
        <a href={withBase("msa")} class="hover:text-sky-300"
          >Master Services Agreement</a
        >
      </div>
    </div>
    <nav
      class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-zinc-400"
      aria-label="Family"
    >
      {
        family.map((item) => (
          <a
            href={item.href}
            class="hover:text-sky-300"
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <p class="px-4 pb-6 text-center text-[11px] text-zinc-600">
    {
      path === "/stack" ? (
        <>
          © {new Date().getFullYear()} {SITE.legalName}. {STACK_FOOTER}
        </>
      ) : (
        <>
          © {new Date().getFullYear()} {SITE.legalName}. Not affiliated with
          Gearfire or RetailBI.
        </>
      )
    }
  </p>
</footer>
