---
import { LINKS } from "../lib/links";
import { CANON_PATHS as CANON, SITE } from "../lib/site";
import { STACK_FOOTER } from "../lib/stack";
import { withBase } from "../lib/base";

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1)
    : rawPath
  ).replace(/\/$/, "") || "/";

const nav = [
  { href: "ecommerce", label: "FFL Ecommerce" },
  { href: LINKS.fflintel, label: "FFL Intel", external: true },
  { href: "ai-studio", label: "AI Studio" },
  { href: "demand-intelligence", label: "Demand Intelligence" },
  { href: "about", label: "About" },
] as const;

const ecommercePaths = new Set([
  "/ecommerce",
  "/firearms-dropshipping",
  "/ffl-cockpit",
  "/ammoready-alternative",
  "/best-ffl-ecommerce-website",
]);

function active(slug: string) {
  const p = `/${slug}`;
  if (slug === "ecommerce") return ecommercePaths.has(path);
  return path === p || path.startsWith(p + "/");
}

const family = [
  { href: LINKS.gsa, label: "GunSearchAgent" },
  { href: LINKS.gse, label: "GunSearchEngine" },
  { href: LINKS.betsy, label: "2aBetsy" },
  { href: LINKS.betsyLive, label: "Betsy Live" },
  { href: LINKS.fflaccelerator, label: "FFL Accelerator" },
  { href: LINKS.fflintel, label: "FFLIntel" },
  { href: LINKS.gunStoreGame, label: "Gun Store Game" },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-zinc-800/80 bg-[color-mix(in_srgb,#0a1220_94%,transparent)] backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6"
  >
    <a href={withBase("/")} class="shrink-0">
      <img
        src={withBase(CANON.logo)}
        alt={SITE.legalName}
        width="500"
        height="150"
        class="h-9 w-auto sm:h-10"
      />
    </a>
    <nav
      class="hidden flex-wrap items-center justify-end gap-1 md:flex sm:gap-1.5"
      aria-label="Main"
    >
      {
        nav.map((item) => (
          <a
            href={"external" in item ? item.href : withBase(item.href)}
            class:list={[
              "rounded-sm border px-2.5 py-1.5 text-xs font-medium transition-colors sm:text-sm",
              !("external" in item) && active(item.href)
                ? "border-gold/50 bg-gold/10 text-gold"
                : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
            ]}
            target={"external" in item ? "_blank" : undefined}
            rel={"external" in item ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={withBase("contact")}
        class="rounded-sm border border-gold/70 bg-gold px-2.5 py-1.5 text-xs font-semibold text-ink hover:bg-amber-300 sm:text-sm"
      >
        Talk to Coriolis
      </a>
    </nav>
    <button
      type="button"
      id="nav-toggle"
      class="inline-flex items-center justify-center rounded-sm border border-zinc-700 p-2 text-zinc-200 hover:bg-zinc-800 md:hidden"
      aria-controls="nav-drawer"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<div id="nav-drawer" class="fixed inset-0 z-50 md:hidden" hidden>
  <div id="nav-overlay" class="absolute inset-0 bg-black/60"></div>
  <div
    id="nav-panel"
    class="absolute inset-y-0 right-0 flex w-72 max-w-[85%] flex-col gap-2 border-l border-zinc-800 bg-ink p-4 shadow-xl"
    role="dialog"
    aria-modal="true"
    aria-label="Main"
    tabindex="-1"
  >
    <button
      type="button"
      id="nav-close"
      class="mb-2 self-end rounded-sm border border-zinc-700 p-2 text-zinc-200 hover:bg-zinc-800"
      aria-label="Close menu"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    {
      nav.map((item) => (
        <a
          href={"external" in item ? item.href : withBase(item.href)}
          class:list={[
            "rounded-sm border px-3 py-2 text-sm font-medium transition-colors",
            !("external" in item) && active(item.href)
              ? "border-gold/50 bg-gold/10 text-gold"
              : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
          ]}
          target={"external" in item ? "_blank" : undefined}
          rel={"external" in item ? "noopener noreferrer" : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={withBase("contact")}
      class="rounded-sm border border-gold/70 bg-gold px-3 py-2 text-sm font-semibold text-ink hover:bg-amber-300"
    >
      Talk to Coriolis
    </a>
  </div>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const drawer = document.getElementById("nav-drawer");
  const panel = document.getElementById("nav-panel");
  const overlay = document.getElementById("nav-overlay");
  const close = document.getElementById("nav-close");

  if (toggle && drawer && panel && overlay && close) {
    const open = () => {
      drawer.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      panel.focus();
    };

    const shut = ({ restoreFocus = true } = {}) => {
      drawer.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener("click", () =>
      drawer.hidden ? open() : shut(),
    );
    close.addEventListener("click", () => shut());
    overlay.addEventListener("click", () => shut());

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !drawer.hidden) shut();
    });

    // Desktop restores the inline pill row, so drop the drawer and its scroll lock.
    const desktop = window.matchMedia("(min-width: 48rem)");
    desktop.addEventListener("change", (event) => {
      if (event.matches && !drawer.hidden) shut({ restoreFocus: false });
    });
  }
</script>

<main class="flex min-w-0 flex-1 flex-col">
  <slot />
</main>

<footer class="border-t border-zinc-800/80 bg-[#070b12]">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:px-6 lg:flex-row lg:items-start lg:justify-between"
  >
    <div class="space-y-3 max-w-md">
      <img
        src={withBase(CANON.logo)}
        alt={SITE.legalName}
        width="500"
        height="150"
        class="h-8 w-auto"
      />
      <p class="text-sm text-zinc-400">{SITE.role}</p>
      <p class="text-xs leading-relaxed text-zinc-500">
        {SITE.legalName} · {SITE.origin}.
      </p>
      <div class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-zinc-500">
        <a href={withBase("stack")} class="hover:text-sky-300">Stack</a>
        <a href={withBase("privacy")} class="hover:text-sky-300">Privacy</a>
        <a href={withBase("msa")} class="hover:text-sky-300"
          >Master Services Agreement</a
        >
      </div>
    </div>
    <nav
      class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-zinc-400"
      aria-label="Family"
    >
      {
        family.map((item) => (
          <a
            href={item.href}
            class="hover:text-sky-300"
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <p class="px-4 pb-6 text-center text-[11px] text-zinc-600">
    {
      path === "/stack" ? (
        <>
          © {new Date().getFullYear()} {SITE.legalName}. {STACK_FOOTER}
        </>
      ) : (
        <>
          © {new Date().getFullYear()} {SITE.legalName}. Not affiliated with
          Gearfire or RetailBI.
        </>
      )
    }
  </p>
</footer>
