---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "@coriolis/lead-form/LeadForm.astro";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="Contact Coriolis, LLC"
  description="Tell Coriolis about the store, the product, or the demand problem. Greenville, SC."
  path="/contact"
  ogImagePath={CANON_PATHS.contactHero}
  emailCapture={false}
>
  <section class="flex grow shrink-0 items-center py-12 sm:py-16">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Contact
        </p>
        <h1
          class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Tell us what you need
        </h1>
        <img
          src={withBase(CANON_PATHS.contactHero)}
          alt="Agency Overwatch — website uptime monitoring and QRF"
          width="1600"
          height="900"
          class="mt-6 w-full min-w-0 rounded-2xl object-cover ring-1 ring-white/10"
        />
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-zinc-400">
          Tell us about the website you want and we'll make it happen. We
          build, host, and support your open source WooCommerce website. There
          is no contract and you can cancel at any time.
        </p>
      </div>

      <LeadForm site="coriolisagency" />
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Theme the shared form to the live /contact Tailwind tokens. */
  form.lf-form[data-lf-form] {
    --lf-fg: #a1a1aa;
    --lf-muted: #52525b;
    --lf-border: #3f3f46;
    --lf-card-border: #27272a;
    --lf-surface: rgba(9, 9, 11, 0.5);
    --lf-field: var(--color-ink);
    --lf-input: #f4f4f5;
    --lf-accent: var(--color-gold);
    --lf-accent-ink: var(--color-ink);
    --lf-success: #7dd3fc;
    --lf-error: #fcd34d;
  }
  form.lf-form[data-lf-form] .lf-submit:hover:not(:disabled) {
    background: #fcd34d;
    filter: none;
  }
</style>
