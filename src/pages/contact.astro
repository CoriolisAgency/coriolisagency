---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CANON_PATHS } from "../lib/site";
import contactHero from "../assets/contact-hero.jpg";
---

<BaseLayout
  title="Contact Coriolis, LLC"
  description="Tell Coriolis about the store, the product, or the demand problem. Greenville, SC."
  path="/contact"
  ogImagePath={CANON_PATHS.contactHero}
>
  <section class="py-12 sm:py-16">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_1fr]">
      <div>
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Contact
        </p>
        <h1
          class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Tell Us About Your Company
        </h1>
        <Image
          src={contactHero}
          alt="Coriolis — talk to us about your FFL, brand, or demand problem"
          widths={[640, 800, 1200]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="mt-6 w-full rounded-2xl object-cover ring-1 ring-white/10"
        />
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-zinc-400">
          Ecommerce, AI Factory, or Demand Intelligence — the need, the
          opportunity, or the hot mess. We will get back to you.
        </p>
      </div>

      <form
        id="contact-form"
        class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6 space-y-4"
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-xs font-medium text-zinc-400">
            Name
            <input
              name="name"
              required
              class="mt-1 w-full rounded-sm border border-zinc-700 bg-ink px-3 py-2 text-sm text-zinc-100"
            />
          </label>
          <label class="block text-xs font-medium text-zinc-400">
            Company
            <input
              name="company"
              required
              class="mt-1 w-full rounded-sm border border-zinc-700 bg-ink px-3 py-2 text-sm text-zinc-100"
            />
          </label>
          <label class="block text-xs font-medium text-zinc-400">
            Email
            <input
              name="email"
              type="email"
              required
              class="mt-1 w-full rounded-sm border border-zinc-700 bg-ink px-3 py-2 text-sm text-zinc-100"
            />
          </label>
          <label class="block text-xs font-medium text-zinc-400">
            Phone
            <input
              name="phone"
              type="tel"
              class="mt-1 w-full rounded-sm border border-zinc-700 bg-ink px-3 py-2 text-sm text-zinc-100"
            />
          </label>
        </div>
        <label class="block text-xs font-medium text-zinc-400">
          Website
          <input
            name="website"
            type="url"
            placeholder="https://"
            class="mt-1 w-full rounded-sm border border-zinc-700 bg-ink px-3 py-2 text-sm text-zinc-100"
          />
        </label>
        <label class="block text-xs font-medium text-zinc-400">
          What this is about
          <select
            name="pillar"
            required
            class="mt-1 w-full rounded-sm border border-zinc-700 bg-ink px-3 py-2 text-sm text-zinc-100"
          >
            <option value="Ecommerce">Ecommerce</option>
            <option value="AI Factory">AI Factory</option>
            <option value="Demand Intelligence">Demand Intelligence</option>
          </select>
        </label>
        <label class="block text-xs font-medium text-zinc-400">
          Message
          <textarea
            name="message"
            required
            rows="5"
            class="mt-1 w-full rounded-sm border border-zinc-700 bg-ink px-3 py-2 text-sm text-zinc-100"
          ></textarea>
        </label>
        <button
          type="submit"
          class="inline-flex w-full sm:w-auto items-center justify-center rounded-sm border border-gold/70 bg-gold px-5 py-3 text-sm font-semibold text-ink transition hover:bg-amber-300"
        >
          Open email to send
        </button>
        <p class="text-xs text-zinc-600">
          Opens your email app. Nothing is stored on this form.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(event.target instanceof HTMLFormElement)) return;
    const data = new FormData(event.target);
    const pillar = String(data.get("pillar") || "Coriolis");
    const company = String(data.get("company") || "");
    const subject = `Coriolis — ${pillar}${company ? ` — ${company}` : ""}`;
    const lines = [
      `Name: ${data.get("name") || ""}`,
      `Company: ${company}`,
      `Email: ${data.get("email") || ""}`,
      `Phone: ${data.get("phone") || ""}`,
      `Website: ${data.get("website") || ""}`,
      `About: ${pillar}`,
      "",
      String(data.get("message") || ""),
    ];
    const href = `mailto:paul@coriolisagency.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
    window.location.href = href;
  });
</script>
