---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "@coriolis/lead-form/LeadForm.astro";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
import { md } from "../lib/md";
// CA-VOICE-P1 batch 3 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-3/contact.md, shipped as drafted.
---

<BaseLayout
  title="Contact Coriolis, LLC"
  description="Tell Coriolis about the store, the product, or the demand problem. Greenville, SC."
  path="/contact"
  ogImagePath={CANON_PATHS.contactHero}
  emailCapture={false}
>
  <section class="flex grow shrink-0 items-center py-12 sm:py-16">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Contact
        </p>
        <h1
          class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Tell us what you need
        </h1>
        <img
          src={withBase(CANON_PATHS.contactHero)}
          alt="Agency Overwatch: website uptime monitoring and QRF"
          width="1600"
          height="900"
          class="mt-6 w-full min-w-0 rounded-2xl object-cover ring-1 ring-white/10"
        />
        <h2 class="mt-6 text-xl font-semibold tracking-tight text-white">{"Tell us about the website you want and we'll make it happen."}</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-400" set:html={md("We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time.")} />
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-400" set:html={md("Write to us about the store you want, a product you want built, or demand work you want to see. The people at Coriolis are Paul and Joel, in Greenville, SC, and mail goes to [support@coriolisagency.com](mailto:support@coriolisagency.com). We will get back to you.")} />
      </div>

      <LeadForm site="coriolisagency" />
    </div>
  </section>
</BaseLayout>

