---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
import { LINKS, linkClass } from "../lib/links";
---

<BaseLayout
  title="Page not found — Coriolis, LLC"
  description="That address is not on this site."
  path="/404"
  noindex
>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-400">
      404
    </p>
    <h1 class="mt-3 text-3xl font-semibold text-white">Page not found</h1>
    <p class="mt-4 max-w-xl text-sm text-zinc-400">
      That address is not on this site. Try one of these, or send a note.
    </p>
    <ul class="mt-6 space-y-2 text-sm">
      <li><a href={withBase("/")} class={linkClass}>Home</a></li>
      <li><a href={withBase("ecommerce")} class={linkClass}>Ecommerce</a></li>
      <li><a href={withBase("ai-studio")} class={linkClass}>AI Studio</a></li>
      <li>
        <a
          href={LINKS.demandIntel}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">Demand Intelligence</a
        >
      </li>
      <li><a href={withBase("contact")} class={linkClass}>Contact</a></li>
    </ul>
  </section>
</BaseLayout>
