---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
import { linkClass } from "../lib/links";
---

<BaseLayout
  title="Not found — Coriolis, LLC"
  description="That URL is not on the rebuilt Coriolis company site."
  path="/404"
>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-400">
      404
    </p>
    <h1 class="mt-3 text-3xl font-semibold text-white">Page not on this host</h1>
    <p class="mt-4 max-w-xl text-sm text-zinc-400">
      The WordPress archive is being replaced. Try a pillar, or the contact
      page if you followed an old permalink.
    </p>
    <ul class="mt-6 space-y-2 text-sm">
      <li><a href={withBase("/")} class={linkClass}>Home</a></li>
      <li><a href={withBase("ecommerce")} class={linkClass}>Ecommerce</a></li>
      <li><a href={withBase("ai-factory")} class={linkClass}>AI Factory</a></li>
      <li>
        <a href={withBase("demand-intelligence")} class={linkClass}
          >Demand Intelligence</a
        >
      </li>
      <li><a href={withBase("contact")} class={linkClass}>Contact</a></li>
    </ul>
  </section>
</BaseLayout>
