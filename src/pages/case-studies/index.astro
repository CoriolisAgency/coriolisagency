---
/**
 * SEO-U8v2: /case-studies hub. Copy is Brandy's FINAL (Chief 9:23 AM ET).
 * Live stories only (Naples Gun Shop, Allegheny Arms, Target Shotguns). The two
 * draft stories are never carded, listed in the ItemList or linked from here.
 * No proof line (no-stats rule, Chief 9:23).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaRow from "../../components/CtaRow.astro";
import TalkSection from "../../components/TalkSection.astro";
import { CASE_STUDIES_HUB, LIVE_CASE_STUDIES, casePath } from "../../lib/case-studies";
import { LINKS } from "../../lib/links";
import { SITE_ORIGIN } from "../../lib/site";
import { withBase } from "../../lib/base";

const siteOrigin = Astro.site ?? new URL(SITE_ORIGIN);
const abs = (p: string) => new URL(withBase(p), siteOrigin).href;
const hubUrl = abs(CASE_STUDIES_HUB.path);
---

<BaseLayout
  title={CASE_STUDIES_HUB.title}
  description={CASE_STUDIES_HUB.meta}
  path={CASE_STUDIES_HUB.path}
  ogImagePath={LIVE_CASE_STUDIES[0].og}
  extraJsonLd={[
    {
      "@type": "CollectionPage",
      "@id": `${hubUrl}#collection`,
      url: hubUrl,
      name: CASE_STUDIES_HUB.h1,
      description: CASE_STUDIES_HUB.meta,
      isPartOf: { "@id": `${LINKS.home}/#website` },
      publisher: { "@id": `${LINKS.home}/#organization` },
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: LIVE_CASE_STUDIES.length,
        itemListElement: LIVE_CASE_STUDIES.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          url: abs(casePath(c.slug)),
          name: c.name,
        })),
      },
    },
  ]}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">{CASE_STUDIES_HUB.eyebrow}</p>
      <h1 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]">
        {CASE_STUDIES_HUB.h1}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">{CASE_STUDIES_HUB.intro}</p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <ul class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          LIVE_CASE_STUDIES.map((c) => (
            <li class="group relative flex flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950/50 transition hover:border-gold/40">
              <img
                src={withBase(c.hero)}
                alt={c.alt}
                width="1920"
                height="1080"
                loading="lazy"
                decoding="async"
                class="aspect-video w-full bg-[#091220] object-cover"
              />
              <div class="flex flex-1 flex-col p-6">
                <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold">{c.kicker}</p>
                <h2 class="mt-2 text-lg font-semibold tracking-tight text-white">{c.name}</h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-400">{c.cardLine}</p>
                <a
                  href={withBase(casePath(c.slug))}
                  class="mt-4 text-sm font-medium !text-sky-400 underline-offset-2 hover:underline after:absolute after:inset-0"
                >
                  {c.cardLink}
                </a>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="mt-10">
        <CtaRow primary="ecommerce" />
      </div>
    </div>
  </section>

  <TalkSection heading="Tell us about your store" />
</BaseLayout>
