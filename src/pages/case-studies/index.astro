---
/**
 * SEO-U8: /case-studies hub (Brandy's FINAL section 1). CollectionPage schema.
 * No Review or AggregateRating markup. Stories come from src/lib/case-studies.ts.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaRow from "../../components/CtaRow.astro";
import TalkSection from "../../components/TalkSection.astro";
import { CASE_STUDIES, CASE_STUDIES_HUB } from "../../lib/case-studies";
import { LINKS, linkClass } from "../../lib/links";
import { CANON_PATHS, SITE_ORIGIN } from "../../lib/site";
import { withBase } from "../../lib/base";
import { GOOGLE_REVIEWS_HREF, GOOGLE_REVIEW_COUNT } from "../../lib/google-reviews";

const ext = { target: "_blank", rel: "noopener noreferrer" };
const siteOrigin = Astro.site ?? new URL(SITE_ORIGIN);
const hubUrl = new URL(withBase(CASE_STUDIES_HUB.path), siteOrigin).href;
const storyUrl = (slug: string) => new URL(withBase(`case-studies/${slug}`), siteOrigin).href;
---

<BaseLayout
  title={CASE_STUDIES_HUB.title}
  description={CASE_STUDIES_HUB.description}
  path={CASE_STUDIES_HUB.path}
  ogImagePath={CANON_PATHS.storefront}
  extraJsonLd={[
    {
      "@type": "CollectionPage",
      "@id": `${hubUrl}#collection`,
      url: hubUrl,
      name: CASE_STUDIES_HUB.h1,
      description: CASE_STUDIES_HUB.description,
      isPartOf: { "@id": `${LINKS.home}/#website` },
      publisher: { "@id": `${LINKS.home}/#organization` },
      hasPart: CASE_STUDIES.map((c) => ({
        "@type": "Article",
        "@id": `${storyUrl(c.slug)}#article`,
        headline: c.h1,
        url: storyUrl(c.slug),
      })),
    },
  ]}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">{CASE_STUDIES_HUB.eyebrow}</p>
      <h1 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]">
        {CASE_STUDIES_HUB.h1}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
        {CASE_STUDIES_HUB.intro}
      </p>
      <p class="mt-5 text-sm text-zinc-400">
        100+ clients. <a href={GOOGLE_REVIEWS_HREF} class={linkClass} {...ext}>5-star Google rating from {GOOGLE_REVIEW_COUNT} reviews</a>. Member of NSSF, FPC and GOA.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          CASE_STUDIES.map((c) => (
            <article class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6 ring-1 ring-gold/15">
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold">{c.card.kicker}</p>
              <h2 class="mt-2 text-lg font-semibold tracking-tight text-white">{c.shop}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-300">{c.card.line}</p>
              <p class="mt-4 text-sm">
                <a href={withBase(`case-studies/${c.slug}`)} class={linkClass}>Read the {c.shop} story &rarr;</a>
              </p>
            </article>
          ))
        }
      </div>
      <div class="mt-10">
        <CtaRow primary="ecommerce" />
      </div>
    </div>
  </section>

  <TalkSection heading="Tell us about your store" />
</BaseLayout>
