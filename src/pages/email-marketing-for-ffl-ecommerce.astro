---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import TalkSection from "../components/TalkSection.astro";
import { FAQ_EMAIL } from "../lib/faq";
import { linkClass } from "../lib/links";
import { md } from "../lib/md";
import { CANON_PATHS } from "../lib/site";
import { TRUSTINDEX_REVIEWS_HREF } from "../lib/google-reviews";

// CA-VOICE-P1 batch 4 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-4/email-marketing-for-ffl-ecommerce.md, shipped as drafted.
const card = (s: string) => {
  const m = s.match(/^\*\*(.+?)\*\*\s+([\s\S]*)$/);
  if (!m) throw new Error("card: " + s);
  return { title: m[1].replace(/\.$/, ""), body: m[2] };
};
const flows = (["**Welcome.** Someone signs up on your site. They get a hello, your store's story, and what you carry. This is the email most people open, so it's where you tell them what makes your shop different.","**Abandoned cart.** A buyer adds a gun or a box of ammo and doesn't check out. The flow reminds them what's in the cart and links them straight back to it, and for serialized guns, it's a good place to remind them how the transfer works.","**Back in stock.** A buyer wants something you're out of, so they sign up for an alert on the product page, and when it comes back, they get the email. For hard-to-find guns and ammo, this is the flow that sells.","**Browse abandonment.** A shopper looks at a product and leaves without adding it to the cart, and the flow follows up with that product.","**Post-purchase.** The order ships. The buyer gets a thank you, what happens next, and a reason to come back, and for a firearm, that includes the transfer step at their dealer."] as string[]).map(card);
const plans = ["FFL Accelerator, at $569 a month, is the plan where we run your email for you: capture, list management, and the welcome, back in stock, browse abandonment, thank you for purchase and abandoned cart flows. We also watch the numbers across Google Analytics, Google Search Console, [GunSearchEngine.com](https://www.gunsearchengine.com/?utm_source=coriolisagency&utm_medium=referral&utm_campaign=email-marketing-for-ffl-ecommerce&utm_content=gse-analytics), and email and SMS.", "Retail Setup, at $2,500 one time, is the full email build at launch: complete email marketing setup, email and CRM platform integration, a custom email brand kit and template, the welcome series, the abandoned cart series, back-in-stock notifications, and deliverability work.", "Basic Setup, at $500 one time, includes email capture on your site, and you run the rest.", "All plans: Minute Man $169, Militia $269, Gun Runner $369, Warlord $469 and FFL Accelerator $569 a month. Managed email is on FFL Accelerator. See every plan on [FFL ecommerce](/ecommerce)."] as const;
const policyTable = [["Platform","What its policy says about firearms","Source (read November 10, 2026)"],["Mailchimp","Not listed*","[mailchimp.com/legal/acceptable_use](https://mailchimp.com/legal/acceptable_use/) (policy updated September 26, 2025)"],["Klaviyo","Its Acceptable Use Policy bars SMS and MMS content about firearms on US and Canadian short code and toll-free numbers.","[klaviyo.com/legal/acceptable-use-policy](https://www.klaviyo.com/legal/acceptable-use-policy) (policy updated April 9, 2026)"]];

const p = "mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400";
const th = "py-3 pr-3 font-medium";
const td = "py-3 pr-3 align-top";
---

<BaseLayout
  title="Email Marketing for Gun Stores and FFLs | Coriolis"
  description="Gun store email marketing on the WooCommerce store you own: welcome, abandoned cart, back in stock and post-purchase flows, set up by Coriolis."
  path="/email-marketing-for-ffl-ecommerce"
  ogImagePath={CANON_PATHS.storefront}
  faq={FAQ_EMAIL}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        Ecommerce · Email
      </p>
      <h1
        class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        Email marketing for gun stores
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md("Email marketing for gun stores brings buyers back to your website after they leave. Someone looks at a rifle, adds a box of ammo, and closes the tab, and a good email gets them back. Coriolis sets up the capture, the list and the automated flows on the WooCommerce store you own, and on FFL Accelerator, we run them for you.")} />
      <p class="mt-4 text-sm text-zinc-400" set:html={md("Coriolis has 100+ clients and a [5-star Google rating](https://www.trustindex.io/reviews/coriolisagency.com), and is a member of NSSF, FPC and GOA.")} />
      <div class="mt-8">
        <CtaRow primary="ecommerce" showGsa={false} showAccelerator showContact />
      </div>
      <EcommerceCluster current="email-marketing-for-ffl-ecommerce" dropshipLabel="listing distributor catalogs on a store you own" />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"The flows a gun store can run once the list and the capture are in place"}</h2>
      <p class={p} set:html={md("These go out on their own once they're set up. You write the offer, and the store sends the email.")} />
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          flows.map((f) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <h3 class="text-sm font-semibold text-sky-300">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400" set:html={md(f.body)} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"What's on which plan, from Basic Setup to FFL Accelerator"}</h2>
      {plans.map((para) => <p class={p} set:html={md(para)} />)}
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Which email platforms take firearms businesses, based on policies read November 10, 2026"}</h2>
      <p class={p} set:html={md("Ask before you import a list. Some email and SMS tools limit firearms content, and a store that gets shut off loses its list and its flows in one day.")} />
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              {policyTable[0].map((h) => <th class="py-3 pr-3 font-medium">{h}</th>)}
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {policyTable.slice(1).map((r) => (
              <tr class="border-b border-zinc-800/80">
                {r.map((c, i) => i === 0 ? <th class="py-3 pr-3 align-top font-medium text-zinc-300" set:html={md(c)} /> : <td class="py-3 pr-3 align-top" set:html={md(c)} />)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 max-w-3xl text-xs leading-relaxed text-zinc-500">{"*Not listed on the source page we read November 10, 2026."}</p>
      <p class={p} set:html={md("Read the policy for what you sell, firearms, ammo or both, then get your account approved in writing before launch. That's the same rule as [FFL payment processing](/ffl-payment-processing).")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"A store that runs it: Jim's Armory, and what stays yours if you cancel"}</h2>
      <p class={p} set:html={md("Jim's Armory is the online store behind Jim Grill's [Jim's Armory YouTube channel](https://www.youtube.com/@JimsArmory). Coriolis built it on WooCommerce. The catalog runs past 41,000 products, and it sends back-in-stock alerts and gun store email marketing through Mailchimp. See the [store](https://jimsarmory.com/) and the [release](/press/four-firearms-businesses-choose-coriolis-for-custom-woocommerce-stores).")} />
      <p class={p} set:html={md("The site is yours. Cancel and the website goes with you. Email platform accounts you own stay yours, and so does the list in them.")} />
      <p class={p} set:html={md("Email works best with something to say. Back-in-stock alerts need stock to come back, so a store with [dropshipping across 21 distributor catalogs](/firearms-dropshipping) has more to announce. Abandoned cart emails need a cart that works, so the store runs on [FFL website design](/ecommerce) built for dealer transfer, and the list grows with traffic from [GunSearchEngine.com](https://www.gunsearchengine.com/for-dealers?utm_source=coriolisagency&utm_medium=referral&utm_campaign=email-marketing-for-ffl-ecommerce&utm_content=dealer-program).")} />
    </div>
  </section>

  <FaqBlock items={FAQ_EMAIL} heading={"The questions dealers ask about gun store email, including Mailchimp, SMS, and the list"} />

  <TalkSection pillar="Email Marketing" heading={"Tell us about the website you want and we'll make it happen."} subline={"We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time."} contact={"You can also reach us at [(279) 258-6771](tel:+12792586771) or [support@coriolisagency.com](mailto:support@coriolisagency.com)."} />
</BaseLayout>
