---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import PosHero from "../components/PosHero.astro";
import TalkSection from "../components/TalkSection.astro";
import { LINKS, linkClass } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
import { TRUSTINDEX_REVIEWS_HREF } from "../lib/google-reviews";
import {
  FAQ_POS_PILLAR,
  POS_PILLAR_CARDS,
  POS_PILLAR_CARD_COPY,
  POS_PILLAR_PROOF_LINE,
  POS_PILLAR_TABLE_INTRO,
  POS_PILLAR_TABLE_FOOTNOTE,
  POS_PILLAR_PLAN_LINKS,
  POS_PILLAR_PLAN_BOOKS,
  POS_PILLAR_FAQ_TITLE,
  POS_PILLAR_FORM_CONTACT,
  POS_PILLAR_CONNECT_INTRO,
  POS_PILLAR_CONNECT_TITLE,
  POS_PILLAR_EYEBROW,
  POS_PILLAR_FORM_HEADING,
  POS_PILLAR_FORM_LINE,
  POS_PILLAR_H1,
  POS_PILLAR_HERO_ALT,
  POS_PILLAR_HOW,
  POS_PILLAR_HOW_TITLE,
  POS_PILLAR_JUMP,
  POS_PILLAR_LEDE,
  POS_PILLAR_MARKS,
  POS_PILLAR_META,
  POS_PILLAR_PLAN,
  POS_PILLAR_PLAN_TITLE,
  POS_PILLAR_TITLE,
  POS_PILLAR_TABLE_HEAD,
  POS_PILLAR_TABLE_ROWS,
  POS_PILLAR_TABLE_NOTE,
  POS_PILLAR_PROOF_TITLE,
  POS_PILLAR_PROOF,
  POS_PILLAR_CLOSING,
  posPillarItemList,
} from "../lib/pos-ecommerce";
import { md } from "../lib/md";

const ext = { target: "_blank", rel: "noopener noreferrer" };
// CA-VOICE-P1: POS cards as drafted. Name and slug stay on POS_PILLAR_CARDS (ItemList JSON-LD).
const CARD = /^\*\*\[([^\]]+)\]\(([^)\s]+)\)\.\*\*\s+(.*?)\s+(\[[^\]]+\]\([^)\s]+\) · \[[^\]]+\]\([^)\s]+\))$/;
const cards = POS_PILLAR_CARD_COPY.map((s) => {
  const m = s.match(CARD);
  if (!m) throw new Error("gun-store-pos card: " + s);
  return { name: m[1], href: m[2], body: m[3], links: m[4] };
});
---

<BaseLayout
  title={POS_PILLAR_TITLE}
  description={POS_PILLAR_META}
  path="/gun-store-pos"
  ogImagePath={CANON_PATHS.storefront}
  faq={FAQ_POS_PILLAR}
  extraJsonLd={[posPillarItemList(LINKS.home)]}
>
  <PosHero
    eyebrow={POS_PILLAR_EYEBROW}
    h1={POS_PILLAR_H1}
    lede={POS_PILLAR_LEDE}
    jumpLabel={POS_PILLAR_JUMP}
    image={{
      src: CANON_PATHS.gunStorePosHero,
      alt: POS_PILLAR_HERO_ALT,
      width: 1499,
      height: 1059,
    }}
  >
    <p class="mt-4 text-sm text-zinc-400" set:html={md(POS_PILLAR_PROOF_LINE)} />
  </PosHero>

  <section class="border-b border-zinc-800/80 py-12" id="which-pos">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-300">{POS_PILLAR_TABLE_INTRO}</p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[48rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              {POS_PILLAR_TABLE_HEAD.map((h) => <th class="py-3 pr-3 font-medium">{h}</th>)}
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              POS_PILLAR_TABLE_ROWS.map(([pos, out, back, plan]) => (
                <tr class="border-b border-zinc-800/80">
                  <th class="py-3 pr-3 align-top font-medium text-zinc-300" set:html={md(pos)} />
                  <td class="py-3 pr-3 align-top">{out}</td>
                  <td class="py-3 pr-3 align-top">{back}</td>
                  <td class="py-3 pr-3 align-top">{plan}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-zinc-500">{POS_PILLAR_TABLE_FOOTNOTE}</p>
      <p class="mt-2 text-sm text-zinc-500">{POS_PILLAR_TABLE_NOTE}</p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="connect">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{POS_PILLAR_CONNECT_TITLE}</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        {POS_PILLAR_CONNECT_INTRO}
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          cards.map((card) => (
            <article class="flex flex-col rounded-2xl border border-gold/40 bg-gold/5 p-6">
              <h3 class="text-2xl font-semibold text-white"><a href={withBase(card.href)} class="hover:text-gold">{card.name}</a></h3>
              <p class="mt-3 text-sm leading-relaxed text-zinc-300" set:html={md(card.body)} />
              <p class="mt-auto pt-5 text-sm" set:html={md(card.links)} />
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-zinc-500">{POS_PILLAR_MARKS}</p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="shops">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{POS_PILLAR_PROOF_TITLE}</h2>
      {
        POS_PILLAR_PROOF.map((para) => (
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md(para)} />
        ))
      }
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="how">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{POS_PILLAR_HOW_TITLE}</h2>
      {
        POS_PILLAR_HOW.map((para) => (
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">{para}</p>
        ))
      }
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="plan">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{POS_PILLAR_PLAN_TITLE}</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        {POS_PILLAR_PLAN}
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md(POS_PILLAR_PLAN_LINKS)} />
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">{POS_PILLAR_PLAN_BOOKS}</p>
    </div>
  </section>

  <FaqBlock items={FAQ_POS_PILLAR} heading={POS_PILLAR_FAQ_TITLE} />

  <section class="py-8">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400">{POS_PILLAR_CLOSING}</p>
    </div>
  </section>

  <TalkSection
    pillar="Ecommerce"
    heading={POS_PILLAR_FORM_HEADING}
    subline={POS_PILLAR_FORM_LINE}
    contact={POS_PILLAR_FORM_CONTACT}
  />
</BaseLayout>
