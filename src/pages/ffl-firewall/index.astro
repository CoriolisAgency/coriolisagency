---
/**
 * FFL Firewall landing page. Copy is Brandy's, verbatim.
 * FFLF-FIREWALL-V1-S3B-BUY: the early-access lead form is retired. Both buy
 * buttons go to the live Stripe payment link. The page stays noindex, nofollow.
 * Guarded by scripts/test-ffl-firewall-landing.mjs.
 *
 * To index later: drop the `noindex` prop below and the matching X-Robots-Tag,
 * sitemap filter, lastmod SKIP, robots.txt Disallow, and IndexNow refusal.
 * To drop the nav item: remove the FFL Firewall entry in src/lib/nav.ts.
 *
 * CA-FFLFW-HERO-MATCH (Paul 2026-11-16 8:52 PM ET via Chief): hero slot matches
 * the FFL Filters page (same 1440x1152 / 750x1200 picture, under the buttons). Checkout
 * art reuses the FFL Filters Glock product photos and specs; placeholders gone.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { btnPlan, btnSecondary, linkClass } from "../../lib/links";
import { withBase } from "../../lib/base";

const contact = withBase("contact");
const terms = withBase("ffl-firewall/terms");
const buyHref = "https://checkout.coriolisagency.com/b/6oU7sM3obb7c5phf2o1440s";
const buyLabel = "Buy FFL Firewall: unlimited transactions, $79 a month";
const buyFooterLabel = "Get unlimited transactions for $79 a month";
const contactLabel = "Talk to Coriolis";
const logo = withBase("brand/ffl-firewall/ffl-firewall-lockup-on-dark.svg");
const ogImage = "og/ffl-firewall-og.jpg";
const ogImageAlt =
  `The FFL Firewall logo and the headline "A WooCommerce plugin that checks the cart at checkout for FFL dealers" sit on a dark navy background. Beside them, a stylized checkout in a browser window shows a cart with one item pulled out and a message that the item can't be shipped to the zip code the shopper entered.`;
const heroAlt =
  `A stylized checkout in a browser window, with the address yourstore.example/checkout. The cart shows Glock pistols with their photos and specs; one row is pulled out, and a message reads, "This item can't be shipped to the zip code you entered."`;
const h2 = "text-2xl font-semibold tracking-tight text-white";
const eyebrow = "text-xs font-semibold uppercase tracking-wider text-sky-400";
const body = "mt-4 text-base leading-relaxed text-zinc-300";
---

<BaseLayout
  title="FFL Firewall: a WooCommerce checkout plugin for FFL dealers | Coriolis"
  description="FFL Firewall is a WooCommerce plugin for FFL dealers, made by Coriolis. At checkout it checks each product against the shopper's zip code and removes items that can't go there."
  path="/ffl-firewall"
  noindex
  ogImagePath={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt={ogImageAlt}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16" data-section="hero">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <img src={logo} alt="FFL Firewall" width="278" height="80" class="h-auto w-[216px] sm:w-[278px]" />
      <p class={`mt-8 ${eyebrow}`}>FFL Firewall</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">A WooCommerce plugin that checks the cart at checkout for FFL dealers</h1>
      <p class={body}>At checkout, FFL Firewall checks each product in the cart by UPC against the zip code the shopper entered. If an item is prohibited for that zip, it's removed from the cart and the shopper sees a message explaining why.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={buyHref} class={btnPlan} data-buy="hero">{buyLabel}</a>
        <a href={contact} class={btnSecondary}>{contactLabel}</a>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-zinc-400">One flat price covers every cart: $79 a month for unlimited transactions, billed monthly through Stripe Checkout. There's no free trial, and you can cancel anytime. <a href={terms} class={linkClass}>Read the FFL Firewall terms</a></p>
      <p class="mt-3 text-xs text-zinc-500">For FFL dealers running WooCommerce.</p>
      <picture>
        <source media="(min-width: 640px)" type="image/webp" srcset={withBase("brand/ffl-firewall/hero/ffl-firewall-hero-desktop-1440x1152.webp")} width="1440" height="1152" />
        <source media="(min-width: 640px)" srcset={withBase("brand/ffl-firewall/hero/ffl-firewall-hero-desktop-1440x1152.jpg")} width="1440" height="1152" />
        <source type="image/webp" srcset={withBase("brand/ffl-firewall/hero/ffl-firewall-hero-mobile-750x1200.webp")} width="750" height="1200" />
        <img
          src={withBase("brand/ffl-firewall/hero/ffl-firewall-hero-mobile-750x1200.jpg")}
          width="750"
          height="1200"
          alt={heroAlt}
          class="mt-10 block h-auto w-full rounded-[14px]"
          fetchpriority="high"
          decoding="async"
          loading="eager"
        />
      </picture>
    </div>
  </section>

  <section class="py-12" data-section="built-around">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class={eyebrow}>Built around how gun stores sell</p>
      <h2 class={`mt-3 ${h2}`}>It checks each product in the cart against the shopper's zip</h2>
      <p class={body}><strong class="text-white">The product check.</strong> The plugin runs at checkout and matches the UPC on every cart item to the zip the buyer just entered.</p>
      <p class={body}><strong class="text-white">Items that can't go there.</strong> If that check finds a product is prohibited for the zip, the plugin takes it out of the cart.</p>
      <p class={body}><strong class="text-white">A message for the shopper.</strong> A short note tells the shopper why the item was removed.</p>
    </div>
  </section>

  <section class="border-t border-zinc-800/80 py-12" data-section="fits">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class={eyebrow}>Fits your shop</p>
      <h2 class={`mt-3 ${h2}`}>It runs at the checkout you already use</h2>
      <p class={body}>The shopper types a zip at checkout, the way they already do on a WooCommerce store. FFL Firewall takes that zip, plus the UPC already on each cart item, and runs the product check. Anything prohibited for that zip comes out, and a message goes to the shopper with the reason.</p>
    </div>
  </section>

  <section class="border-t border-zinc-800/80 py-12" data-section="settings">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class={eyebrow}>What the check uses</p>
      <h2 class={`mt-3 ${h2}`}>It uses the UPC on the product and the zip at checkout</h2>
      <p class={body}>The check reads the UPC already on each product in the cart, and the zip the shopper typed at checkout. Those are the two things it needs.</p>
    </div>
  </section>

  <section class="border-t border-zinc-800/80 py-12" data-section="faq">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class={eyebrow}>The questions dealers ask</p>
      <h2 class={`mt-3 ${h2}`}>The questions dealers ask about FFL Firewall</h2>
      <p class={body}><strong class="text-white">What does FFL Firewall check?</strong><br />It looks at the UPC on each item in the cart and the zip the shopper entered at checkout.</p>
      <p class={body}><strong class="text-white">What happens if an item is prohibited for that zip?</strong><br />That item comes out of the cart, and a message tells the shopper why.</p>
      <p class={body}><strong class="text-white">Does this take the place of my own shipping judgment?</strong><br />FFL Firewall is a tool that helps you catch restricted items at checkout. You're still responsible for what you ship, and this is not legal advice.</p>
      <p class={body}><strong class="text-white">How do I buy it?</strong><br />Click Buy FFL Firewall on this page and pay through Stripe Checkout. It's $79 a month with no cap on transactions, and there's no free trial. Your license key and the plugin download link arrive by email; install the plugin and paste the key into WooCommerce > FFL Firewall. To cancel, use the billing portal link in that email, and the checks keep running until the end of the month you've already paid for.</p>
      <p class={body}><strong class="text-white">Who is it for?</strong><br />FFL dealers who run a WooCommerce store.</p>
    </div>
  </section>

  <section class="border-t border-zinc-800/80 py-12" data-section="install">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class={eyebrow}>How buying works</p>
      <h2 class={`mt-3 ${h2}`}>Pay through Stripe, get your key by email, paste it in</h2>
      <p class={body}>Checkout runs on Stripe. When your payment goes through, we email your license key and a link to download the plugin to the address you used at checkout. Install the plugin in WordPress, go to WooCommerce > FFL Firewall, paste the key into the License key field and click Check key. If you'd like a hand with your WooCommerce store, talk to Coriolis.</p>
    </div>
  </section>

  <section class="border-t border-zinc-800/80 py-12" data-section="requirements">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class={eyebrow}>Requirements</p>
      <ul class="mt-4 list-disc space-y-2 pl-6 text-base leading-relaxed text-zinc-300">
        <li>A WooCommerce store</li>
        <li>Products that have a UPC</li>
        <li>A checkout where the shopper enters a zip code</li>
      </ul>
    </div>
  </section>

  <section id="buy" class="border-t border-zinc-800/80 py-12" data-section="download">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class={eyebrow}>Buy FFL Firewall</p>
      <h2 class={`mt-3 ${h2}`}>Get FFL Firewall for $79 a month</h2>
      <p class={body}>This is a Coriolis plugin for FFL dealers who already run WooCommerce, and one subscription covers unlimited transactions, so the check runs on every order your store takes. Buy it through Stripe Checkout, and we'll email your license key and the download link once the payment goes through. If you'd like a hand with your store first, talk to Coriolis.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={buyHref} class={btnPlan} data-buy="footer">{buyFooterLabel}</a>
        <a href={contact} class={btnSecondary}>{contactLabel}</a>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-zinc-400">$79 a month, however many transactions your store runs. No free trial, and you can cancel anytime from your billing portal. <a href={terms} class={linkClass}>Read the FFL Firewall terms</a></p>
      <p class={body}>FFL Firewall is a tool that helps you catch restricted items at checkout. You're still responsible for what you ship, and this is not legal advice.</p>
      <p class="mt-4 text-sm text-zinc-400"><a href="mailto:support@coriolisagency.com" class="font-medium !text-sky-400 hover:!underline underline-offset-2">support@coriolisagency.com</a></p>
    </div>
  </section>
</BaseLayout>
