---
/**
 * FFL Firewall landing page. FFLF-FIREWALL-V1-OVERWATCH-LEAD: OVERWATCH leads,
 * ACTIVE DEFENSE is the always-on layer, RECON is the store hardening report, at the flat
 * $79/month. Copy is Brandy's v3 landing copy, verbatim (Paul approved the mocks
 * 1:33 PM ET Nov 19, 2026). Built from FFLF-FIREWALL-V1-S5F.
 * RECON is live (Paul 12:42 PM ET) and covers
 * WordPress.org versions and configuration gaps only.
 * Download gate, Stripe buy link and terms link are unchanged (S3B-BUY).
 * FFLFW-LANDING-1-0: the zip and noindex follow the one launch switch in
 * src/lib/ffl-firewall-release.mjs (FFLFW_V1_LIVE, left false until Paul's S4 purchase passes; the
 * file lists the two static companions). While false the page stays noindex, nofollow and serves 0.1.3.
 * Site-key lines and the setup-guide link: Brandy's FINAL strings (Karp-cleared 11:58 AM ET Nov 23, 2026), verbatim.
 * Guarded by scripts/test-ffl-firewall-landing.mjs.
 * To drop the nav item: remove the FFL Firewall entry in src/lib/nav.ts.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import FflFiltersDownloadGate from "../../components/FflFiltersDownloadGate.astro";
import FflFwName from "../../components/FflFwName.astro";
import FflFwGlyph from "../../components/FflFwGlyph.astro";
import { withBase } from "../../lib/base";
import { fflfwZip, fflfwLandingNoindex } from "../../lib/ffl-firewall-release.mjs";
import FflFwNetworkMap from "../../components/FflFwNetworkMap.astro";

const contact = withBase("contact");
const terms = withBase("ffl-firewall/terms");
const buyHref = "https://checkout.coriolisagency.com/b/6oU7sM3obb7c5phf2o1440s";
const getLabel = "Get FFL Firewall";
const contactLabel = "Talk to Coriolis";
// The plugin zip: public/downloads/ffl-firewall-0.1.3.zip until FFLFW_V1_LIVE flips (0.1.1 and 0.1.2 stay in place).
const download = withBase(fflfwZip());
const setup = withBase("ffl-firewall/setup");
// Download gate copy, Paul-approved earlier (Nov 18, 2026), unchanged.
const gate = {
  title: "Download FFL Firewall",
  description:
    "FFL Firewall is a paid plugin, and anyone can download and install it with no purchase needed; it checks carts once you add a license. Enter your company name, website URL, and email, and your download starts.",
  submitLabel: "Download",
  emailInvalid: "That email doesn't look valid.",
  leadMessage: "FFL Firewall download",
  thanksLead:
    "Your download has started, and you can install FFL Firewall without buying anything. Unlicensed installs don't check carts, so your orders are left alone until you add a license key, which costs $79 a month for unlimited transactions. The built-in demo in WooCommerce > FFL Firewall gives you 10 test runs to see each result first. Buy a license whenever you're ready, and we'll email your key. If you need help, ",
  buyLabel: "Buy a license",
};
const logo = withBase("brand/ffl-firewall/ffl-firewall-lockup-on-dark.svg");
const endorseLogo = withBase("brand/ffl-firewall/ffl-law-endorsed-by-badge-white.png");
const ogImage = "og/ffl-firewall-og.png";
const ogImageAlt =
  "FFL Firewall: fraud detection, state shipping checks, and bot and AI defense for WooCommerce in one managed service.";
---

<BaseLayout
  title="FFL Firewall: state shipping checks and managed security for WooCommerce FFL dealers | Coriolis"
  description="A managed ecommerce security and compliance service that updates itself in real-time and adapts automatically to emergent threats"
  path="/ffl-firewall"
  noindex={fflfwLandingNoindex()}
  ogImagePath={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt={ogImageAlt}
>
  <div class="fwl">
  <section class="fwl-sec" data-section="hero"><div class="col"><div class="hero-marks">
  <img src={logo} alt="FFL Firewall" width="278" height="80" class="lock" />
  <a class="endorse" href="https://ffllaw.com" target="_blank" rel="noopener noreferrer">
    <img
      src={endorseLogo}
      alt="Endorsed by FFL Law"
      width="1600"
      height="535"
    />
  </a>
</div>
  <div class="eb">FFL Firewall</div><h1>Fraud Detection, Bot Mitigation, and State Law Compliance</h1><p class="pos">A managed ecommerce security and compliance service that updates itself in real-time and adapts automatically to emergent threats <span class="shield" aria-hidden="true">🛡️</span></p>
  <div class="console" data-console>
<div class="crow">

<div class="cc" id="card-fraud">
 <div class="st"><span class="svc-tag">Transaction Security</span></div>
 <div class="hd">
  <svg class="glyph" width="36" height="36" viewBox="0 0 96 96" aria-hidden="true"><rect x="10" y="22" width="76" height="52" rx="8" fill="none" stroke="#E4E4E7" stroke-width="5" stroke-dasharray="9 7"></rect><path d="M10 38 H86" stroke="#E4E4E7" stroke-width="3" opacity=".6"></path><path d="M48 50 L58 60 L48 70 L38 60 Z" fill="#E53E3E" opacity=".9"></path></svg>
  <div class="nm">Fraud Detection</div>
 </div>
 <div class="k"><FflFwName n="PICKET" /></div>
 <p>It screens card orders on high-value optics, with firearms orders handled too, and holds the risky ones for you to review. You make the call on every held order.</p>
</div>

<div class="cc" id="card-state">
 <div class="st"><span class="svc-tag">CART MONITOR</span></div>
 <div class="hd">
  <svg class="glyph" width="36" height="36" viewBox="0 0 96 96" aria-hidden="true"><circle cx="48" cy="48" r="38" fill="none" stroke="#E4E4E7" stroke-width="5"></circle><circle cx="48" cy="48" r="20" fill="none" stroke="#E4E4E7" stroke-width="3" opacity=".6"></circle><path d="M48 48 L48 10 A38 38 0 0 1 75 21 Z" fill="#E53E3E" opacity=".85"></path><path d="M48 48 L48 10" stroke="#E53E3E" stroke-width="4" stroke-linecap="round"></path><circle cx="48" cy="48" r="4" fill="#E4E4E7"></circle><circle cx="30" cy="66" r="4" fill="#E4E4E7" opacity=".8"></circle></svg>
  <div class="nm">State Law Compliance</div>
 </div>
 <div class="k"><FflFwName n="OVERWATCH" /></div>
 <p>Checks each cart item's UPC against the shipping ZIP at checkout. Restricted items come out of the cart with a note to the shopper, or get flagged for your review.</p>
</div>

<div class="cc" id="card-bot">
 <div class="st"><span class="svc-tag">Adaptive Protection</span></div>
 <div class="hd">
  <svg class="glyph" width="36" height="36" viewBox="0 0 96 96" aria-hidden="true"><path d="M48 8 L84 21 V46 C84 68 68 82 48 90 C28 82 12 68 12 46 V21 Z" fill="none" stroke="#E4E4E7" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M26 50 H70" stroke="#E53E3E" stroke-width="5" stroke-linecap="round"></path><path d="M26 38 H70 M26 62 H70" stroke="#E4E4E7" stroke-width="2" opacity=".35"></path></svg>
  <div class="nm">Bot &amp; AI Defense</div>
 </div>
 <div class="k"><FflFwName n="DEFENDER" /></div>
 <p>Monitors, detects, and blocks abusive bots, scrapers, and AI agents on your store with rate limits, header checks, honeypots, and card-testing checks.</p>
</div>

</div>
</div><p class="hero-lede"><FflFwName n="OVERWATCH" /> checks each cart item's UPC against the shipping ZIP at checkout and removes or flags restricted items. <FflFwName n="DEFENDER" /> is bot and scraper mitigation powered by network sensors and automatic updates, and it runs once you keep it on and your dealer embed script is checking in with Coriolis. <FflFwName n="PICKET" /> is our Fraud Detection service for card orders on high-value optics.</p>
  <div class="btns"><a href={download} class="btn red" download data-download="hero">{getLabel}</a><a href={contact} class="btn">{contactLabel}</a></div><p class="small">For FFL dealers running WooCommerce. The price is a flat $79 a month, whether or not you turn on <FflFwName n="DEFENDER" />.</p>
</div></section>
  
  <section class="fwl-sec" data-section="network-map"><div class="col"><FflFwNetworkMap /></div></section>
  <section class="fwl-sec" data-section="services"><div class="col"><div class="eb">What's in the plugin</div><h2>Shipping checks first, then a security layer</h2><div class="svc"><div class="sv"><FflFwGlyph kind="overwatch" size={56} /><div><h3><FflFwName n="OVERWATCH" /></h3><div class="k">State shipping checks<span class="svc-tag">SHIPPING COMPLIANCE</span></div><p>On both the classic and Blocks checkout, it matches each item's UPC to the shipping ZIP to help you catch items that can't ship there. Those items come out of the cart with a note to the shopper, items that need a permit or age check get a required acknowledgement checkbox, and orders that need a second look get an order note and a Flagged label.</p><p>If the check can't run, checkout carries on and the order is flagged for you to review.</p></div></div><div class="sv"><FflFwGlyph kind="active-defense" size={56} /><div><h3><FflFwName n="DEFENDER" /></h3><div class="k">Bot and scraper control<span class="svc-tag">BOT MITIGATION</span></div><p>You keep it on at the first-open screen. With an active license, it then connects the site key made when you bought FFL Firewall and adds the dealer embed script for you, and from then on it keeps watching the traffic coming into your store. It blocks only while your license is active and your dealer embed script has checked in with Coriolis in the last 24 hours. It spots bots and scrapers and blocks or throttles them before they reach checkout, using rate limits, user agent and header checks, honeypot form fields that only bots fill in, checkout velocity and card-testing checks, and an optional datacenter IP list.</p><p>Each check runs on your own site, where a request it catches is blocked or slowed down. The shared reputation feed adds what other FFL Firewall stores have seen: your store reports the bots its checks catch as salted hashes of their IP addresses, IPv6 networks and user agents, with no shopper names, emails, orders or payment details, and receives a list of bots those stores have reported. While FFL Firewall · DEFENDER is on, the dealer embed script also sends gunsearchengine.com, which is operated by Coriolis, LLC, details of each visit, including the pages and products your visitors view and any email address they enter in the dealer search; the FFL Firewall terms explain what it keeps.</p></div></div></div><p class="foot">You're still responsible for what you ship, and this is not legal advice.</p></div></section>
  
  <section class="fwl-sec" data-section="activation"><div class="col"><div class="eb">Activation</div><h2>You decide when <FflFwName n="DEFENDER" /> starts working</h2><p>The first time you open the FFL Firewall page, a one-time screen asks you to choose Keep DEFENDER on or Switch off DEFENDER. Your site key is made when you buy FFL Firewall; with an active license, the plugin connects that key to your store and takes care of the dealer embed script, and the service keeps watching from there.</p><div class="steps"><div class="stp"><div class="n">1</div><h3>Choose Keep on the first-open screen</h3><p>In WooCommerce, go to FFL Firewall. The one-time screen opens first, and you choose Keep DEFENDER on. You can change that later from the <FflFwName n="DEFENDER" /> tab.</p></div><div class="stp"><div class="n">2</div><h3>Read what it sends</h3><p>The first-open screen shows what <FflFwName n="DEFENDER" /> sends to Coriolis, LLC, before you choose. With an active license, the plugin picks up the site key made at checkout and connects it to your store, so there's nothing to copy. If you already have a site key, you can still paste it into the Site key field on the <FflFwName n="DEFENDER" /> tab, and a pasted key is the one the plugin uses.</p></div><div class="stp"><div class="n">3</div><h3>The plugin adds the dealer embed</h3><p>Once the key is saved, the plugin adds the dealer embed to your store's pages for you. The countermeasures start after your dealer embed script first checks in with Coriolis, and they run while your license is active.</p></div></div>
  <p><FflFwName n="DEFENDER" /> blocks only while your license is active and your dealer embed script has checked in with Coriolis in the last 24 hours. Your plugin dashboard shows the service as active only while that check-in is current. If a day goes by without one, the dashboard says so, which tells you to check your site key and settings. Your bill doesn't change either way, because the plan costs $79 a month whether the service is on or off.</p></div></section>
  
  <section class="fwl-sec" data-section="pricing"><div class="col"><div class="eb">Pricing</div><h2>One flat price of $79 a month</h2><div class="price"><div><div class="amt">$79<small> / month</small></div></div>
  <div><p class="pos pos-sm">A managed ecommerce security and compliance service that updates itself in real-time and adapts automatically to emergent threats <span class="shield" aria-hidden="true">🛡️</span></p><ul><li>Unlimited <FflFwName n="OVERWATCH" /> transactions</li><li><FflFwName n="DEFENDER" />, which detects and blocks abusive bots, scrapers, and AI agents</li><li><FflFwName n="PICKET" /> (Fraud Detection)</li><li>Every future feature we add</li></ul><p class="small">You pay the same $79 a month whether or not <FflFwName n="DEFENDER" /> is on. Billing runs monthly in advance through Stripe Checkout, and you can cancel at any time. <a href={terms} class="lnk">Read the FFL Firewall terms</a></p><div class="btns tight">
              <a href={download} class="btn red" download data-download="pricing">{getLabel}</a>
            </div></div></div></div></section>
  
  <section class="fwl-sec faq" data-section="faq"><div class="col"><div class="eb">Questions</div><h2>The questions dealers ask about FFL Firewall</h2><div class="q"><b>What do I get for $79 a month?</b><p>You get unlimited <FflFwName n="OVERWATCH" /> transactions and <FflFwName n="DEFENDER" /> after you choose Keep on the first-open screen and your dealer embed script checks in. <FflFwName n="PICKET" /> (Fraud Detection) is included too. Every feature we add later is included at the same price.</p></div><div class="q"><b>Does <FflFwName n="OVERWATCH" /> look at every order?</b><p>It looks at items that carry a UPC when the shopper reaches checkout. Items with no UPC pass through, and when the check can't finish, the order goes through with a Flagged label so you can review it yourself.</p></div><div class="q"><b>When does <FflFwName n="DEFENDER" /> start working?</b><p>The first time you open the FFL Firewall page, a one-time screen asks you to keep it on or switch it off, and you can change that later from the <FflFwName n="DEFENDER" /> tab. Your plugin dashboard marks it active while its dealer embed check-in is current.</p></div><div class="q"><b>What happens to a bot that <FflFwName n="DEFENDER" /> catches?</b><p>The request is blocked or slowed down, whether it was caught by a rate limit, a honeypot form field or one of the other checks. Those checks run on your own site; while your store is in the shared reputation feed, it also reports the bots it catches as salted hashes of their IP addresses, IPv6 networks and user agents, with no shopper names, emails, orders or payment details. Checkout, login, the cart, My Account and wp-admin are never touched by the feed.</p></div><div class="q"><b>Is FFL Firewall legal advice?</b><p>No. FFL Firewall is a tool that helps you catch restricted items at checkout, and every shipping decision stays with you and your own counsel.</p></div></div></section>
  
  <section id="buy" class="fwl-sec last" data-section="download"><div class="col"><div class="eb">Get FFL Firewall</div><h2>Put FFL Firewall on your WooCommerce store</h2><p>This is a Coriolis plugin for FFL dealers who already run WooCommerce, and one $79 monthly plan covers every service in it. If you'd like a hand with your store first, talk to Coriolis.</p><div class="btns"><a href={download} class="btn red" download data-download="footer">{getLabel}</a><a href={contact} class="btn">{contactLabel}</a></div>
  <p class="small">FFL Firewall helps you protect your store and catch restricted items at checkout. You're still responsible for what you ship, and this is not legal advice.</p><p><a href={setup} class="lnk" data-setup-link>Read the setup guide</a></p><p><a href="mailto:support@coriolisagency.com" class="lnk">support@coriolisagency.com</a></p></div></section>
  </div>
  <FflFiltersDownloadGate
    href={download}
    title={gate.title}
    description={gate.description}
    submitLabel={gate.submitLabel}
    emailInvalid={gate.emailInvalid}
    leadMessage={gate.leadMessage}
    thanksLead={gate.thanksLead}
    buyHref={buyHref}
    buyLabel={gate.buyLabel}
  />
</BaseLayout>

<style>
  .fwl { color: #E4E4E7; font-size: 16px; line-height: 1.6; }
  .col { max-width: 880px; margin: 0 auto; padding: 0 32px; }
  .fwl-sec { padding: 72px 0; border-bottom: 1px solid #1c2738; }
  .fwl-sec.last { border-bottom: 0; }
  .hero-marks {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin: 0 0 26px;
    flex-wrap: wrap;
  }
  .lock {
    height: 64px;
    width: auto;
    display: block;
    margin: 0; /* bottom margin moves to .hero-marks */
  }
  .endorse {
    display: block;
    flex: none;
    line-height: 0;
  }
  .endorse img {
    height: 72px; /* 1.2x prior 60px rendered height, aspect ratio kept */
    width: auto;
    display: block;
  }
  .eb { color: #E53E3E; font-size: 12px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; margin: 0 0 10px; }
  /* FFLFW-PAGE-H1-CARTMON: one line on desktop (col is 880px / 816px content). */
  h1 { font-size: clamp(26px, 2.34vw, 30px); line-height: 1.15; margin: 0 0 20px; letter-spacing: -.8px; color: #fff; font-weight: 700; }
  @media (min-width: 1280px) {
    h1 { font-size: 30px; white-space: nowrap; }
  }
  h2 { font-size: 32px; line-height: 1.2; margin: 0 0 16px; letter-spacing: -.4px; color: #fff; font-weight: 700; }
  .fwl p { margin: 0 0 14px; color: #d4d4d8; }
  .fwl p.hero-lede { margin: 0 0 26px; }
  .pos { font-size: 21px; line-height: 1.45; color: #fff !important; font-weight: 500; border-left: 3px solid #E53E3E; padding-left: 16px; }
  .pos-sm { font-size: 18px; }
  .btns { display: flex; gap: 12px; margin: 26px 0 12px; flex-wrap: wrap; }
  .btns.tight { margin: 4px 0 0; }
  .btn { display: inline-block; padding: 13px 22px; border-radius: 6px; font-weight: 700; font-size: 15px; border: 1px solid #3a4658; color: #fff; text-decoration: none; }
  .btn.red { background: #E53E3E; border-color: #E53E3E; }
  .btn:hover { filter: brightness(1.1); }
  .fwl .small { font-size: 13px; color: #A1A1AA; }
  .console { margin-top: 40px; margin-bottom: 40px; background: #0F1B2D; border: 1px solid #26344a; border-radius: 14px; padding: 18px; box-shadow: 0 30px 60px rgba(0,0,0,.45); }
  .crow { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .cc { background: #0A1220; border: 1px solid #26344a; border-radius: 10px; padding: 16px; display: flex; flex-direction: column; gap: 8px; }
  .cc .hd { display: flex; align-items: center; gap: 10px; }
  .cc .hd .glyph { flex: none; }
  .cc .nm { font-weight: 700; letter-spacing: .6px; font-size: 17px; color: #fff; white-space: nowrap; }
  .cc .k { font-size: 12px; color: #A1A1AA; }
  .fwl .cap { font-size: 12px; color: #A1A1AA; margin: 10px 0 0; text-align: center; }
  .svc { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 26px; }
  .sv { background: #0F1B2D; border: 1px solid #26344a; border-radius: 12px; padding: 26px 28px; display: grid; grid-template-columns: 64px 1fr; gap: 18px; }
  .sv h3 { margin: 0; font-size: 21px; color: #fff; font-weight: 500; }
  .sv .k { color: #A1A1AA; font-size: 14px; margin: 2px 0 12px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .fwl .sv p { font-size: 15.5px; }
  .fwl .sv p:last-child { margin: 0; }
  .svc-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; color: var(--color-gold); border: 1px solid color-mix(in srgb, var(--color-gold) 50%, transparent); border-radius: 4px; padding: 2px 8px; align-self: flex-start; }
  .fwl .foot { font-size: 13px; color: #A1A1AA; margin-top: 16px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 26px 0 18px; }
  .stp { background: #0F1B2D; border: 1px solid #26344a; border-radius: 12px; padding: 22px; }
  .stp .n { width: 32px; height: 32px; border-radius: 50%; background: #E53E3E; color: #fff; font-weight: 700; display: grid; place-items: center; margin: 0 0 12px; }
  .stp h3 { margin: 0 0 6px; font-size: 17px; color: #fff; font-weight: 600; }
  .fwl .stp p { font-size: 14.5px; margin: 0; }
  .price { background: #0F1B2D; border: 1px solid #E53E3E; border-radius: 14px; padding: 32px; margin-top: 22px; display: grid; grid-template-columns: 240px 1fr; gap: 28px; }
  .amt { font-size: 64px; font-weight: 700; color: #fff; line-height: 1; }
  .amt small { font-size: 20px; color: #A1A1AA; font-weight: 500; }
  .price ul { margin: 0 0 16px; padding: 0; list-style: none; }
  .price li { padding: 8px 0 8px 28px; position: relative; border-bottom: 1px solid #26344a; color: #e4e4e7; }
  .price li::before { content: ""; position: absolute; left: 4px; top: 15px; width: 10px; height: 10px; border-radius: 2px; background: #E53E3E; }
  .lnk { color: #fca5a5; text-decoration: underline; }
  .faq .q { border-top: 1px solid #26344a; padding: 18px 0; }
  .faq .q > b { display: block; color: #fff; font-size: 17px; margin: 0 0 6px; }
  .fwl .faq .q p { margin: 0; }
  @media (max-width: 600px) {
    .col { padding: 0 20px; }
    .fwl-sec { padding: 48px 0; }
    .hero-marks {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .lock { height: 48px; }
    .endorse img { height: 72px; }
    h1 { font-size: 32px; }
    h2 { font-size: 25px; }
    .pos { font-size: 18px; }
    .crow, .steps { grid-template-columns: 1fr; }
    .sv { grid-template-columns: 1fr; padding: 22px; gap: 10px; }
    .price { grid-template-columns: 1fr; padding: 24px; gap: 14px; }
    .amt { font-size: 52px; }
    .btn { width: 100%; text-align: center; }
  }

  /* CA-FFLFW-PAGE-TRUTH: card console from cleared index.html */
  .cc .k .fwn { color: #d4d4d8; font-size: 12px; letter-spacing: .2px; }
  .cc p { margin: 2px 0 0; color: #d4d4d8; font-size: 13.5px; line-height: 1.5; }
  .st { min-height: 22px; }
  /* Card badges only. Services-section .svc-tag stays on --color-gold. */
  .cc .svc-tag { color: var(--color-green-500); border-color: color-mix(in srgb, var(--color-green-500) 50%, transparent); }
  .svc-tag.live { color: #a1a1aa; border-color: #3a4658; }
  @media (max-width: 600px) {
    .cc p { font-size: 14.5px; }
  }
</style>
