---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import SwitchChecklist from "../components/SwitchChecklist.astro";
import { FAQ_AMMOREADY } from "../lib/faq";
import { HOWTO_SWITCH } from "../lib/howto";
import { linkClass } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const rows = [
  ["What you own", "A login on their platform", "The WooCommerce site, on your domain"],
  ["How you grow", "Usage and catalog limits are their levers", "Minute Man $169 → Accelerator $569. You keep the URL."],
  ["Dropshipping", "Manual or limited catalogs", "FFL Cockpit: 21 distributors, automated routing (Militia+)"],
  ["POS", "Their register partner", "The register you already run (Warlord+)"],
  ["SEO", "Their URLs, their templates", "Your slugs, your content, your schema"],
  ["Exit", "Export what they allow", "Take the site. It is WordPress."],
] as const;
---

<BaseLayout
  title="AmmoReady alternative — WooCommerce + FFL Cockpit | Coriolis"
  description="Coriolis is the AmmoReady alternative: WooCommerce you own, 21 distributor catalogs through FFL Cockpit, and a five-step migration playbook. Founded by the person who ran AmmoReady for nine years."
  path="/ammoready-alternative"
  ogImagePath={CANON_PATHS.rangeMckinney}
  faq={FAQ_AMMOREADY}
  extraJsonLd={[HOWTO_SWITCH]}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        Ecommerce · Switch
      </p>
      <h1
        class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        AmmoReady alternative
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
        AmmoReady is a fine place to start. It is a template website you don't
        own — ads you can't strip, their URLs, their race. When you want a site
        that actually works under your name, Coriolis is the AmmoReady
        alternative. Template-based websites kill SEO in the cradle. We replace
        them with WooCommerce on your domain. Leaving Gearfire? See the{" "}
        <a href={withBase("gearfire-alternative")} class={linkClass}
          >Gearfire alternative</a
        >{" "}
        page.
      </p>
      <div class="mt-8">
        <CtaRow primary="ecommerce" showGsa={false} showAccelerator showContact />
      </div>
      <EcommerceCluster current="ammoready-alternative" />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        AmmoReady vs Coriolis
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        Closed-platform column is AmmoReady. Gearfire, FirearmCart, and Gunpowdr
        live on the{" "}
        <a href={withBase("gearfire-alternative")} class={linkClass}
          >Gearfire alternative</a
        >{" "}
        table.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              <th class="py-3 pr-4 font-medium"> </th>
              <th class="py-3 pr-4 font-medium">Closed platform</th>
              <th class="py-3 font-medium text-zinc-200">Coriolis WooCommerce</th>
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              rows.map(([k, a, b]) => (
                <tr class="border-b border-zinc-800/80">
                  <th class="py-3 pr-4 font-medium text-zinc-300">{k}</th>
                  <td class="py-3 pr-4">{a}</td>
                  <td class="py-3 text-zinc-200">{b}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        AmmoReady migration playbook
      </h2>
      <SwitchChecklist founderNote />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <p class="max-w-3xl text-sm text-zinc-400">
        Setup is $500 or $2,500. Monthly hosting starts after we talk. The plan
        is{" "}
        <a href={`${withBase("ecommerce")}#ffl-accelerator`} class={linkClass}
          >FFL Accelerator</a
        >
        {" "}
        at $569.
      </p>
      <CtaRow primary="ecommerce" showGsa={false} showAccelerator />
    </div>
  </section>

  <FaqBlock items={FAQ_AMMOREADY} />
</BaseLayout>
