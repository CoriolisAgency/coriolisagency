---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LeadForm from "@coriolis/lead-form/LeadForm.astro";
import { FAQ_DEMAND_INTELLIGENCE } from "../lib/faq";
import { CANON_PATHS } from "../lib/site";
import { linkClass } from "../lib/links";
import { md } from "../lib/md";

// SEO-U24 (D-N16): Demand Intelligence moves here from GunSearchEngine.
// Copy is ported word for word from GSE src/app/(site)/demand-intelligence/page.tsx
// (blob 1fd8ae25), including its data-feed wording. Accounts and plans stay on GSE.
const GSE = "https://www.gunsearchengine.com";
const UNMET_HREF = `${GSE}/oem-firearms-demand-analytics#unmet`;
// GSE brand apply flow: the BrandIntelApplyLauncher opens on #demo on this GSE page.
const APPLY_HREF = `${GSE}/betsy/enterprise-copilot#demo`;
const ext = { target: "_blank", rel: "noopener noreferrer" };

const SHARED_INCLUDES = [
  "Full-market anonymized demand (not limited to your brand)",
  "Branded portal dashboard with demand visualization",
  "REST API with secure keys",
  "1 Client Admin free",
  "No shopper emails or session ids in what we send partners",
  "SKU heat, unmet demand, US map, top referrers",
  "Optional weekly insights email (opt-in)",
  "Invite-only onboarding via Coriolis",
] as const;

const USE_CASES = [
  "Decide what to build next from real searches, not last quarter's sell-through",
  "Price and stock what people are actually typing",
  "Write ads and product pages in shopper language",
  "Check if a new load or caliber is getting asked for yet",
  "Catch stockouts and rising calibers early",
] as const;

type Plan = {
  id: "insight" | "growth" | "platform";
  name: string;
  tagline: string;
  badge?: string;
  highlight: boolean;
  bestFor: string;
  features: string[];
  ctaLabel: string;
};

const PLANS: Plan[] = [
  {
    id: "insight",
    name: "Insight",
    tagline: "Full market - what's rising - 30 days",
    highlight: false,
    bestFor:
      "Full market demand for brand managers who don't have a data team.",
    features: [
      "Full-market map of what's rising, unmet demand, UPCs, and where traffic came from",
      "Lookback up to 30 Eastern Time days",
      "Portal dashboard + API",
      "1 free Client Admin - named seats",
      "No session list or bulk export",
      "Optional brand pins for UI highlights",
    ],
    ctaLabel: "Request demo - Insight",
  },
  {
    id: "growth",
    name: "Growth",
    tagline: "Full market - sessions - CSV - 60 days",
    badge: "Most popular",
    highlight: true,
    bestFor:
      "Same market view, plus privacy-safe sessions and CSV when you need to dig.",
    features: [
      "Everything in Insight",
      "Lookback up to 60 Eastern Time days",
      "Privacy-safe sessions list (API + portal)",
      "CSV session export (row-capped)",
      "1 free Client Admin - named seats",
      "Deeper session detail without a full data-team export dump",
    ],
    ctaLabel: "Request demo - Growth",
  },
  {
    id: "platform",
    name: "Platform",
    tagline: "Full access - JSON/CSV - unlimited",
    highlight: false,
    bestFor:
      "Full feed for analysts - export, inventory search when linked, and an assistant hook if you want it.",
    features: [
      "Everything in Growth",
      "Unlimited lookback (saved daily totals)",
      "JSON and CSV export",
      "Connect with Sellers who opt-in",
      "Assistant hook for Grok, Claude, or Cursor (Platform)",
      "1 free Client Admin - named seats",
    ],
    ctaLabel: "Request demo - Platform",
  },
];

const DEPTH = [
  ["Market scope", "Full", "Full", "Full"],
  ["What's rising", "Yes", "Yes", "Yes"],
  ["Max lookback", "30 days", "60 days", "Unlimited"],
  ["Sessions list", "-", "Yes", "Yes"],
  ["Export", "-", "CSV", "JSON + CSV"],
  ["Search-event detail on export", "-", "-", "Yes"],
  ["Assistant hook (Platform)", "-", "-", "Yes"],
  ["Inventory search (linked feeds)", "-", "-", "Yes"],
  ["Free Client Admin", "1", "1", "1"],
] as const;

const btnPrimary =
  "inline-flex items-center justify-center rounded-sm border border-[#8a6a0a] bg-[#c8960c] px-5 py-3 text-sm font-semibold !text-[#05080f] transition hover:bg-[#e0a910]";
const btnGhost =
  "inline-flex items-center justify-center rounded-sm border border-zinc-700 px-5 py-3 text-sm font-medium text-zinc-200 transition hover:bg-zinc-800";
const textLink = linkClass;
const h2Class = "text-xl font-semibold tracking-tight text-white sm:text-2xl";

// CA-VOICE-P1 batch 6 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-6/demand-intelligence.md, shipped as drafted.
const LINKS_RE = /\[([^\]]+)\]\(([^)\s]+)\)/g;
const links = (s: string) => [...s.matchAll(LINKS_RE)].map((m) => ({ text: m[1], href: m[2] }));
const heroCtas = links("[See Unmet Demand](https://www.gunsearchengine.com/oem-firearms-demand-analytics?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=unmet-demand#unmet) · [Request a demo](#demo) · [Ask in Grok](https://www.gunsearchengine.com/betsy/enterprise-copilot?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=enterprise-copilot) · [API](https://www.gunsearchengine.com/docs/enterprise-api?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=enterprise-api) · [Active Defense](https://www.gunsearchengine.com/betsy/active-defense?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=active-defense)");
const demoLink = links("[Tell us what you want to see, and we'll book your demo.](#demo)")[0];
const planCopy = [
  ["**Insight.** Full-market demand for brand managers who don't have a data team: what's rising, unmet demand, UPCs, and where traffic came from, with a lookback of up to 30 Eastern Time days, a portal dashboard and API, and one free Client Admin seat. There is no session list or bulk export. Optional brand pins can highlight labels in the UI.", "[Request demo - Insight](#demo)"],
  ["**Growth.** The same market view, plus privacy-safe sessions and a row-capped CSV export when you need to dig, with a lookback of up to 60 Eastern Time days, and one free Client Admin seat.", "[Request demo - Growth](#demo)"],
  ["**Platform.** The full feed for analysts: everything in Growth, plus unlimited lookback (saved daily totals), JSON and CSV export, inventory search when feeds are linked, a connection to Sellers who opt in, and an assistant hook for Grok, Claude, or Cursor. One free Client Admin seat is included. Setup steps for the assistant hook live in the portal after you're on Platform.", "[Request demo - Platform](#demo)"],
] as const;
const plans = PLANS.map((p, i) => {
  const m = (planCopy[i][0] as string).match(/^\*\*([^*]+?)\.\*\*\s+([\s\S]+)$/);
  if (!m || m[1] !== p.name) throw new Error("plan copy " + p.name);
  return { ...p, body: m[2], ctaLabel: links(planCopy[i][1])[0].text };
});
const depth = [["Capability","Insight","Growth","Platform"],["Market scope","Full","Full","Full"],["What's rising","Yes","Yes","Yes"],["Max lookback","30 days","60 days","Unlimited"],["Sessions list","Not included","Yes","Yes"],["Export","Not included","CSV","JSON + CSV"],["Search-event detail on export","Not included","Not included","Yes"],["Assistant hook (Platform)","Not included","Not included","Yes"],["Inventory search (linked feeds)","Not included","Not included","Yes"],["Free Client Admin","1","1","1"]];
const pilotCtas = links("[See Unmet Demand](https://www.gunsearchengine.com/oem-firearms-demand-analytics?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=unmet-demand-pilot#unmet) · [Request a demo](#demo)");
---

<BaseLayout
  title="Demand Intelligence for Guns & Ammo | Coriolis"
  description="Live firearms search demand across the full market. Dashboard and API from Betsy AI by Coriolis. Insight, Growth, and Platform plans - by lookback, sessions, and export. Invite-only."
  path="/demand-intelligence"
  ogImagePath={CANON_PATHS.ogDefault}
  faq={FAQ_DEMAND_INTELLIGENCE}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">
        Demand Intelligence - Coriolis
      </p>
      <h1 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl">
        Demand Intelligence for Guns & Ammo
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-zinc-300" set:html={md("Demand Intelligence shows what the firearms and ammo market asked for, including searches that came back empty. Coriolis builds it, and Betsy matches what people typed to inventory that exists (and, on Platform, to stock you have linked), so a brand can add a SKU, run another lot, call accounts, or move ad spend. Onboarding is invite-only, through Coriolis.")} />
      <div class="mt-6 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
        {heroCtas.map((c) => c.href === "#demo" ? (
          <a href="#demo" data-cta="subscribe" data-plan="growth" class={btnPrimary}>{c.text}</a>
        ) : (
          <a href={c.href} class={btnGhost} {...ext}>{c.text}</a>
        ))}
      </div>
      <p class="mt-4 text-sm"><a href={demoLink.href} class={textLink} data-cta="subscribe">{demoLink.text}</a></p>
      <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[11px] text-zinc-400">
        <li class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-sky-400"></span>
          <span>Search feedstock</span>
        </li>
        <li class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
          <span>Demand data</span>
        </li>
        <li class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
          <span>Betsy - decisions</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" aria-labelledby="plans-heading" id="plans">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 id="plans-heading" class={`${h2Class} mb-6 sm:text-center`}>{"Choose your plan"}</h2>
      <div class="grid gap-6 sm:gap-8 lg:grid-cols-3 lg:items-stretch">
        {
          plans.map((plan) => (
            <div
              class:list={[
                "relative flex flex-col rounded-2xl bg-zinc-950/60 p-6 sm:p-7",
                plan.highlight ? "border-2 border-gold" : "border border-zinc-800",
              ]}
            >
              {plan.badge ? (
                <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gold px-3 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-ink">
                  {plan.badge}
                </span>
              ) : null}
              <div class="mb-5">
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-gold">
                  {plan.id === "platform" ? "Full access" : "Full market"}
                </p>
                <h3 class="text-xl font-semibold tracking-tight text-white sm:text-2xl">{plan.name}</h3>
              </div>
              <p class="mb-7 flex-1 text-sm leading-relaxed text-zinc-400" set:html={md(plan.body)} />
              <a
                href="#demo"
                class={`mt-auto w-full ${plan.highlight ? btnPrimary : btnGhost}`}
                data-plan={plan.id}
                data-cta="subscribe"
              >
                {plan.ctaLabel}
              </a>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-center text-xs text-zinc-500" set:html={md("Request a demo on any plan. Access to the portal, and to the API keys, comes after that review.")} />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto w-full max-w-2xl space-y-10 px-4 sm:px-6">
      <div class="overflow-x-auto" aria-labelledby="depth-matrix">
        <h2 id="depth-matrix" class={`${h2Class} mb-3`}>{"Depth matrix"}</h2>
        <table class="w-full border-collapse text-left text-sm text-zinc-300">
          <thead>
            <tr class="border-b border-zinc-700 text-xs uppercase tracking-wide text-zinc-500">
              {depth[0].map((h, i) => <th class={i === 0 ? "py-2 pr-3 font-semibold" : i === 3 ? "py-2 pl-2 font-semibold" : "px-2 py-2 font-semibold"}>{h}</th>)}
            </tr>
          </thead>
          <tbody class="text-xs sm:text-sm">
            {
              depth.slice(1).map(([cap, a, b, c]) => (
                <tr class="border-b border-zinc-800">
                  <td class="py-2.5 pr-3 font-medium text-white">{cap}</td>
                  <td class="px-2 py-2.5">{a}</td>
                  <td class="px-2 py-2.5">{b}</td>
                  <td class="py-2.5 pl-2">{c}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div aria-labelledby="both-include">
        <h2 id="both-include" class={`${h2Class} mb-3`}>{"All plans include"}</h2>
        <p class="text-sm leading-relaxed text-zinc-400" set:html={md("Every plan includes full-market anonymized demand, not limited to your brand; a branded portal dashboard; a REST API with secure keys; one free Client Admin seat, with additional named seats purchased through Coriolis during onboarding or expansion; no shopper emails or session ids in what we send partners; SKU heat, unmet demand, a US map, and top referrers; an optional weekly insights email (opt-in); and invite-only onboarding through Coriolis.")} />
      </div>

      <div class="space-y-3" aria-labelledby="use-cases">
        <h2 id="use-cases" class={h2Class}>{"What brands use it for"}</h2>
        <p class="text-sm leading-relaxed text-zinc-400" set:html={md("Brands use it to decide what to build next from real searches, to price and stock what people are actually typing, to write ads and product pages in shopper language, to check whether a new load or caliber is getting asked for yet, and to catch stockouts and rising calibers early.")} />
        <p class="text-sm leading-relaxed text-zinc-400" set:html={md("Already work in Grok, Claude, or Cursor? On Platform, you can ask what's hot and what shoppers couldn't find inside those tools. The [portal setup guide](https://www.gunsearchengine.com/betsy/enterprise-copilot?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=portal-setup) and [REST API docs](https://www.gunsearchengine.com/docs/enterprise-api?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=api-docs) are on GunSearchEngine.com.")} />
      </div>

      <div class="space-y-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 p-5">
        <h2 class="text-base font-semibold text-amber-300">{"Limited pilot opportunity"}</h2>
        <p class="text-sm leading-relaxed text-zinc-300" set:html={md("This is a closed pilot with one major enterprise partner. Early OEM seats are open. First 30 days are free during the pilot window. Pricing is shared during onboarding.")} />
        <div class="flex flex-wrap items-center gap-3">
          {pilotCtas.map((c) => c.href === "#demo" ? (
            <a href="#demo" data-cta="subscribe" data-plan="growth" class={`${textLink} inline-flex text-sm`}>{c.text}</a>
          ) : (
            <a href={c.href} class={btnGhost} data-cta="unmet" {...ext}>{c.text}</a>
          ))}
        </div>
      </div>

      <aside class="rounded-2xl border border-zinc-800 bg-zinc-950/60 p-4" aria-label="Search vs sell-through">
        <p class="text-sm leading-relaxed text-zinc-400" set:html={md("RetailBI reports what sold. Demand Intelligence reports what people asked for. Coriolis is not affiliated with Gearfire or RetailBI. The longer comparison is [what shoppers typed vs what sold](/demand-intelligence-vs-retailbi), and there is also a write-up on [GunSearchEngine.com](https://www.gunsearchengine.com/betsy-vs-retailbi?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=betsy-vs-retailbi).")} />
      </aside>
    </div>
  </section>

  <FaqBlock items={FAQ_DEMAND_INTELLIGENCE} heading={"Questions we get"} />

  <section id="demo" class="border-t border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-2xl px-4 sm:px-6">
      <h2 class={`${h2Class} mb-3`}>{"Tell us about the website you want and we'll make it happen."}</h2>
      <p class="mb-6 text-sm leading-relaxed text-zinc-300" set:html={md("Request a demo on any plan. We capture company, contact, phone, and email, then follow up to schedule a demo, and the portal opens after we review the request.")} />
      <LeadForm site="coriolisagency" defaultPillar="Demand Intelligence" />
      <p class="mt-6 text-sm text-zinc-400" set:html={md("[Request a demo](#demo) · [Start on GunSearchEngine.com](https://www.gunsearchengine.com/betsy/enterprise-copilot?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence&utm_content=gse-demo#demo)")} />
    </div>
  </section>

</BaseLayout>
