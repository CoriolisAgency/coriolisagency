---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_DI_VS_RETAILBI } from "../lib/faq";
import { LINKS, linkClass, btnPlan, btnSecondary } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const three = [
  ["NICS", "FBI background-check counts", "Gun sales"],
  ["RetailBI Index", "New guns sold last month at the same stores as last year", "What people searched for"],
  ["Search intent", "What people searched for - including searches that came back empty", "A sales report"],
] as const;

const vsRows = [
  ["Where the numbers come from", "Guns that sold at the register or online", "What people typed and clicked - including empty searches"],
  ["When you see it", "After the sale", "While they search"],
  ['What "demand" means here', "Units sold (their Index)", "What they typed, including empties"],
  ["How often it updates", "Monthly Index", "Ongoing in the portal and API"],
  ["What it is not", "Not a search tool for shoppers", "Not a register or same-store sales Index"],
] as const;

const monday = [
  [
    "Inventory",
    "What sold last period at stores in their network?",
    "What are people typing that is thin or empty in live stock?",
  ],
  [
    "Production",
    "Which SKUs moved at the register?",
    "Which calibers, loads, and models are getting asked for before the Index prints?",
  ],
  [
    "Sales",
    "Who bought?",
    "What are people searching that you can call accounts about before the monthly print?",
  ],
  [
    "Ads",
    "Which ads matched what sold?",
    "What words should product pages and ads use?",
  ],
  [
    "Forecast",
    "Same-store new-gun trend",
    "What people typed and empty searches the sale never saw",
  ],
] as const;
---

<BaseLayout
  title="Demand Intelligence vs RetailBI: what shoppers typed vs what sold | Coriolis"
  description="Demand Intelligence vs RetailBI: what sold vs what people typed - including empty searches. Not a RetailBI replacement. Coriolis is not affiliated with Gearfire or RetailBI."
  path="/demand-intelligence-vs-retailbi"
  ogImagePath={CANON_PATHS.unmet}
  faq={FAQ_DI_VS_RETAILBI}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">
        Demand Intelligence · Brands and distributors
      </p>
      <h1 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl">
        What shoppers typed vs what sold
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
        RetailBI tells you what sold at the register. Demand Intelligence tells
        you what shoppers typed - including the searches that came back empty.
        Keep the Index. Add the ask. Demand Intelligence is not a RetailBI
        replacement.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Coriolis is not affiliated with Gearfire or RetailBI.
      </p>
      <div class="mt-8 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
        <a href={withBase("contact")} class={btnPlan}>Request a Demand Intelligence demo</a>
        <a href={LINKS.demandIntel} class={btnSecondary} target="_blank" rel="noopener noreferrer"
          >See Unmet Demand</a
        >
      </div>
      <p class="mt-6 max-w-3xl rounded-2xl border border-zinc-800 bg-zinc-950/50 p-5 text-sm leading-relaxed text-zinc-300">
        <strong class="font-semibold text-zinc-100">How is Demand Intelligence different from RetailBI?</strong>{" "}
        RetailBI (Gearfire) tells you what sold - guns that rang at the register
        or checked out online. Their monthly Index tracks new guns sold at the
        same stores as last year. Demand Intelligence (Betsy / Coriolis) tells
        you what people typed when they searched - including searches that came
        back empty. One is what sold. The other is what they asked for. Demand
        Intelligence is <strong class="text-zinc-100">not</strong> a RetailBI
        replacement. We do not sell Gearfire's sales data. NICS background-check
        counts are not gun sales. If you only watch NICS or what sold, you still
        cannot see what people typed before anyone bought - so you guess on
        stock, production, sales calls, ads, and forecasts. Not 4473 software.
        Not NICS. Not your bound book.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        Three numbers. Stop mixing them up.
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        Same three numbers as on{" "}
        <a href={LINKS.fflintel} class={linkClass} target="_blank" rel="noopener noreferrer"
          >FFLintel</a
        >. Checks are not sales. Sold is not "asked for." An empty search is
        real demand that never rang the register.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              <th class="py-3 pr-4 font-medium">Number</th>
              <th class="py-3 pr-4 font-medium">What it is</th>
              <th class="py-3 font-medium">What it is not</th>
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              three.map(([n, is, not]) => (
                <tr class="border-b border-zinc-800/80">
                  <th class="py-3 pr-4 font-medium text-zinc-200">{n}</th>
                  <td class="py-3 pr-4">{is}</td>
                  <td class="py-3">{not}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-2xl text-sm text-zinc-400">
        More detail:{" "}
        <a href={`${LINKS.gse}/nics-vs-firearm-sales`} class={linkClass} target="_blank" rel="noopener noreferrer"
          >NICS vs firearm sales</a
        >
        {" · "}
        <a href={`${LINKS.gse}/retailbi-firearm-sales-index`} class={linkClass} target="_blank" rel="noopener noreferrer"
          >RetailBI Firearm Sales Index</a
        >.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        What RetailBI measures
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Fair, from their public pages: NICS mixes permits, used guns, transfers,
        multi-gun checks, and denials. So their Index - new guns sold at the same
        stores as last year - is a better read on sales than raw NICS. RetailBI
        rolls up what sold across their dealer network for brands. Useful for
        share, category, and inventory planning from real sales. We do not invent
        how many stores report to them. Read their public Index and RetailBI
        pages.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        RetailBI remains the right tool for what sold at the register and
        same-store new-gun performance. Demand Intelligence is not a RetailBI
        replacement.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        What Demand Intelligence measures
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Demand is what people typed. Demand Intelligence pulls anonymized
        searches from GunSearchEngine, GunSearchAgent on dealer sites, and
        related search tools - <strong class="text-zinc-100">including empty searches</strong>. Not a
        register. Not a same-store sales Index. Not 4473, NICS, or bound book.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Plans are public on{" "}
        <a href={withBase(LINKS.demandIntelPage)} class={linkClass}>Demand Intelligence</a>
        {" "}
        (Insight / Growth / Platform - seats $49/user/mo, 1 Client Admin free).
        Coriolis builds Demand Intelligence for brands and distributors. Elsewhere
        we call the AI work{" "}
        <a href={withBase(LINKS.aiStudio)} class={linkClass}>AI Studio</a>.
      </p>

      <h3 class="mt-10 text-lg font-semibold text-white">
        Betsy - our 2A AI
      </h3>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Betsy powers Demand Intelligence. She turns what people typed (and empty
        searches) into moves you can make - add a SKU, run another lot, call
        accounts, move ad spend. Coriolis builds that. We do not invent usage
        stats.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        Demand Intelligence vs RetailBI
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        Side by side. Use both when you need what sold and what people typed.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              <th class="py-3 pr-4 font-medium"> </th>
              <th class="py-3 pr-4 font-medium">RetailBI (Gearfire)</th>
              <th class="py-3 font-medium text-zinc-200">Demand Intelligence (Betsy / Coriolis)</th>
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              vsRows.map(([k, a, b]) => (
                <tr class="border-b border-zinc-800/80">
                  <th class="py-3 pr-4 font-medium text-zinc-300">{k}</th>
                  <td class="py-3 pr-4">{a}</td>
                  <td class="py-3 text-zinc-200">{b}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-2xl text-sm text-zinc-400">
        Longer write-up:{" "}
        <a href={LINKS.betsyVsRetailBi} class={linkClass} target="_blank" rel="noopener noreferrer"
          >RetailBI vs Betsy on GunSearchEngine</a
        >.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        What "what sold" misses on Monday
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        Same jobs as on our{" "}
        <a href={LINKS.oemDemand} class={linkClass} target="_blank" rel="noopener noreferrer"
          >OEM demand page</a
        >. Empty searches and rising terms can show up before the monthly Index
        prints.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              <th class="py-3 pr-4 font-medium">Job</th>
              <th class="py-3 pr-4 font-medium">What sold asks</th>
              <th class="py-3 font-medium text-zinc-200">What they typed asks</th>
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              monday.map(([job, sold, ask]) => (
                <tr class="border-b border-zinc-800/80">
                  <th class="py-3 pr-4 font-medium text-zinc-300">{job}</th>
                  <td class="py-3 pr-4">{sold}</td>
                  <td class="py-3 text-zinc-200">{ask}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        Unmet demand: the empty search
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Unmet = they searched, and nothing in stock matched. The Index cannot see
        a gun that was not on the shelf. Those searches also happen on the dealer
        site -{" "}
        <a href={LINKS.gsa} class={linkClass} target="_blank" rel="noopener noreferrer"
          >GunSearchAgent</a
        >{" "}
        writes them down. Brands who want the full market use Demand Intelligence.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        Who this is for / not for
      </h2>
      <ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 text-sm leading-relaxed text-zinc-300">
        <li>
          <strong class="text-zinc-100">For:</strong> brands and distributors who already watch what sold and
          still need to see what people typed - including empties.
        </li>
        <li>
          <strong class="text-zinc-100">Not for:</strong> someone who only wants a monthly sales Index and will
          never change a SKU or an ad based on searches.
        </li>
        <li>
          <strong class="text-zinc-100">Fair:</strong> RetailBI remains the right tool for what sold at the
          register. We are not asking you to drop it.
        </li>
      </ul>
    </div>
  </section>

  <FaqBlock items={FAQ_DI_VS_RETAILBI} />

  <section class="border-t border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        Keep the Index. Add the ask.
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400">
        Request a Demand Intelligence demo on the Coriolis form. See Unmet Demand
        on the product page. More on the three numbers:{" "}
        <a href={LINKS.fflintel} class={linkClass} target="_blank" rel="noopener noreferrer"
          >fflintel.com</a
        >.
      </p>
      <div class="mt-8 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
        <a href={withBase("contact")} class={btnPlan}>Request a Demand Intelligence demo</a>
        <a href={LINKS.demandIntel} class={btnSecondary} target="_blank" rel="noopener noreferrer"
          >See Unmet Demand</a
        >
        <a href={withBase(LINKS.demandIntelPage)} class={btnSecondary}>Demand Intelligence plans</a>
      </div>
    </div>
  </section>
</BaseLayout>
