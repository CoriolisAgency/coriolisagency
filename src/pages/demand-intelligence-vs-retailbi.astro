---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_DI_VS_RETAILBI } from "../lib/faq";
import { LINKS, linkClass, btnPlan, btnSecondary } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
import { md } from "../lib/md";

// CA-VOICE-P1 batch 6 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-6/demand-intelligence-vs-retailbi.md, shipped as drafted.
const LINKS_RE = /\[([^\]]+)\]\(([^)\s]+)\)/g;
const links = (s: string) => [...s.matchAll(LINKS_RE)].map((m) => ({ text: m[1], href: m[2] }));
const heroCtas = links("[Request a Demand Intelligence demo](/contact) · [See Unmet Demand](https://www.gunsearchengine.com/oem-firearms-demand-analytics?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence-vs-retailbi&utm_content=unmet-demand#unmet)");
const closeCtas = links("[Request a Demand Intelligence demo](/contact) · [See Unmet Demand](https://www.gunsearchengine.com/oem-firearms-demand-analytics?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence-vs-retailbi&utm_content=unmet-demand-footer#unmet) · [Demand Intelligence plans](/demand-intelligence)");
const vsTable = [["Topic","RetailBI (Gearfire), as published (read November 10, 2026)","Demand Intelligence (Coriolis)"],["Where the numbers come from","Point-of-sale and ecommerce transactions; the Index isolates new firearm sales from a selected subset of retailers. ([RetailBI](https://gogearfire.com/solutions/retailbi/))","What people typed and clicked, including empty searches, from GunSearchEngine.com, including dealer sites, and related search tools."],["When you see it","After the sale. Gearfire says RetailBI sales data is updated daily, and the Index is a monthly benchmark. ([RetailBI](https://gogearfire.com/solutions/retailbi/))","While they search, in the portal and API."],["What \"demand\" means here","Units sold, including the monthly same-store new-firearm Index.","What they typed, including empties."],["Published dealer-network size","2,000+, as stated on Gearfire's RetailBI page, read November 10, 2026.","Not listed*"],["Affiliation","A Gearfire product.","Coriolis is not affiliated with Gearfire or RetailBI and does not sell Gearfire's sales data."]];
const ext = { target: "_blank", rel: "noopener noreferrer" };
const isExt = (h: string) => /^https?:/.test(h);

const three = [
  ["NICS", "FBI background-check counts", "Gun sales"],
  ["RetailBI Index", "New guns sold last month at the same stores as last year", "What people searched for"],
  ["Search intent", "What people searched for - including searches that came back empty", "A sales report"],
] as const;

const vsRows = [
  ["Where the numbers come from", "Guns that sold at the register or online", "What people typed and clicked - including empty searches"],
  ["When you see it", "After the sale", "While they search"],
  ['What "demand" means here', "Units sold (their Index)", "What they typed, including empties"],
  ["How often it updates", "Monthly Index", "Ongoing in the portal and API"],
  ["What it is not", "Not a search tool for shoppers", "Not a register or same-store sales Index"],
] as const;

const monday = [
  [
    "Inventory",
    "What sold last period at stores in their network?",
    "What are people typing that is thin or empty in live stock?",
  ],
  [
    "Production",
    "Which SKUs moved at the register?",
    "Which calibers, loads, and models are getting asked for before the Index prints?",
  ],
  [
    "Sales",
    "Who bought?",
    "What are people searching that you can call accounts about before the monthly print?",
  ],
  [
    "Ads",
    "Which ads matched what sold?",
    "What words should product pages and ads use?",
  ],
  [
    "Forecast",
    "Same-store new-gun trend",
    "What people typed and empty searches the sale never saw",
  ],
] as const;
---

<BaseLayout
  title="Demand Intelligence vs RetailBI: what shoppers typed vs what sold | Coriolis"
  description="Demand Intelligence vs RetailBI: what sold vs what people typed - including empty searches. Not a RetailBI replacement. Coriolis is not affiliated with Gearfire or RetailBI."
  path="/demand-intelligence-vs-retailbi"
  ogImagePath={CANON_PATHS.unmet}
  faq={FAQ_DI_VS_RETAILBI}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">
        Demand Intelligence · Brands and distributors
      </p>
      <h1 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl">
        What shoppers typed vs what sold
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md("RetailBI, from Gearfire, reports what sold at the register or checked out online. Demand Intelligence, from Coriolis, reports what shoppers typed, including searches that came back empty. The two numbers answer different questions, and Demand Intelligence is not a RetailBI replacement. Coriolis is not affiliated with Gearfire or RetailBI, and we do not sell Gearfire's sales data.")} />
      <div class="mt-8 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
        {heroCtas.map((c, i) => <a href={c.href} class={i === 0 ? btnPlan : btnSecondary} {...(isExt(c.href) ? ext : {})}>{c.text}</a>)}
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">{"What RetailBI measures, from pages we read November 10, 2026"}</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("Gearfire's [RetailBI page](https://gogearfire.com/solutions/retailbi/) describes RetailBI as a sales and inventory platform built from point-of-sale and ecommerce transactions. On that page, read November 10, 2026, Gearfire says NICS is an unreliable stand-in for new firearm interest because it mixes permit applications, transfers, used sales, denials, and multi-gun transactions, and it presents the RetailBI Firearm Sales Index as a same-store measure of new firearm sales: point-of-sale and ecommerce transactions from a selected subset of retailers, isolated to new firearms, compared with the same period a year earlier and reported as a percentage.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("The same page says RetailBI sales data is updated daily, and that the Index is a monthly benchmark. Gearfire publishes a dealer-network figure of 2,000+; we are restating that published figure, not adding a count of our own. Their earlier Index explainer, [RetailBI Firearm Sales Index](https://gogearfire.com/blog/retailbi-firearm-sales-index/) (dated August 9, 2025, read November 10, 2026), describes the same same-store method and says the Index is published monthly.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("RetailBI remains a tool for what sold at the register and for same-store new-gun performance. We do not write their policy, and this is not a review of their product.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("A short version of the same three numbers also sits on [FFLintel](https://fflintel.com). For more on checks versus sales, see [NICS vs firearm sales](https://www.gunsearchengine.com/nics-vs-firearm-sales?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence-vs-retailbi&utm_content=nics-vs-sales) and [the RetailBI Firearm Sales Index note](https://www.gunsearchengine.com/retailbi-firearm-sales-index?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence-vs-retailbi&utm_content=retailbi-index) on GunSearchEngine.com.")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">{"What Demand Intelligence measures"}</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("Demand is what people typed. Demand Intelligence pulls anonymized searches from GunSearchEngine.com, including searches on dealer sites, and related search tools, and it includes the searches that came back empty. It is not a register, not a same-store sales Index, and not 4473 software, NICS, or a bound book; those stay with the systems licensed for them.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("Coriolis builds Demand Intelligence for brands and distributors. Plans are public on [the Demand Intelligence page](/demand-intelligence) as Insight, Growth, and Platform. Every plan includes one free Client Admin; additional seats are purchased through Coriolis during onboarding. Elsewhere we describe related AI work on [the AI Studio page](/ai-studio).")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("Demand Intelligence turns what people typed, including empty searches, into moves you can make: add a SKU, run another lot, call accounts, or move ad spend. We do not invent usage stats.")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">{"Demand Intelligence vs RetailBI"}</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("Use both when you need what sold and what people typed. A longer write-up also sits on [GunSearchEngine.com](https://www.gunsearchengine.com/betsy-vs-retailbi?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence-vs-retailbi&utm_content=betsy-vs-retailbi).")} />
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[48rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              {vsTable[0].map((h, i) => <th class={i === 2 ? "py-3 font-medium text-zinc-200" : "py-3 pr-4 font-medium"}>{h}</th>)}
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {vsTable.slice(1).map(([k, a, b]) => (
              <tr class="border-b border-zinc-800/80">
                <th class="py-3 pr-4 align-top font-medium text-zinc-300" set:html={md(k)} />
                <td class="py-3 pr-4 align-top" set:html={md(a)} />
                <td class="py-3 align-top text-zinc-200" set:html={md(b)} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 max-w-3xl text-xs leading-relaxed text-zinc-500">{"*Not listed on the source page we read November 10, 2026."}</p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">{"What a sold number cannot show you on Monday"}</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("Empty searches and rising terms can show up before a monthly Index prints. For inventory, production, sales calls, ads, and forecasts, a sold number tells you what moved at stores in a network last period. The typed number tells you what people are searching now, including the queries that found nothing in live stock, and the words product pages and ads should use. The same jobs are spelled out on the [OEM demand page](https://www.gunsearchengine.com/oem-firearms-demand-analytics?utm_source=coriolisagency&utm_medium=referral&utm_campaign=demand-intelligence-vs-retailbi&utm_content=oem-demand).")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("An empty search is unmet demand: they looked, and nothing in stock matched. An Index cannot see a gun that was not on the shelf. Those searches also happen on the dealer site, and GunSearchEngine.com writes them down.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300" set:html={md("This page is for brands and distributors who already watch what sold and still need to see what people typed, including empties. It is not for someone who only wants a monthly sales Index and will never change a SKU or an ad based on searches. RetailBI remains the right tool for what sold at the register. We are not asking you to drop it.")} />
    </div>
  </section>

  <FaqBlock items={FAQ_DI_VS_RETAILBI} heading={"Questions we get"} />

  <section class="border-t border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <div class="flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
        {closeCtas.map((c, i) => <a href={c.href} class={i === 0 ? btnPlan : btnSecondary} {...(isExt(c.href) ? ext : {})}>{c.text}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>
