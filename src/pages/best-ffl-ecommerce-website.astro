---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_BEST } from "../lib/faq";
import { LINKS, linkClass } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const ext = { target: "_blank", rel: "noopener noreferrer" };

const rows = [
  ["You own the website", "No", "No", "Yes — open WooCommerce"],
  ["Monthly (dropshipping rung)", "Usage-priced", "Network-priced", "Militia $269/mo"],
  ["Own inventory + dropship", "Varies", "Yes", "Yes, or either one"],
  ["Distributor catalogs", "Limited set", "Their set", "21 via FFL Cockpit"],
  ["FFL dealer checkout", "Built-in", "Built-in", "FFL Checkout"],
  ["POS", "Their register partner", "The register they already run", "AIM, MicroBiz, Rapid, Trident 1, Corestore"],
  ["AmmoSeek / GunBroker", "Add-on or no", "Limited", "Included on Militia+"],
  ["SEO control", "Theirs", "Theirs", "Yours"],
  ["4473 / bound book", "Sometimes bundled", "Third-party", "Your POS or FastBound — not us"],
] as const;
---

<BaseLayout
  title="Best FFL ecommerce website — WooCommerce vs closed platforms | Coriolis"
  description="The best FFL ecommerce website is the one the dealer owns. AmmoReady and Gearfire rent you a catalog. Coriolis builds WooCommerce on your domain with FFL Cockpit and FFL Checkout."
  path="/best-ffl-ecommerce-website"
  ogImagePath={CANON_PATHS.storefront}
  faq={FAQ_BEST}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        Ecommerce · Comparison
      </p>
      <h1
        class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        Best FFL ecommerce website
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
        The best FFL ecommerce website is the one the dealer owns. AmmoReady
        and Gearfire rent you a catalog. Coriolis builds WooCommerce on your
        domain so you can sell what you stock, dropship from distributor
        catalogs, or do both.{" "}
        <a href={LINKS.fflCockpit} class={linkClass} {...ext}>FFL Cockpit</a>
        {" "}
        handles the feeds.{" "}
        <a href={LINKS.fflCheckout} class={linkClass} {...ext}>FFL Checkout</a>
        {" "}
        handles dealer selection. You can leave with the site.
      </p>
      <div class="mt-8">
        <CtaRow showGsa={false} showAccelerator />
      </div>
      <EcommerceCluster current="best-ffl-ecommerce-website" />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What actually differs</h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        Closed platforms bundle the catalog, the chrome, and the checkout.
        WooCommerce lets you own the store and plug in the parts you need.
        Coriolis is not affiliated with Gearfire or RetailBI.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              <th class="py-3 pr-3 font-medium"> </th>
              <th class="py-3 pr-3 font-medium">AmmoReady</th>
              <th class="py-3 pr-3 font-medium">Gearfire</th>
              <th class="py-3 font-medium text-zinc-200">Coriolis Woo</th>
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              rows.map(([k, a, g, c]) => (
                <tr class="border-b border-zinc-800/80">
                  <th class="py-3 pr-3 font-medium text-zinc-300">{k}</th>
                  <td class="py-3 pr-3">{a}</td>
                  <td class="py-3 pr-3">{g}</td>
                  <td class="py-3 text-zinc-200">{c}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        Hundreds of shops. One template.
      </h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        We opened live AmmoReady and Gearfire Classic dealer sites. The
        inventory changes. The page does not.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        AmmoReady titles follow a formula: shop name, city, ZIP. Homepage and
        category meta descriptions are empty. There is no canonical tag. The
        product H1 is the manufacturer, not the product. Category Open Graph
        images are the same Filestack file across different shops. The chrome,
        the cart, and the age-gate are the same module. Homepage rails are
        platform blocks you pick from, not pages you write.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Gearfire Classic shops share the same nav (Home, Store Policies,
        Firearms News), the same “member of GEARFIRE” footer, and the same
        financing FAQ.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Google does not need another copy of that template. You do not control
        the title tag, the slugs, or the markup. That is what “SEO control:
        theirs” means.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        On owned WooCommerce, the page lives on your domain. You write the H1,
        the about page, the transfer page, and the schema.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <p class="max-w-3xl text-sm text-zinc-400">
        Leaving a closed platform? Start at the{" "}
        <a href={withBase("ammoready-alternative")} class={linkClass}
          >AmmoReady alternative</a
        >
        {" "}
        page, then talk to us about{" "}
        <a href={`${withBase("ecommerce")}#ffl-accelerator`} class={linkClass}
          >FFL Accelerator ($569/mo)</a
        >.
      </p>
      <p class="max-w-3xl text-sm text-zinc-400">
        Switch checklist:{" "}
        <a
          href={`${withBase("ecommerce")}#leave-a-rented-storefront`}
          class={linkClass}>Leave a rented storefront</a
        >.
      </p>
      <CtaRow primary="ecommerce" showGsa={false} showAccelerator />
    </div>
  </section>

  <FaqBlock items={FAQ_BEST} />
</BaseLayout>
