---
/**
 * /ffl-messenger-enterprise
 * Brandy's approved mock. Live header and footer come from BaseLayout.
 * The only CTA is Talk to Coriolis, to /contact?topic=ffl-messenger. No Pro CTA.
 * Not linked from nav, footer, or other pages.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { LINKS } from "../lib/links";
import { withBase } from "../lib/base";
import { GOOGLE_REVIEWS_HREF, GOOGLE_REVIEW_COUNT } from "../lib/google-reviews";
import { FAQ_FFL_MESSENGER_ENTERPRISE } from "../lib/faq";

const ext = { target: "_blank", rel: "noopener noreferrer" };
const contact = `${withBase("contact")}?topic=ffl-messenger`;
---

<BaseLayout
  title="FFL Messenger Pro and Enterprise | Coriolis"
  description="Seats, Tickets, the API, an MCP server and SSO on FFL Messenger, the private network for verified FFLs. Messages, documents and tickets are encrypted."
  path="/ffl-messenger-enterprise"
  faq={FAQ_FFL_MESSENGER_ENTERPRISE}
  extraJsonLd={[
    {
      "@type": "Service",
      name: "FFL Messenger Pro and Enterprise",
      serviceType: "Private messaging for verified FFLs",
      provider: { "@id": `${LINKS.home}/#organization` },
      areaServed: { "@type": "Country", name: "United States" },
    },
  ]}
>
  <section class="field hero" id="hero">
    <div class="wrap">
      <div class="copy">
        <span class="kicker"><i></i>Secure Private Messaging for FFLs</span>
        <h1>FFL Messenger Pro and Enterprise</h1>
        <p class="sub">Put your staff, your reps and your systems on one private, encrypted line.</p>
        <div class="ctas">
          <a class="btn btn-primary" href={contact}>Talk to Coriolis</a>
        </div>
        <div class="trust">
          <span>Verified FFLs only</span>
          <span>No brands, consumers or public feed</span>
          <span>End-to-end encrypted</span>
        </div>
      </div>
      <div class="stage" aria-hidden="true">
        <img class="p p2" src={withBase("fflm/phone-chat.webp")} alt="" width="656" height="1335" />
        <img class="p p1" src={withBase("fflm/phone-inbox.webp")} alt="" width="656" height="1335" />
        <img class="tile" src={withBase("fflm/fflm-tile-white.webp")} alt="" width="512" height="512" />
      </div>
    </div>
  </section>

  <section class="s" id="plans">
    <div class="wrap">
      <div class="s-head">
        <div>
          <span class="eyebrow">Pro and Enterprise</span>
          <h2>Pick the line your shop needs</h2>
        </div>
        <p>Shop to shop messaging stays the same on both. Each tier adds what a bigger team asks for.</p>
      </div>
      <div class="tiers">
        <div class="tier">
          <div class="top"><h3>Pro</h3><span class="tag">For your team</span></div>
          <p class="lead">Bring your employees and your reps onto your shop's private line.</p>
          <ul>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8960c" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>Employee and rep seats</b><small>You invite them. Your business assigns each seat.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8960c" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>Tickets</b><small>Turn a thread into a job your team tracks to done.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8960c" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>Ticket rules</b><small>Fixed routing, auto-assign and escalation.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8960c" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>Staff statuses</b><small>Each person sets available, busy or do not disturb.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8960c" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>Encrypted like every message</b><small>Team threads and tickets are end-to-end encrypted.</small></div>
            </li>
          </ul>
          <div class="foot note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c8960c" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
            <span>Seats, Tickets and rules on your FFL's account.</span>
          </div>
        </div>
        <div class="tier ent">
          <div class="top"><h3>Enterprise</h3><span class="tag">Any FFL that wants it</span></div>
          <p class="lead">Connect FFL Messenger to the systems and tools you already run.</p>
          <p class="plus">Everything in Pro, plus</p>
          <ul>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>API</b><small>Your systems send and read on your line.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>MCP server</b><small>Your own AI tools work with FFL Messenger under the permissions you set.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>SSO</b><small>Your people sign in with your company login.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>Workflow builder</b><small>Build your own rules past the fixed ones.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>Custom work by Coriolis</b><small>We build what your operation needs.</small></div>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2.6" aria-hidden="true"><path d="M5 12.5l4.2 4.2L19 7"></path></svg>
              <div><b>DPAs and SOC 2 readiness</b><small>Pre-planned DPAs and SOC 2 readiness planning, reviewed in scoping.</small></div>
            </li>
          </ul>
          <div class="foot">
            <span>Scoped to how your shops run.</span>
            <a class="btn btn-primary" href={contact}>Talk to Coriolis</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="field band" id="encryption">
    <div class="wrap">
      <div>
        <span class="eyebrow amber">End-to-end encryption</span>
        <p class="quote"><span class="qm">&ldquo;</span>We can't read them and neither can the ATF.<span class="qm">&rdquo;</span></p>
        <p class="under">Your integrations run on your side. A connector calls the API directly and counts as your own connected FFL. The Coriolis cloud integration handles metadata only.</p>
      </div>
      <div class="enc">
        <div class="row">
          <div class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg></div>
          <div><b>Messages</b><span>End-to-end encrypted</span></div>
        </div>
        <div class="row">
          <div class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5"></path></svg></div>
          <div><b>Documents</b><span>End-to-end encrypted</span></div>
        </div>
        <div class="row">
          <div class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2" aria-hidden="true"><path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z"></path></svg></div>
          <div><b>Tickets</b><span>End-to-end encrypted</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="s" id="how">
    <div class="wrap">
      <div class="s-head">
        <div>
          <span class="eyebrow">How it works</span>
          <h2>Four steps to your own line</h2>
        </div>
      </div>
      <div class="steps">
        <div class="step"><div class="n">1</div><b>Talk to Coriolis</b><span>Tell us how your shops run.</span></div>
        <div class="step"><div class="n">2</div><b>Scope it</b><span>We map seats, integrations and the DPA.</span></div>
        <div class="step"><div class="n">3</div><b>Verify each license</b><span>Every license signs up with its FFL number.</span></div>
        <div class="step"><div class="n">4</div><b>Go live</b><span>Your team works the private line.</span></div>
      </div>
    </div>
  </section>

  <section class="s faq" id="faq">
    <div class="wrap">
      <div class="side">
        <span class="eyebrow">Questions</span>
        <h2>Questions FFLs ask</h2>
        <p>Something else? <a href={contact}>Ask Paul</a>.</p>
      </div>
      <div>
        {
          FAQ_FFL_MESSENGER_ENTERPRISE.map((item, i) => (
            <details open={i === 0 ? true : undefined}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="field close" id="contact-cta">
    <div class="wrap">
      <span class="kicker"><i></i>Secure Private Messaging for FFLs</span>
      <h2>Tell us how your shops run</h2>
      <p class="sub">We scope Pro or Enterprise to fit. Paul answers.</p>
      <div class="ctas">
        <a class="btn btn-primary" href={contact}>Talk to Coriolis</a>
      </div>
      <div class="proof">
        <span>100+ clients</span>
        <i class="dot"></i>
        <a href={GOOGLE_REVIEWS_HREF} {...ext}>
          <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 5-star Google rating from {GOOGLE_REVIEW_COUNT} reviews
        </a>
        <i class="dot"></i>
        <span>Member of NSSF, FPC and GOA</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  h1, h2, h3, .quote, .sub, .lead, summary, .tier li small, .step span, .under { text-wrap: balance; }
  p { text-wrap: pretty; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: background-color 0.15s;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    border: 1px solid;
    text-decoration: none;
  }
  .btn-primary {
    background: #c8960c;
    border-color: #8a6a0a;
    color: #05080f !important;
  }
  .btn-primary:hover { background: #e0a910; }
  .btn:focus-visible, summary:focus-visible {
    outline: 2px solid #c8960c;
    outline-offset: 2px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d4d4d8;
    border: 1px solid rgba(228, 230, 231, 0.22);
    background: rgba(14, 15, 16, 0.35);
    border-radius: 999px;
    padding: 6px 12px;
  }
  .kicker i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffb000;
    display: block;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c8960c;
  }
  .eyebrow.amber { color: #ffb000; }

  .field { position: relative; background: linear-gradient(165deg, #34393e 0%, #24282c 55%, #1a1e22 100%); overflow: hidden; }
  .field::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(228, 230, 231, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(228, 230, 231, 0.18) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 80% 90% at 70% 40%, #000 30%, transparent 85%);
    mask-image: radial-gradient(ellipse 80% 90% at 70% 40%, #000 30%, transparent 85%);
    pointer-events: none;
  }
  .field::after {
    content: "";
    position: absolute;
    width: 900px;
    height: 900px;
    right: -120px;
    top: -260px;
    background: radial-gradient(circle, rgba(191, 194, 197, 0.16) 0%, rgba(191, 194, 197, 0) 62%);
    pointer-events: none;
  }
  .field > * { position: relative; z-index: 1; }

  .hero .wrap {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    min-height: 620px;
    padding-top: 56px;
    padding-bottom: 0;
  }
  .hero h1 {
    font-size: 48px;
    line-height: 1;
    font-weight: 600;
    color: #f0f1f2;
    letter-spacing: -0.025em;
    margin: 20px 0 18px;
    text-shadow: 0 0 24px rgba(240, 241, 242, 0.18);
  }
  .hero .sub { font-size: 19px; color: #d4d4d8; max-width: 520px; }
  .hero .ctas { display: flex; gap: 12px; margin: 28px 0 18px; }
  .trust { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: #9f9fa9; }
  .trust span { display: inline-flex; align-items: center; gap: 6px; }
  .trust span::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4b5320;
    box-shadow: 0 0 0 2px rgba(75, 83, 32, 0.35);
  }
  .stage { position: relative; height: 600px; align-self: end; }
  .stage img.p {
    position: absolute;
    bottom: -150px;
    height: auto;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.55));
  }
  .stage .p1 { width: 300px; left: 150px; z-index: 2; }
  .stage .p2 { width: 270px; left: 0; bottom: -190px; transform: rotate(-6deg); opacity: 0.92; }
  .stage .tile {
    position: absolute;
    z-index: 3;
    right: 0;
    top: 64px;
    width: 112px;
    height: 112px;
    border-radius: 24px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  section.s { padding: 64px 0; }
  .s-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 36px;
  }
  .s-head h2, .faq h2 {
    font-size: 30px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: #fff;
    margin-top: 10px;
  }
  .faq h2 { margin-bottom: 12px; }
  .s-head p { color: #9f9fa9; max-width: 420px; font-size: 15px; }

  .tiers { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .tier {
    border: 1px solid #27272a;
    background: rgba(9, 9, 11, 0.6);
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  .tier.ent {
    background: linear-gradient(180deg, #151a20 0%, #0f1318 100%);
    border-color: rgba(255, 176, 0, 0.45);
    box-shadow: 0 0 0 1px rgba(255, 176, 0, 0.12), 0 30px 60px rgba(0, 0, 0, 0.35);
  }
  .tier .top { display: flex; justify-content: space-between; align-items: center; }
  .tier h3 { font-size: 26px; font-weight: 600; color: #fff; }
  .tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid #3f3f46;
    color: #9f9fa9;
  }
  .ent .tag { border-color: rgba(255, 176, 0, 0.5); color: #ffb000; }
  .tier .lead { color: #d4d4d8; margin: 10px 0 22px; font-size: 16px; min-height: 48px; }
  .tier ul { list-style: none; display: grid; gap: 12px; margin: 0 0 28px; padding: 0; }
  .tier li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 10px;
    font-size: 15px;
    color: #e4e4e7;
  }
  .tier li b { color: #fff; font-weight: 600; }
  .tier li small { display: block; color: #9f9fa9; font-size: 13.5px; margin-top: 2px; }
  .tier li svg { margin-top: 3px; }
  .plus {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9f9fa9;
    margin: -6px 0 14px;
  }
  .tier .foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid #27272a;
    padding-top: 22px;
  }
  .tier .foot span { font-size: 13px; color: #71717b; }
  .tier .foot.note {
    justify-content: flex-start;
    gap: 10px;
    min-height: 68px;
  }
  .tier .foot.note svg { flex: none; }
  .tier .foot.note span { font-size: 13.5px; color: #9f9fa9; }
  .ent ul { grid-template-columns: 1fr 1fr; column-gap: 24px; }

  .band { padding: 84px 0; }
  .band .wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: center; }
  .quote {
    font-size: 44px;
    line-height: 1.15;
    font-weight: 600;
    color: #f0f1f2;
    margin-top: 14px;
    text-shadow: 0 0 24px rgba(240, 241, 242, 0.18);
  }
  .quote .qm { color: #ffb000; }
  .band .under { margin-top: 18px; color: #d4d4d8; font-size: 16px; max-width: 560px; }
  .enc { display: grid; gap: 12px; }
  .enc .row {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(14, 15, 16, 0.55);
    border: 1px solid rgba(228, 230, 231, 0.12);
    border-radius: 16px;
    padding: 16px 18px;
  }
  .enc .ico {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(255, 176, 0, 0.12);
    display: grid;
    place-items: center;
    flex: none;
  }
  .enc b { color: #fff; font-weight: 600; display: block; }
  .enc span { font-size: 13.5px; color: #9f9fa9; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step {
    border: 1px solid #27272a;
    background: rgba(9, 9, 11, 0.6);
    border-radius: 16px;
    padding: 22px;
  }
  .step .n {
    font-size: 12px;
    font-weight: 700;
    color: #05080f;
    background: #c8960c;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin-bottom: 14px;
  }
  .step b { display: block; color: #fff; font-size: 17px; font-weight: 600; margin-bottom: 4px; }
  .step span { font-size: 14.5px; color: #9f9fa9; }

  .faq { padding-top: 8px; }
  .faq .wrap { display: grid; grid-template-columns: 360px 1fr; gap: 56px; }
  .faq .side p { color: #9f9fa9; font-size: 15px; }
  .faq .side a { color: #00bcff; font-weight: 500; text-underline-offset: 2px; }
  .faq .side a:hover { text-decoration: underline; }
  details {
    border: 1px solid #27272a;
    background: rgba(9, 9, 11, 0.5);
    border-radius: 16px;
    margin-bottom: 10px;
  }
  details[open] { border-color: #3f3f46; }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    font-weight: 600;
    color: #fff;
    font-size: 16px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "";
    width: 10px;
    height: 10px;
    border-right: 2px solid #9f9fa9;
    border-bottom: 2px solid #9f9fa9;
    transform: rotate(45deg);
    margin-top: -4px;
    flex: none;
  }
  details[open] summary::after { transform: rotate(-135deg); margin-top: 4px; }
  details p { padding: 0 22px 20px; color: #d4d4d8; font-size: 15px; max-width: 680px; }

  .close { padding: 80px 0; }
  .close .wrap { text-align: center; }
  .close h2 {
    font-size: 36px;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: #f0f1f2;
    margin: 18px 0 10px;
    text-shadow: 0 0 24px rgba(240, 241, 242, 0.18);
  }
  .close .sub { color: #d4d4d8; font-size: 17px; }
  .close .ctas { display: flex; gap: 12px; justify-content: center; margin: 28px 0 30px; }
  .proof {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 18px;
    font-size: 13.5px;
    color: #d4d4d8;
    border-top: 1px solid rgba(228, 230, 231, 0.12);
    padding-top: 22px;
  }
  .proof a { color: inherit; }
  .proof a:hover { color: #fff; }
  .proof .stars { color: #fbbc04; letter-spacing: 2px; }
  .proof .dot { width: 4px; height: 4px; border-radius: 50%; background: #71717b; display: inline-block; }

  @media (max-width: 1100px) {
    .hero .wrap { grid-template-columns: 1fr; min-height: 0; }
    .stage { height: 460px; max-width: 560px; margin: 0 auto; width: 100%; }
    .ent ul { grid-template-columns: 1fr; }
