---
/**
 * /ffl-messenger-enterprise
 * Brandy's approved mock. Live header and footer come from BaseLayout.
 * The only CTA is Talk to Coriolis, to /contact?topic=ffl-messenger. No Pro CTA.
 * CA-VOICE-P1 batch 5: linked from the site footer, /about and /ai-studio (FFLM-LINKS.md). Indexable.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { LINKS } from "../lib/links";
import { withBase } from "../lib/base";
import { TRUSTINDEX_REVIEWS_HREF } from "../lib/google-reviews";
import { FAQ_FFL_MESSENGER_ENTERPRISE } from "../lib/faq";

const ext = { target: "_blank", rel: "noopener noreferrer" };
const contact = `${withBase("contact")}?topic=ffl-messenger`;
import { md } from "../lib/md";

// CA-VOICE-P1 batch 5 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-5/ffl-messenger-enterprise.md, shipped as drafted.
const LINKS_RE = /\[([^\]]+)\]\(([^)\s]+)\)/g;
const links = (s: string) => [...s.matchAll(LINKS_RE)].map((m) => ({ text: m[1], href: m[2] }));
const heroCtas = links("[Talk to Coriolis](/contact?topic=ffl-messenger) · [Tell us how your shops run](/contact?topic=ffl-messenger)");
const entCta = links("[Talk to Coriolis](/contact?topic=ffl-messenger)")[0];
const closeCta = links("[Talk to Coriolis](/contact?topic=ffl-messenger)")[0];
const encMatch = ("\"We can't read them, so we have no plaintext to hand anyone.\" That protection covers messages, documents and tickets. Your integrations run on your side. A connector calls the API directly and counts as your own connected FFL. The Coriolis cloud integration handles metadata only." as string).match(/^"([^"]+)"\s+([\s\S]*)$/);
if (!encMatch) throw new Error("encryption quote");
const [, encQuote, encUnder] = encMatch;
const steps = ("1. Talk to Coriolis, and tell us how your shops run. 2. We scope seats, integrations and the DPA. 3. Every license signs up with its FFL number. 4. Your team goes live on the private line." as string).split(/\s*\d+\.\s+/).filter(Boolean);
---

<BaseLayout
  title="FFL Messenger Pro and Enterprise | Coriolis"
  description="Seats, Tickets, the API, an MCP server and SSO on FFL Messenger, the private network for verified FFLs. Messages, documents and tickets are encrypted."
  path="/ffl-messenger-enterprise"
  faq={FAQ_FFL_MESSENGER_ENTERPRISE}
  extraJsonLd={[
    {
      "@type": "Service",
      name: "FFL Messenger Pro and Enterprise",
      serviceType: "Private messaging for verified FFLs",
      provider: { "@id": `${LINKS.home}/#organization` },
      areaServed: { "@type": "Country", name: "United States" },
    },
  ]}
>
  <section class="field hero" id="hero">
    <div class="wrap">
      <div class="copy">
        <span class="kicker"><i></i>Secure Private Messaging for FFLs</span>
        <h1>FFL Messenger Pro and Enterprise</h1>
        <p class="sub" set:html={md("FFL Messenger is a private, end-to-end encrypted line for verified FFLs. Shop-to-shop messaging is the same on Pro and Enterprise. There is no consumer or brand feed, and no public timeline. Each tier then adds what a bigger team asks for: seats and tickets on Pro, and connections to the systems you already run on Enterprise.")} />
        <div class="ctas">
          {heroCtas.map((c) => <a class="btn btn-primary" href={c.href}>{c.text}</a>)}
        </div>
      </div>
      <div class="stage" aria-hidden="true">
        <img class="p p2" src={withBase("fflm/phone-chat.webp")} alt="" width="656" height="1335" />
        <img class="p p1" src={withBase("fflm/phone-inbox.webp")} alt="" width="656" height="1335" />
        <img class="tile" src={withBase("fflm/fflm-tile-white.webp")} alt="" width="512" height="512" />
      </div>
    </div>
  </section>

  <section class="s" id="plans">
    <div class="wrap">
      <div class="s-head">
        <div>
          <span class="eyebrow">Pro and Enterprise</span>
        </div>
      </div>
      <div class="tiers">
        <div class="tier">
          <div class="top"><h2 class="tier-h">{"Pro, for your team"}</h2></div>
          <p class="lead" set:html={md("Pro brings your employees and your reps onto your shop's private line. You invite them, and your business assigns each seat. A thread can become a ticket your team tracks to done, with fixed routing, auto-assign and escalation, and each person can set a status of available, busy or do not disturb. Team threads and tickets use the same end-to-end encryption as every other message on the line.")} />
        </div>
        <div class="tier ent">
          <div class="top"><h2 class="tier-h">{"Enterprise, for any FFL that wants it"}</h2></div>
          <p class="lead" set:html={md("Enterprise is available to any verified FFL that wants it, one counter or many. It includes everything in Pro, then connects FFL Messenger to the systems and tools you already run: an API so your systems can send and read on your line, an MCP server so your own AI tools can work with FFL Messenger under the permissions you set, SSO so your people sign in with your company login, a workflow builder for rules past the fixed ones, and custom work by Coriolis for what your operation needs.")} />
          <p class="lead" set:html={md("DPAs are pre-planned, and you review them during scoping. SOC 2 readiness planning is also part of scoping, and we walk your IT lead through it.")} />
          <div class="foot">
            <a class="btn btn-primary" href={entCta.href}>{entCta.text}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="field band" id="encryption">
    <div class="wrap">
      <div>
        <h2 class="eyebrow amber">{"End-to-end encryption"}</h2>
        <p class="quote"><span class="qm">&ldquo;</span>{encQuote}<span class="qm">&rdquo;</span></p>
        <p class="under" set:html={md(encUnder)} />
      </div>
      <div class="enc">
        <div class="row">
          <div class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg></div>
          <div><b>Messages</b><span>End-to-end encrypted</span></div>
        </div>
        <div class="row">
          <div class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5"></path></svg></div>
          <div><b>Documents</b><span>End-to-end encrypted</span></div>
        </div>
        <div class="row">
          <div class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFB000" stroke-width="2" aria-hidden="true"><path d="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4z"></path></svg></div>
          <div><b>Tickets</b><span>End-to-end encrypted</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="s" id="how">
    <div class="wrap">
      <div class="s-head">
        <div>
          <h2>{"How it works"}</h2>
        </div>
      </div>
      <div class="steps">
        {steps.map((t, i) => <div class="step"><div class="n">{i + 1}</div><span>{t}</span></div>)}
      </div>
    </div>
  </section>

  <section class="s faq" id="faq">
    <div class="wrap">
      <div class="side">
        <span class="eyebrow">Questions</span>
        <h2>{"Questions FFLs ask"}</h2>
        <p set:html={md("Something else? [Ask Paul](/contact?topic=ffl-messenger).")} />
      </div>
      <div>
        {
          FAQ_FFL_MESSENGER_ENTERPRISE.map((item, i) => (
            <details open={i === 0 ? true : undefined}>
              <summary>{item.q}</summary>
              {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="field close" id="contact-cta">
    <div class="wrap">
      <span class="kicker"><i></i>Secure Private Messaging for FFLs</span>
      <h2>{"Tell us about the website you want and we'll make it happen."}</h2>
      <p class="sub" set:html={md("We scope Pro or Enterprise to fit. Paul answers.")} />
      <div class="ctas">
        <a class="btn btn-primary" href={closeCta.href}>{closeCta.text}</a>
      </div>
      <p class="proof" set:html={md("Coriolis has 100+ clients and a [5-star Google rating](https://www.trustindex.io/reviews/coriolisagency.com), and is a member of NSSF, FPC and GOA.")} />
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  h1, h2, h3, .quote, .sub, .lead, summary, .tier li small, .step span, .under { text-wrap: balance; }
  p { text-wrap: pretty; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: background-color 0.15s;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    border: 1px solid;
    text-decoration: none;
  }
  .btn-primary {
    background: #c8960c;
    border-color: #8a6a0a;
    color: #05080f !important;
  }
  .btn-primary:hover { background: #e0a910; }
  .btn:focus-visible, summary:focus-visible {
    outline: 2px solid #c8960c;
    outline-offset: 2px;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d4d4d8;
    border: 1px solid rgba(228, 230, 231, 0.22);
    background: rgba(14, 15, 16, 0.35);
    border-radius: 999px;
    padding: 6px 12px;
  }
  .kicker i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffb000;
    display: block;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c8960c;
  }
  .eyebrow.amber { color: #ffb000; }

  .field { position: relative; background: linear-gradient(165deg, #34393e 0%, #24282c 55%, #1a1e22 100%); overflow: hidden; }
  .field::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(228, 230, 231, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(228, 230, 231, 0.18) 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(ellipse 80% 90% at 70% 40%, #000 30%, transparent 85%);
    mask-image: radial-gradient(ellipse 80% 90% at 70% 40%, #000 30%, transparent 85%);
    pointer-events: none;
  }
  .field::after {
    content: "";
    position: absolute;
    width: 900px;
    height: 900px;
    right: -120px;
    top: -260px;
    background: radial-gradient(circle, rgba(191, 194, 197, 0.16) 0%, rgba(191, 194, 197, 0) 62%);
    pointer-events: none;
  }
  .field > * { position: relative; z-index: 1; }

  .hero .wrap {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
    min-height: 620px;
    padding-top: 56px;
    padding-bottom: 0;
  }
  .hero h1 {
    font-size: 48px;
    line-height: 1;
    font-weight: 600;
    color: #f0f1f2;
    letter-spacing: -0.025em;
    margin: 20px 0 18px;
    text-shadow: 0 0 24px rgba(240, 241, 242, 0.18);
  }
  .hero .sub { font-size: 19px; color: #d4d4d8; max-width: 520px; }
  .hero .ctas { display: flex; gap: 12px; margin: 28px 0 18px; }
  .trust { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: #9f9fa9; }
  .trust span { display: inline-flex; align-items: center; gap: 6px; }
  .trust span::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4b5320;
    box-shadow: 0 0 0 2px rgba(75, 83, 32, 0.35);
  }
  .stage { position: relative; height: 600px; align-self: end; }
  .stage img.p {
    position: absolute;
    bottom: -150px;
    height: auto;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.55));
  }
  .stage .p1 { width: 300px; left: 150px; z-index: 2; }
  .stage .p2 { width: 270px; left: 0; bottom: -190px; transform: rotate(-6deg); opacity: 0.92; }
  .stage .tile {
    position: absolute;
    z-index: 3;
    right: 0;
    top: 64px;
    width: 112px;
    height: 112px;
    border-radius: 24px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  section.s { padding: 64px 0; }
  .s-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 36px;
  }
  .s-head h2, .faq h2 {
    font-size: 30px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: #fff;
    margin-top: 10px;
  }
  .faq h2 { margin-bottom: 12px; }
  .s-head p { color: #9f9fa9; max-width: 420px; font-size: 15px; }

  .tiers { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .tier {
    border: 1px solid #27272a;
    background: rgba(9, 9, 11, 0.6);
    border-radius: 16px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  .tier.ent {
    background: linear-gradient(180deg, #151a20 0%, #0f1318 100%);
    border-color: rgba(255, 176, 0, 0.45);
    box-shadow: 0 0 0 1px rgba(255, 176, 0, 0.12), 0 30px 60px rgba(0, 0, 0, 0.35);
  }
  .tier .top { display: flex; justify-content: space-between; align-items: center; }
  .tier h3, .tier .tier-h { font-size: 26px; font-weight: 600; color: #fff; }
  .tier .lead + .lead { margin-top: 0; }
  .band h2.eyebrow { margin: 0; }
  .proof a { text-decoration: underline; text-underline-offset: 2px; }
  .tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid #3f3f46;
    color: #9f9fa9;
  }
  .ent .tag { border-color: rgba(255, 176, 0, 0.5); color: #ffb000; }
  .tier .lead { color: #d4d4d8; margin: 10px 0 22px; font-size: 16px; min-height: 48px; }
  .tier ul { list-style: none; display: grid; gap: 12px; margin: 0 0 28px; padding: 0; }
  .tier li {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 10px;
    font-size: 15px;
    color: #e4e4e7;
  }
  .tier li b { color: #fff; font-weight: 600; }
  .tier li small { display: block; color: #9f9fa9; font-size: 13.5px; margin-top: 2px; }
  .tier li svg { margin-top: 3px; }
  .plus {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9f9fa9;
    margin: -6px 0 14px;
  }
  .tier .foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid #27272a;
    padding-top: 22px;
  }
  .tier .foot span { font-size: 13px; color: #71717b; }
  .tier .foot.note {
    justify-content: flex-start;
    gap: 10px;
    min-height: 68px;
  }
  .tier .foot.note svg { flex: none; }
  .tier .foot.note span { font-size: 13.5px; color: #9f9fa9; }
  .ent ul { grid-template-columns: 1fr 1fr; column-gap: 24px; }

  .band { padding: 84px 0; }
  .band .wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: center; }
  .quote {
    font-size: 44px;
    line-height: 1.15;
    font-weight: 600;
    color: #f0f1f2;
    margin-top: 14px;
    text-shadow: 0 0 24px rgba(240, 241, 242, 0.18);
  }
  .quote .qm { color: #ffb000; }
  .band .under { margin-top: 18px; color: #d4d4d8; font-size: 16px; max-width: 560px; }
  .enc { display: grid; gap: 12px; }
  .enc .row {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(14, 15, 16, 0.55);
    border: 1px solid rgba(228, 230, 231, 0.12);
    border-radius: 16px;
    padding: 16px 18px;
  }
  .enc .ico {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(255, 176, 0, 0.12);
    display: grid;
    place-items: center;
    flex: none;
  }
  .enc b { color: #fff; font-weight: 600; display: block; }
  .enc span { font-size: 13.5px; color: #9f9fa9; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step {
    border: 1px solid #27272a;
    background: rgba(9, 9, 11, 0.6);
    border-radius: 16px;
    padding: 22px;
  }
  .step .n {
    font-size: 12px;
    font-weight: 700;
    color: #05080f;
    background: #c8960c;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    margin-bottom: 14px;
  }
  .step b { display: block; color: #fff; font-size: 17px; font-weight: 600; margin-bottom: 4px; }
  .step span { font-size: 14.5px; color: #9f9fa9; }

  .faq { padding-top: 8px; }
  .faq .wrap { display: grid; grid-template-columns: 360px 1fr; gap: 56px; }
  .faq .side p { color: #9f9fa9; font-size: 15px; }
  .faq .side a { color: #00bcff; font-weight: 500; text-underline-offset: 2px; }
  .faq .side a:hover { text-decoration: underline; }
  details {
    border: 1px solid #27272a;
    background: rgba(9, 9, 11, 0.5);
    border-radius: 16px;
    margin-bottom: 10px;
  }
  details[open] { border-color: #3f3f46; }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    font-weight: 600;
    color: #fff;
    font-size: 16px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "";
    width: 10px;
    height: 10px;
    border-right: 2px solid #9f9fa9;
    border-bottom: 2px solid #9f9fa9;
    transform: rotate(45deg);
    margin-top: -4px;
    flex: none;
  }
  details[open] summary::after { transform: rotate(-135deg); margin-top: 4px; }
  details p { padding: 0 22px 20px; color: #d4d4d8; font-size: 15px; max-width: 680px; }

  .close { padding: 80px 0; }
  .close .wrap { text-align: center; }
  .close h2 {
    font-size: 36px;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: #f0f1f2;
    margin: 18px 0 10px;
    text-shadow: 0 0 24px rgba(240, 241, 242, 0.18);
  }
  .close .sub { color: #d4d4d8; font-size: 17px; }
  .close .ctas { display: flex; gap: 12px; justify-content: center; margin: 28px 0 30px; }
  .proof {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 18px;
    font-size: 13.5px;
    color: #d4d4d8;
    border-top: 1px solid rgba(228, 230, 231, 0.12);
    padding-top: 22px;
  }
  .proof a { color: inherit; }
  .proof a:hover { color: #fff; }
  .proof .stars { color: #fbbc04; letter-spacing: 2px; }
  .proof .dot { width: 4px; height: 4px; border-radius: 50%; background: #71717b; display: inline-block; }

  @media (max-width: 1100px) {
    .hero .wrap { grid-template-columns: 1fr; min-height: 0; }
    .stage { height: 460px; max-width: 560px; margin: 0 auto; width: 100%; }
    .ent ul { grid-template-columns: 1fr; }
    .band .wrap { grid-template-columns: 1fr; gap: 32px; }
    .steps { grid-template-columns: 1fr 1fr; }
    .faq .wrap { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 820px) {
    .tiers { grid-template-columns: 1fr; }
    .s-head { display: block; }
    .s-head p { margin-top: 10px; }
  }
  @media (max-width: 767px) {
    .wrap { padding: 0 16px; }
    .hero .wrap { padding-top: 36px; gap: 20px; }
    .hero h1 { font-size: 30px; line-height: 1.15; }
    .hero .sub { font-size: 17px; }
    .hero .ctas { flex-direction: column; }
    .hero .ctas .btn { width: 100%; }
    .stage { height: 360px; }
    .stage .p1 { width: 210px; left: auto; right: calc(50% - 150px); bottom: -110px; }
    .stage .p2 { width: 190px; left: calc(50% - 170px); bottom: -140px; }
    .stage .tile { width: 76px; height: 76px; border-radius: 17px; right: auto; left: 4px; top: 18px; }
    section.s { padding: 48px 0; }
    .s-head h2, .faq h2 { font-size: 24px; line-height: 1.33; }
    .tier { padding: 22px; }
    .tier .top { flex-direction: column; align-items: flex-start; gap: 8px; }
    .tier .lead { min-height: 0; }
    .tier .foot { flex-direction: column; align-items: stretch; }
    .tier .foot.note { flex-direction: row; align-items: center; min-height: 0; }
    .tier .foot .btn { width: 100%; }
    .band { padding: 56px 0; }
    .quote { font-size: 30px; }
    .steps { grid-template-columns: 1fr; gap: 10px; }
    .step { display: grid; grid-template-columns: 26px 1fr; gap: 0 14px; padding: 16px; }
    .step .n { grid-row: span 2; margin: 0; }
    .close { padding: 56px 0; }
    .close h2 { font-size: 24px; }
    .close .ctas { flex-direction: column; }
    .close .ctas .btn { width: 100%; }
    .proof { flex-direction: column; gap: 6px; }
    .proof .dot { display: none; }
  }
</style>
