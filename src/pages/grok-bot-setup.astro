---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CANON_PATHS } from "../lib/site";
import { LINKS, linkClass, btnPlan } from "../lib/links";
import { withBase } from "../lib/base";

const ext = { target: "_blank", rel: "noopener noreferrer" };

const jobs = [
  {
    kicker: "Your store",
    title: "Morning counter",
    tone: "teal",
    body: "Last night’s orders and what is on the shelf, waiting when you unlock the door.",
    never: "It does not touch 4473, the bound book, or a POS.",
  },
  {
    kicker: "Betsy on the site",
    title: "Ask Betsy",
    tone: "pink",
    body: "What people searched for versus what you have. Needs Betsy on the site.",
    never: "Free account at GunSearchAgent.com required",
    neverHref: LINKS.gsa,
  },
  {
    kicker: "Your site",
    title: "Send it to Support",
    tone: "orange",
    body: "Tell your Support bot about site problems and it will contact Support for you.",
    never: "It does not change hosting, DNS, or billing.",
  },
] as const;

const connectors = [
  {
    name: "QuickBooks",
    note: "Get instant answers to accounting questions like “What are sales looking like this month?”",
    tone: "lime",
  },
  {
    name: "FastBound",
    note: "Read only. It can tell you what the book says. It never writes a disposition.",
    tone: "sky",
  },
  {
    name: "Facebook",
    note: "Scheduled posts that are already policy-safe. No comments. No ads. No arguing with the timeline.",
    tone: "blue",
  },
] as const;

const jobTone = {
  teal: {
    bar: "from-teal-300 via-teal-400 to-transparent",
    glow: "bg-teal-400/25",
    kicker: "text-teal-300",
    ring: "hover:ring-teal-300/50",
  },
  pink: {
    bar: "from-pink-400 via-fuchsia-400 to-transparent",
    glow: "bg-pink-500/25",
    kicker: "text-pink-300",
    ring: "hover:ring-pink-400/50",
  },
  orange: {
    bar: "from-orange-400 via-amber-400 to-transparent",
    glow: "bg-orange-400/25",
    kicker: "text-orange-300",
    ring: "hover:ring-orange-400/50",
  },
  gold: {
    bar: "from-gold via-amber-200 to-transparent",
    glow: "bg-gold/20",
    kicker: "text-gold",
    ring: "hover:ring-gold/50",
  },
} as const;

const plugTone = {
  lime: {
    chip: "border-lime-400/35 bg-lime-400/10",
    name: "text-lime-300",
  },
  sky: {
    chip: "border-sky-400/35 bg-sky-400/10",
    name: "text-sky-300",
  },
  blue: {
    chip: "border-blue-400/35 bg-blue-400/10",
    name: "text-blue-300",
  },
} as const;
---

<BaseLayout
  title="Grok Bot setup | Coriolis, LLC"
  description="One hour to write your AI strategy. Then we build it and train you. $995. Talk to Coriolis."
  path="/grok-bot-setup"
  ogImagePath={CANON_PATHS.grokBotHero}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        AI Studio
      </p>
      <h1
        class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        Grok Bot setup | Coriolis, LLC
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300 sm:text-lg">
        You do not need another chatbot. In one hour we pick what to automate.
        Then we build it, test it, and show you how to run it. $995. Two meetings.
        Live the same day.
      </p>
      <div class="mt-8">
        <a href={withBase("contact")} class={btnPlan}>Talk to Coriolis</a>
      </div>
      <img
        src={withBase(CANON_PATHS.grokBotHero)}
        alt="Sample Grok Bot app on a gun store counter, roster of Betsy AI, Support, Website, Facebook, and QuickBooks."
        width="1920"
        height="1080"
        class="mt-10 w-full min-w-0 rounded-2xl object-cover ring-1 ring-white/10"
      />

      <div class="mt-10">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold"
        >
          We got you
        </p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
          Grok Bot in the Gun Store
        </h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300 sm:text-base">
          You pick the jobs you want help with in a one-hour consult. We hook
          Grok Bot to the tools you already use. You do not have to host with
          us.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
          {
            jobs.map((job) => {
              const t = jobTone[job.tone];
              return (
                <article
                  class:list={[
                    "group relative overflow-hidden rounded-2xl border border-white/10 bg-[#070c14] p-6 sm:p-7",
                    "ring-1 ring-white/5 shadow-[0_18px_40px_rgba(0,0,0,0.35)] transition duration-300",
                    "hover:-translate-y-0.5",
                    t.ring,
                  ]}
                >
                  <div
                    class:list={[
                      "absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r",
                      t.bar,
                    ]}
                    aria-hidden="true"
                  />
                  <div
                    class:list={[
                      "pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full blur-3xl",
                      t.glow,
                    ]}
                    aria-hidden="true"
                  />
                  <p
                    class:list={[
                      "relative text-[11px] font-semibold uppercase tracking-[0.16em]",
                      t.kicker,
                    ]}
                  >
                    {job.kicker}
                  </p>
                  <h3 class="relative mt-3 text-2xl font-semibold tracking-tight text-white sm:text-[1.7rem]">
                    {job.title}
                  </h3>
                  <p class="relative mt-3 text-sm leading-relaxed text-zinc-200 sm:text-[0.95rem]">
                    {job.body}
                  </p>
                  <p class="relative mt-5 text-sm leading-relaxed text-zinc-400">
                    {"neverHref" in job && job.neverHref ? (
                      <>
                        Free account at{" "}
                        <a href={job.neverHref} class={linkClass} {...ext}>
                          GunSearchAgent.com
                        </a>{" "}
                        required
                      </>
                    ) : (
                      job.never
                    )}
                  </p>
                </article>
              );
            })
          }

          <article
            class:list={[
              "group relative overflow-hidden rounded-2xl border border-white/10 bg-[#070c14] p-6 sm:p-7",
              "ring-1 ring-white/5 shadow-[0_18px_40px_rgba(0,0,0,0.35)] transition duration-300",
              "hover:-translate-y-0.5",
              jobTone.gold.ring,
            ]}
          >
            <div
              class:list={[
                "absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r",
                jobTone.gold.bar,
              ]}
              aria-hidden="true"
            />
            <div
              class:list={[
                "pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full blur-3xl",
                jobTone.gold.glow,
              ]}
              aria-hidden="true"
            />
            <p
              class:list={[
                "relative text-[11px] font-semibold uppercase tracking-[0.16em]",
                jobTone.gold.kicker,
              ]}
            >
              Your tools
            </p>
            <h3 class="relative mt-3 text-2xl font-semibold tracking-tight text-white sm:text-[1.7rem]">
              Tools you already use
            </h3>
            <p class="relative mt-3 text-sm leading-relaxed text-zinc-200 sm:text-[0.95rem]">
              Same day if that is the job. We hook up what you already own. We
              do not sell you the tool.
            </p>
            <ul class="relative mt-5 grid gap-3">
              {
                connectors.map((c) => {
                  const p = plugTone[c.tone];
                  return (
                    <li
                      class:list={[
                        "rounded-xl border px-4 py-3",
                        p.chip,
                      ]}
                    >
                      <p class:list={["text-sm font-semibold", p.name]}>
                        {c.name}
                      </p>
                      <p class="mt-1 text-sm leading-relaxed text-zinc-300">
                        {c.note}
                      </p>
                    </li>
                  );
                })
              }
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        What $995 is
      </h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300 sm:text-base">
        One time. Not a monthly bill from us.
      </p>
      <ol class="mt-6 max-w-3xl space-y-4 text-sm leading-relaxed text-zinc-300 sm:text-base">
        <li>
          <strong class="text-white">One-hour consult.</strong> Your AI
          strategy. What the bot does. What it never does. Who owns it.
        </li>
        <li>
          <strong class="text-white">Same day.</strong> We build the bots, test
          them, and sit with you until you can run them. Two meetings. Live
          before you leave.
        </li>
      </ol>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-zinc-400">
        When we are done, on-demand support. Not 24/7. Not a retainer.
      </p>
      <div class="mt-8">
        <a href={withBase("contact")} class={btnPlan}>Talk to Coriolis</a>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        You buy the login. We set it up.
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Grok Bot lives on a Cursor / xAI seat you buy. Those prices are theirs
        (<a href={LINKS.xaiBot} class={linkClass} {...ext}>x.ai/bot</a>):
      </p>
      <ul class="mt-4 max-w-3xl list-disc space-y-1.5 pl-5 text-sm text-zinc-300">
        <li>Cursor Teams Premium — $120 per seat per month</li>
        <li>Cursor Ultra — $200 per month</li>
        <li>SuperGrok Heavy — $300 per month</li>
      </ul>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Buy one before we meet. Sign in with that account. We configure on your
        seat. We never rent you ours.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        What it will not do
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300 sm:text-base">
        It is not 4473. It is not a POS. FastBound is read only. It never writes
        a disposition. It does not change hosting, DNS, or billing.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">
        We got you
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300 sm:text-base">
        AI will show up in every vendor pitch. We write the plan and hook the
        tools you already pay for.
      </p>
      <div class="mt-8">
        <a href={withBase("contact")} class={btnPlan}>Talk to Coriolis</a>
      </div>
      <p class="mt-10 max-w-3xl text-xs leading-relaxed text-zinc-500">
        Grok Bot is a product of xAI, available through Cursor. Marks of their
        owners. Coriolis, LLC configures on the client’s seat. We are not
        affiliated with xAI or Anysphere beyond that work. Prices for Cursor
        Teams Premium, Cursor Ultra, and SuperGrok Heavy are set by them and
        can change.
      </p>
    </div>
  </section>
</BaseLayout>
