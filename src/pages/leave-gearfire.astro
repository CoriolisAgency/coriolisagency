---
// OPS-3 support page (decision 2026-10-07-seo-ownership, Execute order 2).
// /gearfire-alternative owns the head term. This page answers "how do I
// leave" and links to the owner. It does not repeat the owner's H1.
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import SwitchChecklist from "../components/SwitchChecklist.astro";
import { linkClass } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
import TalkSection from "../components/TalkSection.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_LEAVE_GEARFIRE } from "../lib/faq";
import { md } from "../lib/md";

// CA-VOICE-P1 batch 3 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-3/leave-gearfire.md, shipped as drafted.
const steps = ["Keep your domain. We stand up Woo on it before you give notice.","Map the catalog (own stock, Cockpit feeds, or both) and redirect the URLs that already rank.","Wire FFL Checkout, payments, and taxes. Test a mixed cart.","Connect the register only if you want the floor and the site in sync (Warlord and Accelerator).","Cut DNS. You leave with the site."];
---

<BaseLayout
  faq={FAQ_LEAVE_GEARFIRE}
  title="Leaving Gearfire: the order that keeps you online | Coriolis"
  description="How to leave Gearfire without going dark: keep your domain, stand up WooCommerce before you give notice, redirect the URLs that rank, then cut DNS."
  path="/leave-gearfire"
  ogImagePath={CANON_PATHS.rangeMckinney}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        Ecommerce · Switch guide
      </p>
      <h1
        class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        How to leave Gearfire without going dark
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md("You can leave Gearfire without a day offline if you keep your domain, stand up WooCommerce before you give notice, redirect the pages that rank, test a mixed cart, then switch DNS. Setup is $500 or $2,500, plans run $169 to $569 a month, and there's no annual contract, and we're not affiliated with Gearfire.")} />
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md("The side-by-side of a closed network against a site where you write the titles and the slugs is on [how Coriolis compares with Gearfire](/gearfire-alternative).")} />
      <div class="mt-8">
        <CtaRow talk primary="ecommerce" showGsa={false} showContact />
      </div>
      <EcommerceCluster dropshipLabel="listing distributor catalogs on a store you own" />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"What to finish before you give Gearfire notice, including the domain and the pages that already rank"}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Find out who holds the domain, and if the registrar account is not in your name, fix that first, because everything else depends on it.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("List the pages that bring you traffic: the product, category, and info pages that already rank are the ones to redirect, and Google Search Console shows them.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Decide what you sell: your own stock, distributor catalogs, or both. Own stock is Minute Man, and distributor catalogs through FFL Cockpit start at Militia.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Line up payments, and we install the payment gateway at setup, and the merchant account is yours.")} />
      <p class="mt-4 max-w-3xl text-sm text-zinc-300" set:html={md("Do not give notice until the new store is ready.")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"The five steps that take you off Gearfire and onto a store you own"}</h2>
      <SwitchChecklist steps={steps} />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <h2 class="text-xl font-semibold text-white">{"What the switch costs, without republishing Gearfire's fee card"}</h2>
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Setup is $500 or $2,500, and plans run from Minute Man at $169 a month to FFL Accelerator at $569, with no annual contract. We do not republish Gearfire's fee card, because it is theirs and it changes, so put your current invoice next to the [plan ladder](/ecommerce). What each setup and plan includes is on [the setup and monthly plan prices](/ffl-website-cost).")} />
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("If you're still comparing, read [how Coriolis compares with Gearfire](/gearfire-alternative), and if you're leaving AmmoReady instead, that's [a different guide](/leave-ammoready).")} />
      <CtaRow primary="ecommerce" showGsa={false} showContact />
    </div>
  </section>

  <FaqBlock items={FAQ_LEAVE_GEARFIRE} heading={"The questions dealers ask about leaving Gearfire without going offline"} />

  <TalkSection heading={"Tell us about the website you want and we'll make it happen."} subline={"We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time."} />
</BaseLayout>
