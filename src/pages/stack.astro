---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import FaqBlock from "../components/FaqBlock.astro";
import StackMaps from "../components/StackMaps.astro";
import {
  STACK_ADVANTAGE,
  STACK_EYEBROW,
  STACK_FAQ,
  STACK_H1,
  STACK_LEDE,
  STACK_META,
  STACK_TITLE,
} from "../lib/stack";
---

<BaseLayout
  title={STACK_TITLE}
  description={STACK_META}
  path="/stack"
  faq={STACK_FAQ}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        {STACK_EYEBROW}
      </p>
      <h1
        class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]"
      >
        {STACK_H1}
      </h1>
      {
        STACK_LEDE.map((para) => (
          <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
            {para}
          </p>
        ))
      }
      <div class="mt-8">
        <CtaRow primary="stack" showGsa={false} />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          STACK_ADVANTAGE.map((item) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <h2 class="text-sm font-semibold text-sky-300">{item.head}</h2>
              <p class="mt-3 text-sm leading-relaxed text-zinc-400">
                {item.body}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <StackMaps />

  <FaqBlock items={STACK_FAQ} />
</BaseLayout>
