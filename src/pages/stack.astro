---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import FaqBlock from "../components/FaqBlock.astro";
import StackMaps from "../components/StackMaps.astro";
import {
  STACK_EYEBROW,
  STACK_FAQ,
  STACK_FAQ_TITLE,
  STACK_H1,
  STACK_LEDE,
  STACK_META,
  STACK_STORE,
  STACK_STORE_TITLE,
  STACK_TITLE,
} from "../lib/stack";
import { md } from "../lib/md";
---

<BaseLayout
  title={STACK_TITLE}
  description={STACK_META}
  path="/stack"
  faq={STACK_FAQ}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        {STACK_EYEBROW}
      </p>
      <h1
        class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]"
      >
        {STACK_H1}
      </h1>
      {
        STACK_LEDE.map((para) => (
          <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md(para)} />
        ))
      }
      <div class="mt-8">
        <CtaRow primary="stack" showGsa={false} />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{STACK_STORE_TITLE}</h2>
      {STACK_STORE.map((t) => <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md(t)} />)}
    </div>
  </section>

  <StackMaps />

  <FaqBlock items={STACK_FAQ} heading={STACK_FAQ_TITLE} />
</BaseLayout>
