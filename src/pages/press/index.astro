---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LINKS, linkClass } from "../../lib/links";
import { PRESS_POSTS } from "../../lib/press";
import { CANON_PATHS } from "../../lib/site";
import { withBase } from "../../lib/base";

const posts = [...PRESS_POSTS].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="Press — Coriolis Agency"
  description="Press releases from Coriolis Agency, the managed WooCommerce provider for FFLs. Greenville, SC."
  path="/press"
  ogImagePath={posts[0]?.ogImagePath ?? CANON_PATHS.rangeMckinney}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        Press
      </p>
      <h1
        class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Newsroom
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-300">
        Releases from Coriolis Agency. For media inquiries:{" "}
        <a href={LINKS.contactEmail} class={linkClass}
          >{LINKS.contactEmailAddress}</a
        >.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <ul class="space-y-4">
        {
          posts.map((post) => (
            <li>
              <a
                href={withBase(post.path)}
                class="block rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6 transition hover:border-gold/40"
              >
                <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold">
                  {post.kicker}
                  <span class="text-zinc-500"> · {post.dateLabel}</span>
                </p>
                <h2 class="mt-2 text-lg font-semibold tracking-tight text-white">
                  {post.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-zinc-400">
                  {post.dek}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
