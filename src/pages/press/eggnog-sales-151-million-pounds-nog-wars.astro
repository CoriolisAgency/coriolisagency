---
/**
 * /press/eggnog-sales-151-million-pounds-nog-wars
 * CA-NEWS-EGGNOG (Brandy copy 2026-11-19, /workspace/eggnog/draft.md; Paul 8:55 AM ET Nov 19 via Chief: get it live
 * on CA in the News sections and post to GSE). Cross-post of the GSE news post; the canonical points at the
 * GSE URL (no earlier cross-post precedent). Own page file, same layout, metadata, hero figure and NewsArticle
 * schema as the Radian release. The two Tactical Eggnog Lip Balm links are an intentional RickRoll and carry
 * target="_blank" rel="noopener". Listed on /press and in the sitemap via PRESS_POSTS (standalone: true).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaRow from "../../components/CtaRow.astro";
import { LINKS, linkClass } from "../../lib/links";
import { pressBySlug } from "../../lib/press";
import { CANON_PATHS, SITE, SITE_ORIGIN } from "../../lib/site";
import { withBase } from "../../lib/base";
import { md } from "../../lib/md";

const post = pressBySlug("eggnog-sales-151-million-pounds-nog-wars")!;
const siteOrigin = Astro.site ?? new URL(SITE_ORIGIN);
const pageUrl = new URL(withBase(post.path), siteOrigin).href;
const canonicalUrl = "https://www.gunsearchengine.com/blog/eggnog-sales-151-million-pounds-nog-wars";
const imageUrl = new URL(withBase(post.ogImagePath), siteOrigin).href;
const heroPath = post.heroImagePath ?? post.ogImagePath;
---

<BaseLayout
  title={`${post.title} | Coriolis Agency`}
  description={post.dek}
  path={post.path}
  canonicalUrl={canonicalUrl}
  ogImagePath={post.ogImagePath}
  ogType="article"
  publishedTime={post.date}
  extraJsonLd={[
    {
      "@type": "NewsArticle",
      "@id": `${pageUrl}#article`,
      headline: post.title,
      description: post.dek,
      datePublished: post.date,
      dateModified: post.modified ?? post.date,
      url: pageUrl,
      mainEntityOfPage: canonicalUrl,
      image: imageUrl,
      inLanguage: "en-US",
      author: {
        "@type": "Organization",
        name: SITE.legalName,
        url: LINKS.home,
      },
      publisher: { "@id": `${LINKS.home}/#organization` },
      isPartOf: { "@id": `${pageUrl}#webpage` },
    },
  ]}
>
  <article class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-xs text-zinc-500">
        <a href={withBase("press")} class="hover:text-sky-300">Press</a>
        <span class="px-1.5">/</span>
        News
      </p>
      <p
        class="mt-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        {post.kicker}
      </p>
      <h1
        class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl text-balance"
      >
        {post.title}
      </h1>
      <p class="mt-4 text-sm text-zinc-500">
        {post.dateLabel}
      </p>

      <figure class="mt-8 overflow-hidden rounded-2xl ring-1 ring-white/10">
        <img
          src={withBase(heroPath)}
          alt={post.imageAlt}
          width="1600"
          height="900"
          class="w-full bg-[#111] object-contain"
        />
      </figure>

      <div class="mt-8 space-y-5 text-[1.05rem] leading-relaxed text-zinc-300">
        <blockquote class="border-l-2 border-gold/60 pl-4 text-zinc-200"><p><Fragment set:html={md("**Parody notice:** This post is satire. Apart from USDA's 2025 eggnog sales total, every number, index, chart, confidence interval and finding below is invented, and the GunSearchEngine Institute for Nog Studies does not exist. The accounts named here did not take part in this \"study\" and have not endorsed it; the side each one is filed under comes from its own public posts during the #NogWars.")} /></p></blockquote>

        <p><Fragment set:html={md("USDA's Economic Research Service counted 151.4 million pounds of eggnog sold in the United States in 2025, and the GunSearchEngine Institute for Nog Studies, an independent research body funded entirely by people who like eggnog, has spent the 2026 field season asking what all that nog says about the firearm brands Americans follow on X. Readers who came for guns rather than dairy science can retreat to [GunSearchEngine search](https://www.gunsearchengine.com/search), where the data is real and nobody has been assigned a Nog Index.")} /></p>

        <h2 class="pt-4 text-lg font-semibold text-white">{"Executive summary"}</h2>

        <p><Fragment set:html={md("The Institute finds, at a level of statistical confidence it describes internally as \"overwhelming, honestly,\" that Americans who enjoy eggnog prefer the pro-nog accounts in the annual #NogWars on X, while Americans who refuse eggnog prefer the anti-nog accounts. The effect holds across every subgroup the Institute bothered to measure, survives every robustness check it ran (one), and has been peer reviewed by three peers, two of whom were holding a cup at the time.")} /></p>

        <p><Fragment set:html={md("In keeping with the highest standards of disclosure, the Institute notes that its sponsors, Coriolis and GunSearchEngine, are proudly and permanently pro-nog, and that this position was adopted well before any data was collected, which the methodology section addresses with appropriate seriousness.")} /></p>

        <h2 class="pt-4 text-lg font-semibold text-white">{"Methodology"}</h2>

        <p><Fragment set:html={md("Researchers recruited 1,776 adults who were standing within six feet of a dairy case between Nov. 1 and Nov. 18, 2026, and who did not walk away quickly enough. Each respondent answered a 41-item questionnaire, drank a measured 4-ounce pour of chilled store-bought eggnog under observation, and reported which gun-industry accounts on X they would follow into a holiday argument. Respondents were compensated with one stick of ")} /><a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" class={linkClass} target="_blank" rel="noopener" data-rickroll>Tactical Eggnog Lip Balm</a><Fragment set:html={md(", which the ethics board approved after a brief meeting held mostly in the parking lot.")} /></p>

        <p><Fragment set:html={md("The Institute's primary instrument is the Nog Index, a 0-to-100 score that combines cups consumed per season, a self-rated fondness score, and the number of times the respondent used the phrase \"chicken milk\" during the interview, which is subtracted with prejudice. The resulting scores were weighted by region, age and the respondent's facial expression on the first sip, then rounded to one decimal place so that they would look more scientific.")} /></p>

        <p><Fragment set:html={md("The margin of error for the full sample is plus or minus 0.0004 nogs, a figure the Institute's statistician produced in under a minute and has declined to explain. Every result in this paper is significant at p < 0.00001, two-tailed, with both tails lightly dusted in nutmeg.")} /></p>

        <h2 class="pt-4 text-lg font-semibold text-white">{"Finding 1: The Nog Index by brand affinity"}</h2>

        <p><Fragment set:html={md("The central result of the study is that a respondent's Nog Index predicts, with almost embarrassing precision, which side of the #NogWars they follow. The mean index scores below are invented, as is the confidence interval attached to each one.")} /></p>

        <p><Fragment set:html={md("Table 1. Mean Nog Index by preferred account (illustrative parody data, n = 1,776)")} /></p>

        <ul class="list-disc space-y-2 pl-5 text-base">
          <li><Fragment set:html={md("Coriolis, the study sponsor: 100.0 (recused from analysis, though it insisted on being measured anyway)")} /></li>
          <li><Fragment set:html={md("[@Guns_com](https://x.com/Guns_com), pro-nog: 94.1 (95% CI: 91.0 to 97.2)")} /></li>
          <li><Fragment set:html={md("[@RMADefense](https://x.com/RMADefense), pro-nog: 91.7 (95% CI: 88.6 to 94.8)")} /></li>
          <li><Fragment set:html={md("[@AgesSnark](https://x.com/AgesSnark), pro-nog: 88.3 (95% CI: 85.2 to 91.4)")} /></li>
          <li><Fragment set:html={md("[@rougarouxpew](https://x.com/rougarouxpew), both sides: 50.0 (95% CI: 3.0 to 97.0)")} /></li>
          <li><Fragment set:html={md("[@mnsibley](https://x.com/mnsibley), anti-nog: 8.2 (95% CI: 5.1 to 11.3)")} /></li>
          <li><Fragment set:html={md("[@CharlieCoks](https://x.com/CharlieCoks), anti-nog: 6.6 (95% CI: 3.5 to 9.7)")} /></li>
          <li><Fragment set:html={md("[@BrownellsInc](https://x.com/BrownellsInc), anti-nog as of 2025: 4.9 (95% CI: 1.8 to 8.0)")} /></li>
        </ul>

        <figure class="my-2"><img src={withBase(CANON_PATHS.eggnogChartNogIndex)} alt="Bar chart titled &quot;Nog Index by brand affinity,&quot; labelled illustrative parody data, showing pro-nog accounts near 90, Rougaroux Firearms at exactly 50 with an enormous confidence interval, and anti-nog accounts under 10" width="1600" height="900" loading="lazy" decoding="async" class="h-auto w-full rounded-xl ring-1 ring-white/10" /></figure>

        <p><Fragment set:html={md("The pro-nog cluster reflects the public record. Guns.com spent November telling followers to [stock up on guns, ammo, and nog](https://x.com/Guns_com/status/2123219713140588835), RMA Defense ran an ILOVEEGGNOG coupon code during the 2025 season, and AgesSnark has posted on the side of the nog in 2026, so the Institute was not surprised when respondents who scored above 85 followed all three at rates our analysts called \"suspiciously wholesome.\"")} /></p>

        <p><Fragment set:html={md("The anti-nog cluster is just as tidy. Mnsibley declared the start of the \"Anti-Nog War\" on Oct. 28, 2026, Charlie Coks has posted against the nog this season, and Brownells staged the firing of its social media manager in October 2025 in a bit that put the company on the anti side for that year. The Institute's 2026 reading for Brownells is unverified and has been left blank, pending further posts and a cup of eggnog the Institute is holding for them.")} /></p>

        <p><Fragment set:html={md("Rougaroux Firearms sells both a Pro-Nog and an Anti-Nog magazine, which produced the only perfect 50.0 in the dataset and a confidence interval wide enough to park a truck in. The Institute's economists have described this result as \"commercially astute\" and are not sure it counts as a side.")} /></p>

        <h2 class="pt-4 text-lg font-semibold text-white">{"Finding 2: Disputed and alleged positions"}</h2>

        <p><Fragment set:html={md("Two accounts could not be classified to the Institute's standards, which are low, so they appear in this section instead of Table 1.")} /></p>

        <ul class="list-disc space-y-2 pl-5 text-base">
          <li><Fragment set:html={md("[@palmettoarmory](https://x.com/palmettoarmory): disputed. Palmetto State Armory posted under #NOGWARS2024 and #NOGWARS2025 and once reminded everyone \"where we stand,\" without saying where that was in the text the Institute could read. One Reddit poster has filed the company under anti-nog, and the Institute has filed that claim under \"allegedly.\"")} /></li>
          <li><Fragment set:html={md("[@Kronykal](https://x.com/Kronykal): alleged. A satire post on X appointed him \"Anti-Nog leader,\" a title he has not, to the Institute's knowledge, accepted in writing. His Nog Index is listed as \"pending deposition.\"")} /></li>
        </ul>

        <p><Fragment set:html={md("The Institute would welcome a clarifying statement from either party and has prepared a 4-ounce pour for the occasion.")} /></p>

        <h2 class="pt-4 text-lg font-semibold text-white">{"Finding 3: Consumption predicts allegiance"}</h2>

        <p><Fragment set:html={md("Respondents who reported drinking more cups of eggnog per season were more likely to follow pro-nog accounts, a relationship the Institute modelled with a straight red line that it drew first and checked against the data afterward. The resulting correlation of r = 0.97 is, in the Institute's view, the strongest finding in the history of beverage-based brand research, and the scatter below should be read with that view in mind.")} /></p>

        <figure class="my-2"><img src={withBase(CANON_PATHS.eggnogChartScatter)} alt="Scatter plot titled &quot;Cups of eggnog vs. pro-nog account preference,&quot; labelled illustrative parody data, showing randomly scattered dots with a confident red trend line, an r = 0.97 callout and one excluded outlier marked &quot;likely infiltrator&quot;" width="1600" height="900" loading="lazy" decoding="async" class="h-auto w-full rounded-xl ring-1 ring-white/10" /></figure>

        <p><Fragment set:html={md("Table 2. Selected secondary results (illustrative parody data)")} /></p>

        <ul class="list-disc space-y-2 pl-5 text-base">
          <li><Fragment set:html={md("Respondents with a Nog Index above 80 were 3.4 times as likely to describe their safe as \"festive\" (p = 0.0003).")} /></li>
          <li><Fragment set:html={md("Anti-nog respondents were 61% more likely to answer the question \"Would you like some eggnog?\" with a two-paragraph reply (95% CI: 58% to 64%).")} /></li>
          <li><Fragment set:html={md("One respondent drank 13.6 cups during the field season and still follows the anti-nog side, and the Institute excluded him from the analysis as a probable infiltrator.")} /></li>
          <li><Fragment set:html={md("Respondents who had applied ")} /><a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" class={linkClass} target="_blank" rel="noopener" data-rickroll>Tactical Eggnog Lip Balm</a><Fragment set:html={md(" before the interview reported a 0.0% rate of chapped lips and a 100% rate of wanting more eggnog, a result the Institute considers its cleanest.")} /></li>
        </ul>

        <h2 class="pt-4 text-lg font-semibold text-white">{"Limitations"}</h2>

        <p><Fragment set:html={md("The study has several limitations, which the Institute lists here in the spirit of transparency and then intends to ignore. The sample was drawn entirely from people standing near eggnog, the Nog Index was designed by people who drink eggnog, and the sponsor's position was settled well before the first pour. The Institute also did not measure hot chocolate, which several respondents brought up unprompted and at length, and it has referred those respondents to the anti-nog accounts listed above.")} /></p>

        <h2 class="pt-4 text-lg font-semibold text-white">{"Recommendations"}</h2>

        <p><Fragment set:html={md("On the strength of these findings, the Institute recommends that brands on the anti-nog side reconsider their position before the week of Thanksgiving, when the Institute's own field notes show its staff at their most persuasive. Coriolis and GunSearchEngine remain on the pro-nog side, stocked with nog and ")} /><a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" class={linkClass} target="_blank" rel="noopener" data-rickroll>Tactical Eggnog Lip Balm</a><Fragment set:html={md(", and will release the 2027 Nog Index once the Institute's statistician finishes his cup.")} /></p>

        <p><em><Fragment set:html={md("This post is a parody. The only real figure in it is USDA's 2025 count of 151.4 million pounds of US eggnog sales. All other numbers, charts, indexes and institutes are made up for fun, and the named accounts did not participate in or endorse this post.")} /></em></p>

        <p set:html={md("**Run a gun store? [List it on GunSearchEngine free.](https://www.gunsearchengine.com/for-dealers/feed?utm_source=coriolisagency&utm_medium=referral&utm_campaign=news&utm_content=eggnog-sales-151-million-pounds-nog-wars)** GSE Basic, feed sync included, is free for every FFL.")} />

        <h2 class="pt-4 text-lg font-semibold text-white">Sources</h2>
        <ul class="list-disc space-y-2 pl-5 text-sm">
          <li><a href="https://ers.usda.gov/media/5512/fluid-beverage-milk-sales-quantities-by-product-annual.csv" class={linkClass} target="_blank" rel="noopener noreferrer">USDA Economic Research Service, "Fluid beverage milk sales quantities by product, annual" (CSV, retrieved Nov. 19, 2026) (official, source of the 151.4 million pound figure)</a></li>
          <li><a href="https://x.com/Guns_com/status/2123219713140588835" class={linkClass} target="_blank" rel="noopener noreferrer">Side calls, from the accounts' own public posts on X (no numbers in this post come from these): Guns.com, Nov. 19, 2026</a></li>
          <li><a href="https://x.com/RMADefense/status/1981749686433140832" class={linkClass} target="_blank" rel="noopener noreferrer">RMA Defense ILOVEEGGNOG code, Oct. 24, 2025</a></li>
          <li><a href="https://x.com/AgesSnark/status/2115652526695715085" class={linkClass} target="_blank" rel="noopener noreferrer">AgesSnark, 2026</a></li>
          <li><a href="https://x.com/mnsibley/status/2115538299364507955" class={linkClass} target="_blank" rel="noopener noreferrer">mnsibley, Oct. 28, 2026</a></li>
          <li><a href="https://x.com/CharlieCoks/status/2116332059723792394" class={linkClass} target="_blank" rel="noopener noreferrer">Charlie Coks, 2026</a></li>
          <li><a href="https://x.com/BrownellsInc/status/1981905767209861300" class={linkClass} target="_blank" rel="noopener noreferrer">Brownells, Oct. 25, 2025</a></li>
          <li><a href="https://x.com/rougarouxpew/status/2000188841345364476" class={linkClass} target="_blank" rel="noopener noreferrer">Rougaroux Firearms Pro-Nog and Anti-Nog magazines, Dec. 2025</a></li>
          <li><a href="https://x.com/palmettoarmory/status/1981715922998952367" class={linkClass} target="_blank" rel="noopener noreferrer">Palmetto State Armory, Oct. 24, 2025</a></li>
          <li><a href="https://x.com/Kronykal/status/2115943247247991210" class={linkClass} target="_blank" rel="noopener noreferrer">Kronykal, Oct. 29, 2026</a></li>
        </ul>
      </div>
    </div>
  </article>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <CtaRow primary="contact" />
    </div>
  </section>
</BaseLayout>

<script>
  import { bindRickroll } from "../../scripts/rickroll-modal";
  bindRickroll(document);
</script>
