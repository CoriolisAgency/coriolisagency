---
/**
 * /press/four-firearms-businesses-choose-coriolis-for-custom-woocommerce-stores
 * PRESS-FOUR-CLIENTS (Brandy copy 2026-11-09; Chief 4:06 PM ET, Paul unlock 3:55 PM ET).
 * Own page file (like the UNUM release) because press/[slug].astro carries the
 * five-FFLs body. Same layout, metadata, hero figure and link classes as that post.
 * Listed on /press and in the sitemap via PRESS_POSTS (standalone: true).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaRow from "../../components/CtaRow.astro";
import { LINKS, linkClass } from "../../lib/links";
import { pressBySlug } from "../../lib/press";
import { SITE, SITE_ORIGIN } from "../../lib/site";
import { withBase } from "../../lib/base";
import { md } from "../../lib/md";
// CA-VOICE-P1 batch 7 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-7/press-four-firearms-businesses-choose-coriolis-for-custom-woocommerce-stores.md, shipped as drafted.

const post = pressBySlug("four-firearms-businesses-choose-coriolis-for-custom-woocommerce-stores")!;
const siteOrigin = Astro.site ?? new URL(SITE_ORIGIN);
const pageUrl = new URL(withBase(post.path), siteOrigin).href;
const imageUrl = new URL(withBase(post.ogImagePath), siteOrigin).href;
const ext = { target: "_blank", rel: "noopener noreferrer" };
---

<BaseLayout
  title={`${post.title} | Coriolis Agency`}
  description={post.dek}
  path={post.path}
  ogImagePath={post.ogImagePath}
  ogType="article"
  publishedTime={post.date}
  extraJsonLd={[
    {
      "@type": "NewsArticle",
      "@id": `${pageUrl}#article`,
      headline: post.title,
      description: post.dek,
      datePublished: post.date,
      dateModified: post.modified ?? post.date,
      url: pageUrl,
      image: imageUrl,
      inLanguage: "en-US",
      author: {
        "@type": "Organization",
        name: SITE.legalName,
        url: LINKS.home,
      },
      publisher: { "@id": `${LINKS.home}/#organization` },
      isPartOf: { "@id": `${pageUrl}#webpage` },
    },
  ]}
>
  <article class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-xs text-zinc-500">
        <a href={withBase("press")} class="hover:text-sky-300">Press</a>
        <span class="px-1.5">/</span>
        Release
      </p>
      <p
        class="mt-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        For immediate release
      </p>
      <h1
        class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl text-balance"
      >
        {post.title}
      </h1>
      <p class="mt-4 text-sm text-zinc-500">
        {post.location}, {post.dateLabel}
      </p>

      <figure class="mt-8 overflow-hidden rounded-2xl ring-1 ring-white/10">
        <a href="https://tier1kinetics.com/" {...ext}>
          <img
            src={withBase(post.ogImagePath)}
            alt={post.imageAlt}
            width="1283"
            height="965"
            class="w-full bg-[#111] object-contain"
          />
        </a>
        <figcaption class="px-4 py-2 text-[11px] text-zinc-500">
          Tier 1 Kinetics: Coriolis WooCommerce store.
        </figcaption>
      </figure>

      <div class="mt-8 space-y-5 text-[1.05rem] leading-relaxed text-zinc-300">
        <p set:html={md("Coriolis Agency today announced four new client stores: Tier 1 Kinetics, Jim's Armory, Green Mountain Sporting Goods, and Guardian Guns & Ammo. A rifle maker, a GunTuber, a family outfitter in Vermont, and a New York retailer and training center, each built around how that business actually sells: house rifles, YouTube videos, in-store services, or class seats. Every store runs WooCommerce on the owner's own domain.")} />
        <p set:html={md("All four stores carry FFL Cockpit distributor catalogs and FFL Checkout, so they can [list distributor inventory on a store they own](/firearms-dropshipping). Each site runs on [gun-friendly hosting](/gun-friendly-hosting) on WP Engine and is wired to [GunSearchEngine.com](https://www.gunsearchengine.com/for-dealers/feed?utm_source=coriolisagency&utm_medium=referral&utm_campaign=four-firearms-businesses-choose-coriolis-for-custom-woocommerce-stores&utm_content=for-dealers-feed). There is no annual contract. If a client leaves, the website goes with them.")} />
        <p set:html={md("The four span manufacturing, video, retail, range, and training:")} />
        <ul class="list-disc space-y-3 pl-5">
          {["**Tier 1 Kinetics (Daytona Beach, Fla.):** veteran-owned manufacturer of short AR platforms and premium personal defense weapons, building since 2019. Coriolis built a store that puts the company's own hardware first: the CQB, DMR, Utility, and MAX-8 builds and the T1000 Micro rifle-mounted thermal sight. Behind the house builds sits a full retail catalog of more than 24,000 products, sorted by brand, with a warranty page and an NFA section. [tier1kinetics.com](https://tier1kinetics.com/)", "**Jim's Armory:** the online store behind Jim Grill's [Jim's Armory YouTube channel](https://www.youtube.com/@JimsArmory), where he covers gunsmithing, reloading, training, and gear reviews. Coriolis built the store to work with the channel. Each video gets a blog post on the site, and viewers can shop the categories Jim talks about: 2011 pistols, red dots, reloading, and the Jim's Armory Custom Shop. The catalog runs past 41,000 products, with back-in-stock alerts and [email marketing for the store](/email-marketing-for-ffl-ecommerce) through Mailchimp. [jimsarmory.com](https://jimsarmory.com/)", "**Green Mountain Sporting Goods (Irasburg, Vt.):** family-owned since 1990, with nearly 10,000 square feet of hunting, fishing, archery, and firearms on US Route 5 in the Northeast Kingdom. Coriolis built the site for that ground. It has Hunt Vermont and Fish Vermont pages and a page for each in-house service: gunsmithing, Cerakote, laser engraving, custom builds, suppressor services, LiveScan fingerprinting, and FFL transfers. The store carries more than 49,000 products. [gmsgvt.com](https://gmsgvt.com/)", "**Guardian Guns & Ammo (Deer Park, N.Y.):** high-volume retailer, indoor range, and training center from Guardian Security, a veteran-owned company in business since 2007. Coriolis built two connected WooCommerce sites. The store at [gstny.com](https://gstny.com/) carries more than 39,000 products. The training site runs online class registration on FooEvents: a class calendar, class search, and \"Book ticket\" checkout with live seat counts for New York CCW, armed and unarmed security guard, NRA, and handgun classes. Ranges and instructors shopping for [firearms training websites](/websites-for-ranges-gunsmiths-instructors) can see it working live. Classes: [training.gstny.com](https://training.gstny.com/training/)."].map((t) => <li set:html={md(t)} />)}
        </ul>
        <p set:html={md("Manufacturers, creators, outfitters, ranges, and instructors who want a WooCommerce store built around how they sell can learn more at [CoriolisAgency.com](https://www.coriolisagency.com/).")} />

        <h2 class="pt-4 text-lg font-semibold text-white">{"About Coriolis Agency"}</h2>
        <p set:html={md("Coriolis Agency (Coriolis, LLC) builds, hosts, and supports WooCommerce websites for FFLs, gun stores, shooting ranges, and firearms brands. Founded by Paul Angell, who built and ran AmmoReady.com for nine years, the company delivers managed hosting, AIM POS and other register integrations, automated firearms dropshipping through FFL Cockpit, and demand tools including GunSearchEngine.com. Merchants own their sites. There is no long-term contract. Visit [CoriolisAgency.com](https://www.coriolisagency.com/).")} />

        <h2 class="pt-4 text-lg font-semibold text-white">{"Media Contact"}</h2>
        <p set:html={md("Paul Angell, Founder and CEO, Coriolis Agency, [paul@coriolisagency.com](mailto:paul@coriolisagency.com), Greenville, S.C.")} />
      </div>

      <p class="mt-10 text-xs leading-relaxed text-zinc-600">{"Coriolis does not file a 4473, run NICS, or replace the bound book. We build the website."}</p>
    </div>
  </article>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <CtaRow primary="contact" />
    </div>
  </section>
</BaseLayout>
