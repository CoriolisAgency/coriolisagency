---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaRow from "../../components/CtaRow.astro";
import { LINKS, linkClass } from "../../lib/links";
import { PRESS_POSTS, pressBySlug } from "../../lib/press";
import { SITE } from "../../lib/site";
import { withBase } from "../../lib/base";

export function getStaticPaths() {
  return PRESS_POSTS.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = pressBySlug(slug ?? "");
if (!post) {
  throw new Error(`Unknown press slug: ${slug}`);
}

const siteOrigin = Astro.site ?? new URL("https://coriolisagency.com");
const pageUrl = new URL(withBase(post.path), siteOrigin).href;
const imageUrl = new URL(withBase(post.ogImagePath), siteOrigin).href;
const ext = { target: "_blank", rel: "noopener noreferrer" };
---

<BaseLayout
  title={`${post.title} — Coriolis Agency`}
  description={post.dek}
  path={post.path}
  ogImagePath={post.ogImagePath}
  ogType="article"
  publishedTime={post.date}
  extraJsonLd={[
    {
      "@type": "NewsArticle",
      "@id": `${pageUrl}#article`,
      headline: post.title,
      description: post.dek,
      datePublished: post.date,
      dateModified: post.date,
      url: pageUrl,
      image: imageUrl,
      inLanguage: "en-US",
      author: {
        "@type": "Organization",
        name: SITE.legalName,
        url: LINKS.home,
      },
      publisher: { "@id": `${LINKS.home}/#organization` },
      isPartOf: { "@id": `${pageUrl}#webpage` },
    },
  ]}
>
  <article class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-xs text-zinc-500">
        <a href={withBase("press")} class="hover:text-sky-300">Press</a>
        <span class="px-1.5">/</span>
        Release
      </p>
      <p
        class="mt-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        For immediate release
      </p>
      <h1
        class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl text-balance"
      >
        {post.title}
      </h1>
      <p class="mt-4 text-sm text-zinc-500">
        {post.location} — {post.dateLabel}
      </p>

      <figure class="mt-8 overflow-hidden rounded-2xl ring-1 ring-white/10">
        <a
          href="https://store.therangeinmckinney.com/"
          {...ext}
        >
          <img
            src={withBase(post.ogImagePath)}
            alt={post.imageAlt}
            width="1283"
            height="965"
            class="w-full bg-[#111] object-contain"
          />
        </a>
        <figcaption class="px-4 py-2 text-[11px] text-zinc-500">
          The Range in McKinney — Coriolis WooCommerce storefront.
        </figcaption>
      </figure>

      <div class="mt-8 space-y-5 text-[1.05rem] leading-relaxed text-zinc-300">
        <p>
          Coriolis Agency, the firearms industry’s managed WooCommerce provider
          for Federal Firearms Licensees, today announced that five FFL
          retailers and shooting ranges have selected the agency to integrate
          AIM POS with owned WooCommerce storefronts: Naples Gun Shop, Down
          Range Chico, Lawful Defense, 2A Firearms, and The Range in McKinney.
        </p>
        <p>
          The deployments connect AIM POS — the all-in-one firearms retail
          platform for point of sale, ATF compliance, FastBound electronic A&amp;D
          records, 4473 workflows, gunsmithing, financials, and range
          operations — to Coriolis-built WooCommerce sites. Inventory, orders,
          customers, and compliance data stay synchronized across the sales
          counter, the website, and, where applicable, the range.
        </p>
        <p>
          Each retailer is on Coriolis Agency’s FFL Accelerator managed hosting
          plan. FFL Accelerator includes VIP support and unlimited API bandwidth
          with a 99.95% SLA from WP Engine. Coriolis is a WP Engine agency
          partner. Stores run on the merchant’s own domain, with no annual
          contract. If a dealer leaves, the website goes with them.
        </p>
        <blockquote
          class="border-l-2 border-gold/60 pl-4 text-zinc-200"
        >
          <p>
            “FFL retailers are tired of contracts that lock them into inferior
            solutions and a customer support nightmare,” said Paul Angell,
            Founder and CEO of Coriolis Agency and former CEO of
            AmmoReady.com. “They want a website they actually own, a register
            that talks to the storefront in real time, and a partner who
            answers when something breaks. That is what FFL Accelerator and
            the AIM POS integration are built to deliver.”
          </p>
        </blockquote>
        <p>The five operations span retail, range, training, and NFA work:</p>
        <ul class="list-disc space-y-3 pl-5">
          <li>
            <strong class="text-white">Naples Gun Shop</strong> (Naples, Fla.) —
            local FFL with 300-plus firearms on the floor, a large online
            catalog, silencers, ammunition, training, and less-lethal products.
            <a
              href="https://naplesgunshop.net/"
              class={linkClass}
              {...ext}>naplesgunshop.net</a
            >
          </li>
          <li>
            <strong class="text-white">Down Range Chico</strong> (Chico, Calif.)
            — indoor range and full-line retail store with pistol, rifle, and
            shotgun lanes, training, and gunsmithing.
          </li>
          <li>
            <strong class="text-white">Lawful Defense</strong> (Gainesville,
            Fla.) — guns, gear, and training retailer serving North-Central
            Florida since 2011.
          </li>
          <li>
            <strong class="text-white">2A Firearms</strong> (Lewisville /
            Highland Village, Texas) — USMC veteran-owned dealer offering
            sales, FFL transfers, NFA items, appraisals, and gunsmithing.
          </li>
          <li>
            <strong class="text-white">The Range in McKinney</strong> (McKinney,
            Texas) — indoor range, training center, and online gun store.
            Facility site:{" "}
            <a
              href="https://therangeinmckinney.com/"
              class={linkClass}
              {...ext}>therangeinmckinney.com</a
            >. Store:{" "}
            <a
              href="https://store.therangeinmckinney.com/"
              class={linkClass}
              {...ext}>store.therangeinmckinney.com</a
            >.
          </li>
        </ul>
        <p>
          Coriolis Agency announced its strategic partnership with AIM POS in
          April 2026. Several of the retailers named today were among the first
          to migrate. Lawful Defense and The Range in McKinney join that group
          as additional AIM POS + WooCommerce deployments. FFL Accelerator also
          includes FFL Cockpit distributor catalogs, FFL Checkout, Betsy /
          GunSearchAgent, Cloudflare protection, and managed email automation.
        </p>
        <p>
          FFL dealers using AIM POS who want a WooCommerce store they own can
          learn more at{" "}
          <a href={LINKS.home} class={linkClass}>CoriolisAgency.com</a>
          {" "}and{" "}
          <a href={LINKS.fflaccelerator} class={linkClass} {...ext}
            >FFLAccelerator.com</a
          >.
        </p>

        <h2 class="pt-4 text-lg font-semibold text-white">
          About Coriolis Agency
        </h2>
        <p>
          Coriolis Agency (Coriolis, LLC) builds, hosts, and supports
          WooCommerce websites for FFLs, gun stores, shooting ranges, and
          firearms brands. Founded by Paul Angell, who built and ran
          AmmoReady.com for nine years, the company delivers managed hosting,
          AIM POS and other register integrations, automated firearms
          dropshipping through FFL Cockpit, and demand tools including Betsy AI
          and GunSearchAgent. Merchants own their sites. There is no long-term
          contract. Visit{" "}
          <a href={LINKS.home} class={linkClass}>CoriolisAgency.com</a>.
        </p>

        <h2 class="pt-4 text-lg font-semibold text-white">About AIM POS</h2>
        <p>
          AIM POS is an all-in-one firearms retail platform for FFL dealers and
          shooting ranges. It consolidates point of sale, ATF compliance, bound
          book management, gunsmithing, range operations, and financial
          management in a single native system. Learn more at{" "}
          <a href={LINKS.aimPos} class={linkClass} {...ext}>aim-pos.com</a>.
        </p>

        <h2 class="pt-4 text-lg font-semibold text-white">Media Contact</h2>
        <p>
          Paul Angell<br />
          Founder and CEO, Coriolis Agency<br />
          <a href={LINKS.contactEmail} class={linkClass}
            >{LINKS.contactEmailAddress}</a
          ><br />
          Greenville, S.C.
        </p>
      </div>

      <p class="mt-10 text-xs leading-relaxed text-zinc-600">
        Coriolis does not file a 4473, run NICS, or replace the bound book. AIM
        POS is the register. We build the website. Not affiliated with Gearfire
        or RetailBI.
      </p>
    </div>
  </article>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="mb-4 text-sm text-zinc-400">
        Dealers on AIM POS who want a store they own:
      </p>
      <CtaRow primary="contact" showAccelerator />
    </div>
  </section>
</BaseLayout>
