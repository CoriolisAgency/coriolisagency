---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaRow from "../../components/CtaRow.astro";
import { LINKS, linkClass } from "../../lib/links";
import { PRESS_POSTS, pressBySlug } from "../../lib/press";
import { SITE, SITE_ORIGIN } from "../../lib/site";
import { withBase } from "../../lib/base";
import { md } from "../../lib/md";
// CA-VOICE-P1 batch 7 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-7/press-five-ffls-choose-coriolis-for-aim-pos-integration.md, shipped as drafted.

export function getStaticPaths() {
  return PRESS_POSTS.filter((post) => !post.hidden && !post.standalone).map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = pressBySlug(slug ?? "");
if (!post) {
  throw new Error(`Unknown press slug: ${slug}`);
}

const siteOrigin = Astro.site ?? new URL(SITE_ORIGIN);
const pageUrl = new URL(withBase(post.path), siteOrigin).href;
const imageUrl = new URL(withBase(post.ogImagePath), siteOrigin).href;
const ext = { target: "_blank", rel: "noopener noreferrer" };
---

<BaseLayout
  title={`${post.title} | Coriolis Agency`}
  description={post.dek}
  path={post.path}
  ogImagePath={post.ogImagePath}
  ogType="article"
  publishedTime={post.date}
  extraJsonLd={[
    {
      "@type": "NewsArticle",
      "@id": `${pageUrl}#article`,
      headline: post.title,
      description: post.dek,
      datePublished: post.date,
      dateModified: post.modified ?? post.date,
      url: pageUrl,
      image: imageUrl,
      inLanguage: "en-US",
      author: {
        "@type": "Organization",
        name: SITE.legalName,
        url: LINKS.home,
      },
      publisher: { "@id": `${LINKS.home}/#organization` },
      isPartOf: { "@id": `${pageUrl}#webpage` },
    },
  ]}
>
  <article class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-xs text-zinc-500">
        <a href={withBase("press")} class="hover:text-sky-300">Press</a>
        <span class="px-1.5">/</span>
        Release
      </p>
      <p
        class="mt-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        For immediate release
      </p>
      <h1
        class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl text-balance"
      >
        {post.title}
      </h1>
      <p class="mt-4 text-sm text-zinc-500">
        {post.location}, {post.dateLabel}
      </p>

      <figure class="mt-8 overflow-hidden rounded-2xl ring-1 ring-white/10">
        <a
          href="https://store.therangeinmckinney.com/"
          {...ext}
        >
          <img
            src={withBase(post.ogImagePath)}
            alt={post.imageAlt}
            width="1283"
            height="965"
            class="w-full bg-[#111] object-contain"
          />
        </a>
        <figcaption class="px-4 py-2 text-[11px] text-zinc-500">
          The Range in McKinney: Coriolis WooCommerce storefront.
        </figcaption>
      </figure>

      <div class="mt-8 space-y-5 text-[1.05rem] leading-relaxed text-zinc-300">
        <p set:html={md("Five FFL retailers and shooting ranges have selected Coriolis Agency to connect AIM POS to WooCommerce storefronts they own: Naples Gun Shop, Down Range Chico, Lawful Defense, 2A Firearms, and The Range in McKinney.")} />
        <p set:html={md("The deployments connect AIM POS to those Coriolis-built WooCommerce sites. AIM POS is a firearms retail platform used for point of sale, FastBound electronic A&D records, 4473 workflows, gunsmithing, financials, and range operations. Inventory, orders, and customer records stay synchronized across the sales counter, the website, and, where applicable, the range.")} />
        <p set:html={md("Each retailer is on Coriolis Agency's FFL Accelerator managed hosting plan. FFL Accelerator includes VIP support and unlimited API bandwidth with a 99.95% SLA from WP Engine. Coriolis is a WP Engine agency partner. Stores run on the merchant's own domain, with no annual contract. If a dealer leaves, the website goes with them.")} />
        <blockquote class="border-l-2 border-gold/60 pl-4 text-zinc-200">
          <p set:html={md("“FFL retailers are tired of contracts that lock them into inferior solutions and a customer support nightmare,” said Paul Angell, Founder and CEO of Coriolis Agency and former CEO of AmmoReady.com. “They want a website they actually own, a register that talks to the storefront in real time, and a partner who answers when something breaks. That is what FFL Accelerator and the AIM POS integration are built to deliver.”")} />
        </blockquote>
        <p set:html={md("The five operations span retail, range, training, and NFA work:")} />
        <ul class="list-disc space-y-3 pl-5">
          {["**Naples Gun Shop (Naples, Fla.):** local FFL with 300-plus firearms on the floor, a large online catalog, silencers, ammunition, training, and less-lethal products. [naplesgunshop.net](https://naplesgunshop.net/)", "**Down Range Chico (Chico, Calif.):** indoor range and full-line retail store with pistol, rifle, and shotgun lanes, training, and gunsmithing.", "**Lawful Defense (Gainesville, Fla.):** guns, gear, and training retailer serving North-Central Florida since 2011.", "**2A Firearms (Lewisville / Highland Village, Texas):** USMC veteran-owned dealer offering sales, FFL transfers, NFA items, appraisals, and gunsmithing.", "**The Range in McKinney (McKinney, Texas):** indoor range, training center, and online gun store. Facility site: [therangeinmckinney.com](https://therangeinmckinney.com/). Store: [store.therangeinmckinney.com](https://store.therangeinmckinney.com/)."].map((t) => <li set:html={md(t)} />)}
        </ul>
        <p set:html={md("Coriolis Agency announced its strategic partnership with AIM POS in April 2026. Several of the retailers named today were among the first to migrate. Lawful Defense and The Range in McKinney join that group as additional AIM POS and WooCommerce deployments. FFL Accelerator also includes FFL Cockpit distributor catalogs, FFL Checkout, GunSearchEngine.com, Cloudflare protection, and managed email automation.")} />
        <p set:html={md("FFL dealers using AIM POS who want a WooCommerce store they own can learn more at [CoriolisAgency.com](https://www.coriolisagency.com/) and [FFLAccelerator.com](https://fflaccelerator.com).")} />

        <h2 class="pt-4 text-lg font-semibold text-white">{"About Coriolis Agency"}</h2>
        <p set:html={md("Coriolis Agency (Coriolis, LLC) builds, hosts, and supports WooCommerce websites for FFLs, gun stores, shooting ranges, and firearms brands. Founded by Paul Angell, who built and ran AmmoReady.com for nine years, the company delivers managed hosting, AIM POS and other register integrations, automated firearms dropshipping through FFL Cockpit, and demand tools including GunSearchEngine.com. Merchants own their sites. There is no long-term contract. Visit [CoriolisAgency.com](https://www.coriolisagency.com/).")} />

        <h2 class="pt-4 text-lg font-semibold text-white">{"About AIM POS"}</h2>
        <p set:html={md("AIM POS is a firearms retail platform for FFL dealers and shooting ranges. It consolidates point of sale, bound book management, gunsmithing, range operations, and financial management in a single system. Learn more at [aim-pos.com](https://aim-pos.com).")} />

        <h2 class="pt-4 text-lg font-semibold text-white">{"Media Contact"}</h2>
        <p set:html={md("Paul Angell, Founder and CEO, Coriolis Agency, [paul@coriolisagency.com](mailto:paul@coriolisagency.com), Greenville, S.C.")} />
      </div>

      <p class="mt-10 text-xs leading-relaxed text-zinc-600">{"Coriolis does not file a 4473, run NICS, or replace the bound book. AIM POS is the register. We build the website. Not affiliated with Gearfire or RetailBI."}</p>
    </div>
  </article>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="mb-4 text-sm text-zinc-400">
        Dealers on AIM POS who want a store they own:
      </p>
      <CtaRow primary="contact" showAccelerator />
    </div>
  </section>
</BaseLayout>
