---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import { FROZEN } from "../lib/frozen";
import { LINKS, linkClass } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const ext = { target: "_blank", rel: "noopener noreferrer" };
---

<BaseLayout
  title="About Coriolis, LLC — Greenville, SC"
  description="Coriolis, LLC builds FFL ecommerce, AI products, and Demand Intelligence for OEMs. Greenville, SC."
  path="/about"
  ogImagePath={CANON_PATHS.range}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-[1.2fr_0.8fr]"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          About
        </p>
        <h1
          class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Coriolis, LLC
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-300">
          Three lines of work. Ecommerce for licensed dealers. An AI Studio
          that builds on what we already shipped. Demand Intelligence for the
          brands that need to know what the market asked for — including what
          it could not find.
        </p>
      </div>
      <img
        src={withBase(CANON_PATHS.range)}
        alt="Betsy at the range — built by Coriolis for lawful firearms commerce"
        width="1600"
        height="900"
        class="w-full min-w-0 rounded-2xl object-cover ring-1 ring-white/10"
      />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
          <h2 class="text-sm font-semibold text-sky-300">What we are</h2>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400">
            A company that owns the store, the on-site demand, and the
            intelligence that comes off both. WooCommerce you own. Betsy on
            the domain. Full-market demand for brands.
          </p>
        </article>
        <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
          <h2 class="text-sm font-semibold text-sky-300">What we are not</h2>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400">
            Not 4473 software. Not a NICS system. Not a bound-book replacement.
            Not affiliated with Gearfire or RetailBI. Marks belong to their
            owners.
          </p>
        </article>
        <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
          <h2 class="text-sm font-semibold text-sky-300">The rest of the company</h2>
          <ul class="mt-3 space-y-1.5 text-sm text-zinc-400">
            <li>
              <a href={LINKS.gunStoreGame} class={linkClass} {...ext}
                >GunStoreGame.com</a
              >
              — the game
            </li>
            <li>
              <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a>
              — on the dealer’s site
            </li>
            <li>
              <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>
              — shoppers and Demand Intelligence
            </li>
            <li>
              <a href={LINKS.betsy} class={linkClass} {...ext}>2aBetsy</a>
              — Betsy AI
            </li>
            <li>
              <a href={LINKS.fflaccelerator} class={linkClass} {...ext}
                >FFL Accelerator</a
              >
              — $569 program
            </li>
            <li>
              <a href={LINKS.fflintel} class={linkClass} {...ext}>FFLIntel</a>
              — NICS, sell-through, and search intent
            </li>
          </ul>
        </article>
      </div>
      <p class="mt-8 max-w-3xl text-sm text-zinc-500">
        {FROZEN.fflintel}
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <CtaRow primary="contact" />
    </div>
  </section>
</BaseLayout>
