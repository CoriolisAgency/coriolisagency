---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_DROPSHIP } from "../lib/faq";
import { LINKS, linkClass } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const ext = { target: "_blank", rel: "noopener noreferrer" };

const steps = [
  {
    title: "You list the catalog",
    body: "FFL Cockpit streams distributor inventory and pricing onto your WooCommerce store. MAP holds. Availability updates on a short cycle.",
  },
  {
    title: "The customer checks out",
    body: "Serialized firearms go through FFL Checkout — the buyer picks a receiving dealer. Accessories and ammo follow destination rules.",
  },
  {
    title: "The distributor ships",
    body: "Orders route to the lowest-cost (or fastest) vendor. You never have to stock the SKU. You can still sell what you keep on the shelf.",
  },
] as const;
---

<BaseLayout
  title="Firearms Dropshipping for FFLs — WooCommerce + FFL Cockpit | Coriolis"
  description="Firearms dropshipping lets an FFL sell guns without holding the inventory. Coriolis builds the WooCommerce store, wires FFL Cockpit, and hosts it. Militia $269/mo."
  path="/firearms-dropshipping"
  ogImagePath={CANON_PATHS.rangeMckinney}
  faq={FAQ_DROPSHIP}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div>
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Ecommerce · Dropshipping
        </p>
        <h1
          class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          Firearms dropshipping for FFLs
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
          Firearms dropshipping lets a licensed FFL sell guns, parts, and
          accessories without stocking them. The customer orders on your site.
          The distributor ships to the receiving FFL for transfer. Coriolis
          builds the WooCommerce store, wires{" "}
          <a href={LINKS.fflCockpit} class={linkClass} {...ext}>FFL Cockpit</a>,
          and hosts it — own inventory, dropship, or both.
        </p>
        <div class="mt-8">
          <CtaRow />
        </div>
        <EcommerceCluster current="firearms-dropshipping" />
      </div>
      <a
        href="https://store.therangeinmckinney.com/"
        class="block"
        {...ext}
      >
        <img
          src={withBase(CANON_PATHS.rangeMckinney)}
          alt="The Range in McKinney — a Coriolis FFL store that can sell stock and dropship."
          width="1283"
          height="965"
          class="w-full rounded-2xl object-contain ring-1 ring-white/10 bg-[#111] transition hover:ring-gold/50"
        />
      </a>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">How it works</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {
          steps.map((s) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <h3 class="text-sm font-semibold text-sky-300">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400">{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <h2 class="text-xl font-semibold text-white">Is it legal?</h2>
        <p class="mt-3 text-sm leading-relaxed text-zinc-400">
          Yes, when you hold a valid FFL and follow federal, state, and local
          rules. Serialized firearms ship FFL-to-FFL. You log the transaction
          in the bound book you already use. Coriolis is not 4473 software, not
          a NICS system, and not a bound-book replacement. This is not legal
          advice.
        </p>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-white">Who it is for</h2>
        <p class="mt-3 text-sm leading-relaxed text-zinc-400">
          Home-based Type 01 dealers who need a nationwide aisle. Gun stores
          and ranges that want to sell past the glass case. Brands that want
          dealer sites streaming the same catalogs. Militia ($269/mo) is the
          dropshipping rung — 21 distributors, AmmoSeek feed, GunBroker
          listings.{" "}
          <a href={withBase("ecommerce")} class={linkClass}>See the plans</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <p class="max-w-3xl text-sm text-zinc-400">
        Switching off a closed catalog? Start at the{" "}
        <a href={withBase("ammoready-alternative")} class={linkClass}
          >AmmoReady alternative</a
        >{" "}
        page, then talk to us.
      </p>
      <CtaRow primary="ecommerce" />
    </div>
  </section>

  <FaqBlock items={FAQ_DROPSHIP} />
</BaseLayout>
