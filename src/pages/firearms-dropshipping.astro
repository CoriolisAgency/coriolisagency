---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import TalkSection from "../components/TalkSection.astro";
import { FAQ_DROPSHIP } from "../lib/faq";
import { HOWTO_DROPSHIP } from "../lib/howto";
import { linkClass } from "../lib/links";
import { md } from "../lib/md";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
import { TRUSTINDEX_REVIEWS_HREF } from "../lib/google-reviews";

const ext = { target: "_blank", rel: "noopener noreferrer" };

// CA-VOICE-P1 batch 2 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-2/firearms-dropshipping.md, shipped as drafted.
const card = (s: string) => {
  const m = s.match(/^\*\*(.+?)\*\*\s+([\s\S]*)$/);
  if (!m) throw new Error("card: " + s);
  return { title: m[1].replace(/\.$/, ""), body: m[2] };
};
const intro = "FFL dropshipping lets a licensed dealer sell guns, parts, ammo and accessories without stocking every SKU. You list a wholesale distributor's catalog on your own website, the customer orders from you, and the distributor ships it. Serialized firearms go to the receiving FFL for transfer, and accessories and ammo can ship to the buyer where the destination allows it. That is how a shop sells past the glass case, and how an online-only FFL sells guns online without inventory. Coriolis builds the WooCommerce store on your domain, sets up FFL Cockpit and FFL Checkout, and hosts it.";
const steps = (["**You list the catalog.** [FFL Cockpit](/ffl-cockpit) streams distributor inventory and pricing onto your WooCommerce store. MAP holds. Inventory updates every 20 minutes on Militia and above.","**The customer checks out.** Serialized firearms go through FFL Checkout, and the buyer picks a receiving dealer. Accessories and ammo follow the rules for where they're going.","**The distributor ships.** Orders route to the lowest-cost or fastest vendor. You never stock that SKU. The gun goes FFL to FFL."] as string[]).map(card);
const distTable = [["Distributor","Dealer account","Firearms ship to","Accessories and ammo ship to"],["Sports South","You open your own dealer account","The receiving FFL","The distributor's rule, confirmed at setup"],["RSR","You open your own dealer account","The receiving FFL","The distributor's rule, confirmed at setup"],["Zanders","You open your own dealer account","The receiving FFL","The distributor's rule, confirmed at setup"]];
const costTable = [["Option","Listed price","What the price covers","Source"],["Gearfire eCommerce Pro","$249/mo","Gearfire's hosted ecommerce platform. Firearm dropshipping is on Pro, not Essentials.","[gogearfire.com/solutions/ecommerce](https://gogearfire.com/solutions/ecommerce/), Nov 10, 2026"],["FFL Cockpit Premium for WooCommerce","$84.99/mo","The plugin, with FFL Checkout included. Your own hosting and website build cost extra.","[fflcockpit.com/pricing](https://www.fflcockpit.com/pricing/), Nov 10, 2026"],["Coriolis Militia","$269/mo","FFL Cockpit and FFL Checkout licenses, 21 distributor catalogs, and hosting on WP Engine. Setup is $500 or $2,500.","[FFL ecommerce plans](/ecommerce), Nov 10, 2026"]];
const startSteps = ["Get your FFL and your premises squared away with the ATF and your attorney. We don't give legal advice.","Open dealer accounts with the distributors you want to sell from.","Get a merchant account approved for firearms. See [FFL payment processing](/ffl-payment-processing).","We build WooCommerce on your domain and turn on the catalogs.","Set your margins. MAP holds where the feed carries it.","Buy a mixed cart yourself and make sure it clears.","Go live."];

const p = "mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400";
const th = "py-3 pr-3 font-medium";
const td = "py-3 pr-3 align-top";
---

<BaseLayout
  title="FFL Dropshipping and Wholesale for Gun Stores | Coriolis"
  description="FFL dropshipping for licensed gun stores. List wholesale catalogs, sell without stocking every SKU, and ship firearms FFL to FFL."
  path="/firearms-dropshipping"
  ogImagePath={CANON_PATHS.rangeMckinney}
  faq={FAQ_DROPSHIP}
  extraJsonLd={[HOWTO_DROPSHIP]}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Ecommerce · Dropshipping
        </p>
        <h1
          class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          FFL Dropshipping: firearms dropshipping for gun stores
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md(intro)} />
        <p class="mt-4 text-sm text-zinc-400" set:html={md("Coriolis has 100+ clients and a [5-star Google rating](https://www.trustindex.io/reviews/coriolisagency.com), and is a member of NSSF, FPC and GOA.")} />
        <div class="mt-8">
          <CtaRow talk showGsa={false} showAccelerator />
        </div>
        <EcommerceCluster current="firearms-dropshipping" />
      </div>
      <img
        src={withBase(CANON_PATHS.rangeMckinney)}
        alt="A Coriolis FFL store that can sell stock and dropship."
        width="1283"
        height="965"
        class="w-full min-w-0 rounded-2xl object-contain ring-1 ring-white/10 bg-[#111]"
      />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"How FFL dropshipping works, in three steps, including what you already stock"}</h2>
      <p class={p} set:html={md("FFL dropshipping runs in three steps, and you can still sell what you keep on the shelf.")} />
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          steps.map((s) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <h3 class="text-sm font-semibold text-sky-300">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400" set:html={md(s.body)} />
            </article>
          ))
        }
      </div>
      <p class={p} set:html={md("Not everything needs a transfer: optics, magazines, holsters, parts and most gun accessories can dropship from the wholesale distributor to the buyer's door, and ammo can too, where the destination allows it.")} />
      <p class={p} set:html={md("FFL Checkout takes a mixed cart in one order: the firearm routes to the dealer the buyer picks, and state shipping limits show at checkout with your own message, so a buyer sees them before they pay. Rules change by state and city, and the store follows them at checkout, and this is not legal advice.")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Distributor catalogs included on Militia and above, as of November 2026"}</h2>
      <p class={p} set:html={md("Militia and above include an FFL Cockpit license and 21 distributor catalogs, and we add them at setup; typical starting points are Sports South, RSR and Zanders.")} />
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              {distTable[0].map((h) => <th class="py-3 pr-4 font-medium">{h}</th>)}
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {distTable.slice(1).map((r) => (
              <tr class="border-b border-zinc-800/80">
                {r.map((c, i) => i === 0 ? <th class="py-3 pr-4 align-top font-medium text-zinc-300" set:html={md(c)} /> : <td class="py-3 pr-4 align-top" set:html={md(c)} />)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class={p} set:html={md("You need an account with each house you sell from. What ships where is each distributor's rule, and we confirm it with you at setup, while availability and MAP come from each feed.")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"What dropshipping costs, with list prices read November 10, 2026"}</h2>
      <p class={p} set:html={md("List prices from each company's own page, read November 10, 2026. Prices change, and card processing is separate on all three.")} />
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[48rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              {costTable[0].map((h) => <th class="py-3 pr-4 font-medium">{h}</th>)}
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {costTable.slice(1).map((r) => (
              <tr class="border-b border-zinc-800/80">
                {r.map((c, i) => i === 0 ? <th class="py-3 pr-4 align-top font-medium text-zinc-300" set:html={md(c)} /> : <td class="py-3 pr-4 align-top" set:html={md(c)} />)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class={p} set:html={md("If you're comparing more options, see the [FFL ecommerce platform guide](/best-ffl-ecommerce-website).")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="home-based-ffl">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Starting an online-only or home-based FFL store, in this order"}</h2>
      <p class={p} set:html={md("You don't need a retail floor to sell online, but you do need a valid FFL, and we work in this order.")} />
      <ol class="mt-4 max-w-3xl list-decimal space-y-2 pl-5 text-sm leading-relaxed text-zinc-400">
        {startSteps.map((s) => <li set:html={md(s)} />)}
      </ol>
      <p class={p} set:html={md("Dropshipping can run without a storefront, but you still need a valid FFL and you still follow the rules for your premises. We don't publish a zoning or HOA checklist, a first-90-days timeline, or margin math, so talk to your attorney and the ATF about premises rules; this is not legal advice.")} />
      <p class={p} set:html={md("Yes, this work can be legal when you hold a valid FFL and follow federal, state and local rules. Serialized firearms ship FFL to FFL, and you log the transaction in the bound book you already use. Coriolis doesn't run 4473s, NICS or your bound book, and this is not legal advice.")} />
      <p class={p} set:html={md("If you want the whole store, see [FFL website design](/ecommerce). If you need hosting that allows a gun store, see [hosting that allows a gun store](/gun-friendly-hosting). If you're leaving a closed catalog, start with [how Coriolis compares with AmmoReady](/ammoready-alternative) or [how Coriolis compares with Gearfire](/gearfire-alternative).")} />
      <div class="mt-6">
        <CtaRow primary="ecommerce" showGsa={false} showAccelerator />
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_DROPSHIP} heading={"The questions dealers ask about FFL dropshipping on a store they own"} />

  <TalkSection heading={"Tell us about the website you want and we'll make it happen."} subline={"We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time."} contact={"You can also reach us at [(279) 258-6771](tel:+12792586771) or [support@coriolisagency.com](mailto:support@coriolisagency.com)."} />
</BaseLayout>
