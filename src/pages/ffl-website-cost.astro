---
// OPS-3 support page (decision 2026-10-07-seo-ownership, Execute order 2).
// /ecommerce owns the plan ladder and "ffl website pricing / plans". This page
// answers "what does it cost" and links to /ecommerce. It does not repeat the
// owner's H1 and does not publish AmmoReady or Gearfire prices. Prices come
// from src/lib/plans.ts so the two pages cannot drift.
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import { LINKS, linkClass } from "../lib/links";
import { PLANS, SETUP, type PlanId } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const usd = (n: number) => `$${n.toLocaleString("en-US")}`;

const adds: Record<PlanId, string> = {
  "minute-man":
    "The website: custom design on your domain, unlimited hosting, products, and orders. Backed by WP Engine's 99.95% uptime SLA.",
  militia:
    "Dropshipping: FFL Cockpit and FFL Checkout licenses, 21 distributor catalogs, marketplace feeds.",
  "gun-runner":
    "VIP support: DNS and email administration, one-hour email and chat response.",
  warlord:
    "POS integration: two-way API sync with any POS that works with WooCommerce.",
  "ffl-accelerator":
    "Webmaster included: email automation and GunSearchEngine.com Pro.",
};

const setupNote: Record<(typeof SETUP)[number]["id"], string> = {
  basic: "A clean launch. Additional custom pages are $125 each.",
  retail: "The full custom site and email, up to ten custom pages.",
};

const low = PLANS[0];
const high = PLANS[PLANS.length - 1];
const [basic, retail] = SETUP;
import TalkSection from "../components/TalkSection.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_COST } from "../lib/faq";
import { md } from "../lib/md";

// CA-VOICE-P1 batch 2 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-2/ffl-website-cost.md, shipped as drafted.
const setupTable = [["Setup","Price","What you get"],["Basic Setup","$500","A clean launch. Additional custom pages are $125 each."],["Retail Setup","$2,500","The full custom site and email, up to ten custom pages."]];
const planTable = [["Plan","Per month","What it adds"],["Minute Man","$169","The website: custom design on your domain, unlimited hosting, products, and orders. Backed by WP Engine's 99.95% uptime SLA."],["Militia","$269","Dropshipping: FFL Cockpit and FFL Checkout licenses, 21 distributor catalogs, marketplace feeds."],["Gun Runner","$369","VIP support: DNS and email administration, one-hour email and chat response."],["Warlord","$469","POS integration: two-way API sync with any POS that works with WooCommerce."],["FFL Accelerator","$569","Webmaster included: email automation and [GunSearchEngine.com](https://www.gunsearchengine.com/?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ffl-website-cost&utm_content=gse-pro) Pro."]];
---

<BaseLayout
  faq={FAQ_COST}
  title="How much does an FFL website cost? Setup + monthly | Coriolis"
  description={`What an FFL website costs at Coriolis: setup ${usd(basic.price)} or ${usd(retail.price)}, then a monthly plan from ${usd(low.price)} to ${usd(high.price)}. What each step up adds, and what is not in the price.`}
  path="/ffl-website-cost"
  ogImagePath={CANON_PATHS.rangeMckinney}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        Ecommerce · Cost
      </p>
      <h1
        class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        How much does an FFL website cost?
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md("An FFL website at Coriolis is two numbers: a one-time setup of $500 or $2,500, then a [monthly plan from $169 to $569](/ecommerce). There's no annual contract, and if you leave, you take the website. Which plan you need comes down to three things: dropshipping, VIP support, and whether you want the register you already run connected to the site.")} />
      <div class="mt-8">
        <CtaRow talk primary="ecommerce" showGsa={false} showContact />
      </div>
      <EcommerceCluster dropshipLabel="listing distributor catalogs on a store you own" />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"One-time setup, at $500 or $2,500, and what each setup includes"}</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              {setupTable[0].map((h) => <th class="py-3 pr-4 font-medium">{h}</th>)}
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {setupTable.slice(1).map((r) => (
              <tr class="border-b border-zinc-800/80">
                {r.map((c, i) => i === 0 ? <th class="py-3 pr-4 align-top font-medium text-zinc-300" set:html={md(c)} /> : <td class="py-3 pr-4 align-top" set:html={md(c)} />)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Monthly plans from $169 to $569, and what each step up adds"}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Each plan includes everything in the one before it, and there's no annual contract.")} />
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              {planTable[0].map((h) => <th class="py-3 pr-4 font-medium">{h}</th>)}
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {planTable.slice(1).map((r) => (
              <tr class="border-b border-zinc-800/80">
                {r.map((c, i) => i === 0 ? <th class="py-3 pr-4 align-top font-medium text-zinc-300" set:html={md(c)} /> : <td class="py-3 pr-4 align-top" set:html={md(c)} />)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"What is not in the plan price, including cards, the register, and support on Minute Man"}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Card processing sits outside the plan price; see [payment processing for FFLs](/ffl-payment-processing). We install the payment gateway at setup, or you bring your own, and the merchant account is yours, and so are its fees.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Your POS subscription is also outside the plan, and Warlord and FFL Accelerator connect the register you already run, while the register stays with your POS company.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Support on Minute Man is on demand at $125 per incident, and Militia and up include email support.")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Coriolis does not run 4473, NICS, or the bound book, and those stay with the tools you use today.")} />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <h2 class="text-xl font-semibold text-white">{"Comparing these numbers against another platform, without republishing someone else's fee card"}</h2>
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("We publish our numbers, and we do not republish other platforms' fee cards, because they are theirs and they change. Put your current invoice next to the ladder above, and if you're leaving a template platform, the switch guides are [how to leave AmmoReady](/leave-ammoready) and [how to leave Gearfire](/leave-gearfire).")} />
      <CtaRow primary="ecommerce" showGsa={false} showContact />
    </div>
  </section>

  <FaqBlock items={FAQ_COST} heading={"The questions dealers ask about what an FFL website costs, and what the price does not cover"} />

  <TalkSection heading={"Tell us about the website you want and we'll make it happen."} subline={"We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time."} />
</BaseLayout>
