---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import PartnerLogos from "../components/PartnerLogos.astro";
import { CLIENTS } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { LINKS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";

type Pillar = {
  href: string;
  kicker: string;
  title: string;
  body: string;
  /** Inline external links inside `body`, in order (rendered above the card's stretched link). */
  links?: readonly { text: string; href: string }[];
};

const pillars: readonly Pillar[] = [
  {
    href: "ecommerce",
    kicker: "For FFLs, ranges, and firearms brands",
    title: "Ecommerce",
    body: "Managed WooCommerce you own — inventory, dropship, and POS.",
  },
  {
    href: "gun-store-pos",
    kicker: "Keep the bound book and register you already run",
    title: "Gun Store POS",
    body: "GunBiz or AIM at the counter, connected to the WooCommerce store you own.",
  },
  {
    href: "ai-studio",
    kicker: "AI-powered solutions we've already shipped",
    title: "AI Studio",
    body: "Botopticon.com, GunSearchEngine.com, and GunStoreGame.com — bring the idea and the budget.",
    links: [
      { text: "Botopticon.com", href: "https://botopticon.com" },
      { text: "GunSearchEngine.com", href: "https://www.gunsearchengine.com/" },
      { text: "GunStoreGame.com", href: "https://www.gunstoregame.com/" },
    ],
  },
  {
    href: "demand-intelligence",
    kicker: "For OEMs, distributors, and brands",
    title: "Demand Intelligence",
    body: "What shoppers typed — including the searches that found nothing.",
  },
];

// gse-links (src/integrations/gse-links.mjs) links plain-text "GunSearchEngine.com" that is
// not inside an <a>. The pillar cards used to be one <a>, so the card text stayed plain.
// Keep it plain under the stretched link: an auto-link there would sit under the card
// overlay and could not be clicked. The empty comment splits the token; the text reads the same.
const GSE_LABEL = "GunSearchEngine.com";
const escapeHtml = (t: string) =>
  t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const plainCardText = (t: string) =>
  escapeHtml(t).split(GSE_LABEL).join("GunSearchEngine<!-- -->.com");

/** Split a card body into plain-text runs and its inline links, in order. */
type BodyPart = { text: string; href?: string };
const bodyParts = (p: Pillar): BodyPart[] => {
  const parts: BodyPart[] = [];
  let rest = p.body;
  for (const l of p.links ?? []) {
    const i = rest.indexOf(l.text);
    if (i === -1) throw new Error(`pillar "${p.title}": link text "${l.text}" not in body`);
    if (i > 0) parts.push({ text: rest.slice(0, i) });
    parts.push({ text: l.text, href: l.href });
    rest = rest.slice(i + l.text.length);
  }
  if (rest) parts.push({ text: rest });
  return parts;
};

// Global CSS sets `a { color: inherit }` outside Tailwind's layers, so it beats the
// `text-sky-400` utility in linkClass. `!text-sky-400` (important, as btnPlan does) keeps
// the inline card links sky-blue.
const cardLinkClass = `${linkClass} !text-sky-400 relative z-10`;

const heroSlides = [
  {
    href: "https://naplesgunshop.net/",
    src: CANON_PATHS.naplesGunShop,
    alt: "A live Coriolis FFL ecommerce site. Naples Gun Shop. Opens in a new tab.",
    label: "Naples Gun Shop",
  },
  {
    href: "https://wifirearms.com/",
    src: CANON_PATHS.wftc,
    alt: "A live Coriolis FFL ecommerce site. Wisconsin Firearms Training Center. Opens in a new tab.",
    label: "Wisconsin Firearms Training Center",
  },
  {
    href: "https://www.alliedarmsgroup.com/",
    src: CANON_PATHS.alliedArms,
    alt: "A live Coriolis FFL ecommerce site. Allied Arms. Opens in a new tab.",
    label: "Allied Arms",
  },
  {
    src: CANON_PATHS.highlineFirearms,
    alt: "A Coriolis FFL ecommerce site in progress. Highline Firearms.",
    label: "Highline Firearms",
  },
] as const;
---

<BaseLayout
  title="FFL Ecommerce Websites for Gun Stores | Coriolis, LLC"
  description="Coriolis builds WooCommerce gun store websites you own. Switch off AmmoReady or Gearfire without going dark. FFL Cockpit, dropshipping, and the register you already run."
  path="/"
  ogImagePath={CANON_PATHS.storefront}
>
  <section class="relative overflow-hidden border-b border-zinc-800/80">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,160,23,0.10),transparent_50%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 py-14 sm:px-6 lg:py-20 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"
    >
      <div class="flex min-h-0 w-full min-w-0 flex-col">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Coriolis, LLC
        </p>
        <h1
          class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-4xl leading-[1.2]"
        >
          FFL Ecommerce Experts
        </h1>
        <p class="mt-5 text-base leading-relaxed text-zinc-300 sm:text-lg">
          Most gun store websites are rented templates you don’t control.
          Coriolis builds WooCommerce on your domain with{" "}
          <a
            href={LINKS.fflCockpit}
            class={linkClass}
            target="_blank"
            rel="noopener noreferrer">FFL Cockpit</a
          >
          {" "}catalogs, FFL Checkout, and the register you already run. Switch
          without going dark.
        </p>
        <div class="mt-5 w-full min-w-0">
          <CtaRow
            primary="ecommerce"
            showGsa={false}
            showContact
            class="sm:!flex-nowrap"
          />
        </div>
      </div>
      <div
        class="hero-slider relative w-full min-w-0 overflow-hidden rounded-2xl ring-1 ring-white/10 transition hover:ring-gold/50 focus-within:ring-gold/50"
        data-hero-slider
        role="region"
        aria-roledescription="carousel"
        aria-label="Coriolis FFL ecommerce sites"
      >
        <div class="grid w-full min-w-0">
          {
            heroSlides.map((slide, i) => {
              const linked = "href" in slide;
              const img = (
                <img
                  src={withBase(slide.src)}
                  alt={slide.alt}
                  width="1499"
                  height="1059"
                  class="h-auto w-full object-cover object-center"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "low"}
                />
              );
              const cls = [
                "hero-slider__slide col-start-1 row-start-1 block w-full min-w-0",
                i === 0 && "is-active",
              ];
              return linked ? (
                <a
                  href={slide.href}
                  class:list={cls}
                  data-slide={i}
                  aria-hidden={i === 0 ? "false" : "true"}
                  tabindex={i === 0 ? 0 : -1}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {img}
                </a>
              ) : (
                <div
                  class:list={cls}
                  data-slide={i}
                  aria-hidden={i === 0 ? "false" : "true"}
                >
                  {img}
                </div>
              );
            })
          }
        </div>
        <div
          class="pointer-events-none absolute inset-x-0 bottom-3 z-10 flex items-center justify-center gap-2"
        >
          {
            heroSlides.map((slide, i) => (
              <button
                type="button"
                class:list={["hero-slider__dot pointer-events-auto", i === 0 && "is-active"]}
                data-goto={i}
                aria-label={`Show ${slide.label}`}
                aria-current={i === 0 ? "true" : "false"}
              />
            ))
          }
        </div>
        <button
          type="button"
          class="hero-slider__arrow hero-slider__arrow--prev"
          data-dir="-1"
          aria-label="Previous site"
        >
          <span aria-hidden="true">‹</span>
        </button>
        <button
          type="button"
          class="hero-slider__arrow hero-slider__arrow--next"
          data-dir="1"
          aria-label="Next site"
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </section>

  <style>
    .hero-slider__slide {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      z-index: 0;
      transition:
        opacity 0.55s ease,
        visibility 0.55s ease;
    }
    .hero-slider__slide.is-active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      z-index: 1;
    }
    .hero-slider__dot {
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 999px;
      border: 0;
      padding: 0;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.38);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }
    .hero-slider__dot.is-active {
      background: #d4a017;
      transform: scale(1.18);
    }
    .hero-slider__dot:hover,
    .hero-slider__dot:focus-visible {
      background: #f0d078;
    }
    .hero-slider__arrow {
      position: absolute;
      top: 50%;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 999px;
      transform: translateY(-50%);
      cursor: pointer;
      color: #fff;
      font-size: 1.35rem;
      line-height: 1;
      background: rgba(10, 18, 32, 0.55);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
      transition: background 0.2s ease, color 0.2s ease;
    }
    .hero-slider__arrow:hover,
    .hero-slider__arrow:focus-visible {
      background: rgba(212, 160, 23, 0.92);
      color: #0a1220;
    }
    .hero-slider__arrow--prev {
      left: 0.6rem;
    }
    .hero-slider__arrow--next {
      right: 0.6rem;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-slider__slide {
        transition: none;
      }
    }
  </style>

  <script>
    (function () {
      const root = document.querySelector("[data-hero-slider]");
      if (!(root instanceof HTMLElement)) return;

      const slides = Array.from(root.querySelectorAll("[data-slide]"));
      const dots = Array.from(root.querySelectorAll("[data-goto]"));
      const arrows = Array.from(root.querySelectorAll("[data-dir]"));
      if (slides.length < 2) return;

      const INTERVAL_MS = 5500;
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let index = 0;
      let timer = 0;

      function show(next: number) {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const on = i === index;
          slide.classList.toggle("is-active", on);
          slide.setAttribute("aria-hidden", on ? "false" : "true");
          if (slide instanceof HTMLAnchorElement) slide.tabIndex = on ? 0 : -1;
        });
        dots.forEach((dot, i) => {
          const on = i === index;
          dot.classList.toggle("is-active", on);
          dot.setAttribute("aria-current", on ? "true" : "false");
        });
      }

      function stop() {
        if (timer) {
          window.clearInterval(timer);
          timer = 0;
        }
      }

      function start() {
        if (reduceMotion || document.hidden) return;
        stop();
        timer = window.setInterval(() => show(index + 1), INTERVAL_MS);
      }

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const goto = Number(dot.getAttribute("data-goto"));
          if (Number.isFinite(goto)) show(goto);
          start();
        });
      });

      arrows.forEach((btn) => {
        btn.addEventListener("click", () => {
          const dir = Number(btn.getAttribute("data-dir")) || 1;
          show(index + dir);
          start();
        });
      });

      root.addEventListener("mouseenter", stop);
      root.addEventListener("mouseleave", start);
      root.addEventListener("focusin", stop);
      root.addEventListener("focusout", (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !root.contains(next)) start();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });

      start();
    })();
  </script>

  <PartnerLogos />

  <GoogleReviews />

  <section class="border-b border-zinc-800/80 bg-zinc-950/40">
    <div class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold"
      >
        What we do
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((p) => {
            const parts = bodyParts(p);
            return (
              <div class="group relative flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6 transition hover:border-gold/50">
                <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                  {p.kicker}
                </p>
                <h2 class="mt-2 text-xl font-semibold text-white group-hover:text-gold">
                  <a
                    href={withBase(p.href)}
                    class="focus-visible:outline-none after:absolute after:inset-0 after:rounded-2xl after:content-[''] focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-gold"
                  >
                    {p.title}
                  </a>
                </h2>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">
                  {parts.map((part) => part.href ? (<a href={part.href} target="_blank" rel="noopener noreferrer" class={cardLinkClass}>{part.text}</a>) : (<Fragment set:html={plainCardText(part.text)} />))}
                </p>
                <p class="mt-5 text-sm font-medium text-sky-400" aria-hidden="true">
                  See {p.title} →
                </p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="border-b border-sky-500/25 bg-sky-950/25 py-10 sm:py-12">
    <div
      class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,16rem)_1fr]"
      data-grok-bot-plate
    >
      <img
        src={withBase(CANON_PATHS.grokBotBannerHome)}
        alt="Sample Grok Bot setup UI on a gun store counter."
        width="1536"
        height="1024"
        class="w-full min-w-0 max-w-[16rem]"
      />
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-300"
        >
          AI Studio
        </p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-white">
          <a
            href={withBase("grok-bot-setup")}
            class="hover:text-sky-200 focus-visible:outline-none after:absolute after:inset-0 after:content-[''] focus-visible:after:rounded-sm focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-sky-300"
            >Grok Bot setup — $995.</a
          >
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-300">
          Use Grok Bot to help run your gun store. We will help you design your
          AI strategy then create, configure, train, and test your bots. One time
          fee. Live the same day.
        </p>
        <p class={`${linkClass} mt-5 inline-flex text-sm`} aria-hidden="true">
          Grok Bot setup — $995. →
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80">
    <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500"
      >
        Recent clients
      </p>
      <ul
        class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-400"
      >
        {
          CLIENTS.map((client) => (
            <li>
              <a
                href={client.href}
                class="hover:text-sky-300"
                target="_blank"
                rel="noopener noreferrer"
              >
                {client.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
