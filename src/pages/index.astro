---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import { CLIENTS } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { LINKS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";

const pillars = [
  {
    href: "ecommerce",
    kicker: "For FFLs, ranges, and firearms brands",
    title: "Ecommerce",
    body: "Managed WooCommerce you own — inventory, dropship, POS, and Betsy on the domain.",
  },
  {
    href: "ai-studio",
    kicker: "Shipped proof, not a pitch",
    title: "AI Studio",
    body: "Betsy, GunSearchAgent, Demand Intelligence, and Gun Store Game — bring the idea and the budget.",
  },
  {
    href: "demand-intelligence",
    kicker: "For OEMs, distributors, and brands",
    title: "Demand Intelligence",
    body: "What the market asked for, including what it could not find. Full-market search intent.",
  },
] as const;

const heroSlides = [
  {
    href: "https://naplesgunshop.net/",
    src: CANON_PATHS.naplesGunShop,
    alt: "A live Coriolis FFL ecommerce site. Naples Gun Shop. Opens in a new tab.",
    label: "Naples Gun Shop",
  },
  {
    href: "https://wifirearms.com/",
    src: CANON_PATHS.wftc,
    alt: "A live Coriolis FFL ecommerce site. Wisconsin Firearms Training Center. Opens in a new tab.",
    label: "Wisconsin Firearms Training Center",
  },
  {
    href: "https://www.alliedarmsgroup.com/",
    src: CANON_PATHS.alliedArms,
    alt: "A live Coriolis FFL ecommerce site. Allied Arms. Opens in a new tab.",
    label: "Allied Arms",
  },
  {
    src: CANON_PATHS.highlineFirearms,
    alt: "A Coriolis FFL ecommerce site in progress. Highline Firearms.",
    label: "Highline Firearms",
  },
] as const;
---

<BaseLayout
  title="Coriolis, LLC — FFL Ecommerce, AI Studio, Demand Intelligence"
  description="Coriolis builds ATF-aware WooCommerce for FFLs, ships AI products, and sells full-market Demand Intelligence to OEMs and brands."
  path="/"
  ogImagePath={CANON_PATHS.grokBotHero}
>
  <section class="relative overflow-hidden border-b border-zinc-800/80">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,160,23,0.10),transparent_50%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 py-14 sm:px-6 lg:py-20 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"
    >
      <div class="flex min-h-0 w-full min-w-0 flex-col">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Coriolis, LLC
        </p>
        <h1
          class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]"
        >
          FFL Ecommerce. AI Studio. Demand Intelligence.
        </h1>
        <p class="mt-5 text-base leading-relaxed text-zinc-300 sm:text-lg">
          We build, host, and support WooCommerce websites powered by{" "}
          <a
            href={LINKS.fflCockpit}
            class={linkClass}
            target="_blank"
            rel="noopener noreferrer">FFL Cockpit</a
          >,{" "}
          <a
            href={LINKS.betsy}
            class={linkClass}
            target="_blank"
            rel="noopener noreferrer">Betsy AI</a
          >, and{" "}
          <a
            href={LINKS.gsa}
            class={linkClass}
            target="_blank"
            rel="noopener noreferrer">GunSearchAgent.com</a
          >.
        </p>
        <div class="mt-5 w-full min-w-0">
          <CtaRow primary="ecommerce" class="sm:!flex-nowrap" />
        </div>
      </div>
      <div
        class="hero-slider relative w-full min-w-0 overflow-hidden rounded-2xl ring-1 ring-white/10 transition hover:ring-gold/50 focus-within:ring-gold/50"
        data-hero-slider
        role="region"
        aria-roledescription="carousel"
        aria-label="Coriolis FFL ecommerce sites"
      >
        <div class="grid w-full min-w-0">
          {
            heroSlides.map((slide, i) => {
              const linked = "href" in slide;
              const img = (
                <img
                  src={withBase(slide.src)}
                  alt={slide.alt}
                  width="1499"
                  height="1059"
                  class="h-auto w-full object-cover object-center"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "low"}
                />
              );
              const cls = [
                "hero-slider__slide col-start-1 row-start-1 block w-full min-w-0",
                i === 0 && "is-active",
              ];
              return linked ? (
                <a
                  href={slide.href}
                  class:list={cls}
                  data-slide={i}
                  aria-hidden={i === 0 ? "false" : "true"}
                  tabindex={i === 0 ? 0 : -1}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {img}
                </a>
              ) : (
                <div
                  class:list={cls}
                  data-slide={i}
                  aria-hidden={i === 0 ? "false" : "true"}
                >
                  {img}
                </div>
              );
            })
          }
        </div>
        <div
          class="pointer-events-none absolute inset-x-0 bottom-3 z-10 flex items-center justify-center gap-2"
        >
          {
            heroSlides.map((slide, i) => (
              <button
                type="button"
                class:list={["hero-slider__dot pointer-events-auto", i === 0 && "is-active"]}
                data-goto={i}
                aria-label={`Show ${slide.label}`}
                aria-current={i === 0 ? "true" : "false"}
              />
            ))
          }
        </div>
        <button
          type="button"
          class="hero-slider__arrow hero-slider__arrow--prev"
          data-dir="-1"
          aria-label="Previous site"
        >
          <span aria-hidden="true">‹</span>
        </button>
        <button
          type="button"
          class="hero-slider__arrow hero-slider__arrow--next"
          data-dir="1"
          aria-label="Next site"
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </section>

  <style>
    .hero-slider__slide {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      z-index: 0;
      transition:
        opacity 0.55s ease,
        visibility 0.55s ease;
    }
    .hero-slider__slide.is-active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      z-index: 1;
    }
    .hero-slider__dot {
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 999px;
      border: 0;
      padding: 0;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.38);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }
    .hero-slider__dot.is-active {
      background: #d4a017;
      transform: scale(1.18);
    }
    .hero-slider__dot:hover,
    .hero-slider__dot:focus-visible {
      background: #f0d078;
    }
    .hero-slider__arrow {
      position: absolute;
      top: 50%;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 999px;
      transform: translateY(-50%);
      cursor: pointer;
      color: #fff;
      font-size: 1.35rem;
      line-height: 1;
      background: rgba(10, 18, 32, 0.55);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
      transition: background 0.2s ease, color 0.2s ease;
    }
    .hero-slider__arrow:hover,
    .hero-slider__arrow:focus-visible {
      background: rgba(212, 160, 23, 0.92);
      color: #0a1220;
    }
    .hero-slider__arrow--prev {
      left: 0.6rem;
    }
    .hero-slider__arrow--next {
      right: 0.6rem;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-slider__slide {
        transition: none;
      }
    }
  </style>

  <script>
    (function () {
      const root = document.querySelector("[data-hero-slider]");
      if (!(root instanceof HTMLElement)) return;

      const slides = Array.from(root.querySelectorAll("[data-slide]"));
      const dots = Array.from(root.querySelectorAll("[data-goto]"));
      const arrows = Array.from(root.querySelectorAll("[data-dir]"));
      if (slides.length < 2) return;

      const INTERVAL_MS = 5500;
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let index = 0;
      let timer = 0;

      function show(next: number) {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const on = i === index;
          slide.classList.toggle("is-active", on);
          slide.setAttribute("aria-hidden", on ? "false" : "true");
          if (slide instanceof HTMLAnchorElement) slide.tabIndex = on ? 0 : -1;
        });
        dots.forEach((dot, i) => {
          const on = i === index;
          dot.classList.toggle("is-active", on);
          dot.setAttribute("aria-current", on ? "true" : "false");
        });
      }

      function stop() {
        if (timer) {
          window.clearInterval(timer);
          timer = 0;
        }
      }

      function start() {
        if (reduceMotion || document.hidden) return;
        stop();
        timer = window.setInterval(() => show(index + 1), INTERVAL_MS);
      }

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const goto = Number(dot.getAttribute("data-goto"));
          if (Number.isFinite(goto)) show(goto);
          start();
        });
      });

      arrows.forEach((btn) => {
        btn.addEventListener("click", () => {
          const dir = Number(btn.getAttribute("data-dir")) || 1;
          show(index + dir);
          start();
        });
      });

      root.addEventListener("mouseenter", stop);
      root.addEventListener("mouseleave", start);
      root.addEventListener("focusin", stop);
      root.addEventListener("focusout", (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !root.contains(next)) start();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });

      start();
    })();
  </script>

  <GoogleReviews />

  <section class="border-b border-sky-500/25 bg-sky-950/25 py-10 sm:py-12">
    <a
      href={withBase("grok-bot-setup")}
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,16rem)_1fr]"
    >
      <img
        src={withBase(CANON_PATHS.grokBotBanner)}
        alt="Sample Grok Bot setup UI on a gun store counter."
        width="1920"
        height="1080"
        class="w-full min-w-0 max-w-[16rem]"
      />
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-300"
        >
          Setup
        </p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-white">
          Grok Bot setup — $995.
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-300">
          AI is everywhere. You do not need another chatbot. One hour with us to
          write your AI strategy. Then we build it, test it, and train you to
          run it. One fee. $995. Two meetings. Live the same day.
        </p>
        <p class={`${linkClass} mt-5 inline-flex text-sm`}>
          Grok Bot setup — $995. →
        </p>
      </div>
    </a>
  </section>

  <section class="border-b border-zinc-800/80 bg-zinc-950/40">
    <div class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold"
      >
        What we do
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
        {
          pillars.map((p) => (
            <a
              href={withBase(p.href)}
              class="group flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6 transition hover:border-gold/50"
            >
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {p.kicker}
              </p>
              <h2 class="mt-2 text-xl font-semibold text-white group-hover:text-gold">
                {p.title}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">
                {p.body}
              </p>
              <p class="mt-5 text-sm font-medium text-sky-400">See {p.title} →</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80">
    <div class="mx-auto w-full max-w-7xl px-4 py-12 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500"
      >
        Recent clients
      </p>
      <ul
        class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-400"
      >
        {
          CLIENTS.map((client) => (
            <li>
              <a
                href={client.href}
                class="hover:text-sky-300"
                target="_blank"
                rel="noopener noreferrer"
              >
                {client.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
