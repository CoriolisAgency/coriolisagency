---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import { CLIENTS } from "../lib/plans";
import { FROZEN } from "../lib/frozen";
import { CANON_PATHS } from "../lib/site";
import { LINKS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";

const pillars = [
  {
    href: "ecommerce",
    kicker: "For FFLs, ranges, and 2A brands",
    title: "Ecommerce",
    body: "Managed WooCommerce you own — inventory, dropship, POS, and Betsy on the domain.",
  },
  {
    href: "ai-factory",
    kicker: "Working products, not slideware",
    title: "AI Factory",
    body: "Betsy AI, GunSearchEngine, GunSearchAgent, Coriolis OS, Betsy Live, and Gun Store Game.",
  },
  {
    href: "demand-intelligence",
    kicker: "For OEMs, distributors, and brands",
    title: "Demand Intelligence",
    body: "What the market asked for, including what it could not find. Full-market search intent.",
  },
] as const;
---

<BaseLayout
  title="Coriolis, LLC — FFL Ecommerce, AI Factory, 2A Demand Intelligence"
  description="Coriolis builds ATF-aware WooCommerce for FFLs, ships 2A-native AI products, and sells full-market Demand Intelligence to OEMs and brands."
  path="/"
  ogImagePath={CANON_PATHS.gaHero}
>
  <section class="relative overflow-hidden border-b border-zinc-800/80">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,160,23,0.10),transparent_50%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:py-20"
    >
      <div>
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Coriolis, LLC
        </p>
        <h1
          class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]"
        >
          FFL Ecommerce. AI Factory. 2A Demand Intelligence.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-zinc-300 sm:text-lg">
          We build the store, the intelligence, and the software that runs both
          — for lawful 2A commerce.
        </p>
        <div class="mt-8">
          <CtaRow primary="ecommerce" />
        </div>
        <p class="mt-6 text-sm text-zinc-500">
          Already have a site?{" "}
          <a
            href={LINKS.gsa}
            class={linkClass}
            target="_blank"
            rel="noopener noreferrer">Put Betsy on it free</a
          >. Watch the market on{" "}
          <a
            href={LINKS.betsyLive}
            class={linkClass}
            target="_blank"
            rel="noopener noreferrer">Betsy Live</a
          >.
        </p>
      </div>
      <div>
        <img
          src={withBase(CANON_PATHS.gaHero)}
          alt="Betsy AI — demand intelligence for the 2A web"
          width="1600"
          height="900"
          class="w-full rounded-2xl object-cover ring-1 ring-white/10"
        />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 bg-zinc-950/40">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold"
      >
        Three doors
      </p>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {
          pillars.map((p) => (
            <a
              href={withBase(p.href)}
              class="group flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6 transition hover:border-gold/50"
            >
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {p.kicker}
              </p>
              <h2 class="mt-2 text-xl font-semibold text-white group-hover:text-gold">
                {p.title}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">
                {p.body}
              </p>
              <p class="mt-5 text-sm font-medium text-sky-400">Open {p.title} →</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500"
      >
        Recent clients
      </p>
      <ul
        class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-zinc-400"
      >
        {
          CLIENTS.map((name) => (
            <li>{name}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
        {FROZEN.commercialLine}
      </p>
      <p class="mt-4 text-sm text-zinc-500">
        Our founder built and ran AmmoReady.com for 9 years. Greenville, SC.
      </p>
    </div>
  </section>
</BaseLayout>
