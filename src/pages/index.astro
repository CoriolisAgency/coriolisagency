---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import PartnerLogos from "../components/PartnerLogos.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LeadForm from "@coriolis/lead-form/LeadForm.astro";
import { FAQ_HOME } from "../lib/faq";
import { TRUSTINDEX_REVIEWS_HREF } from "../lib/google-reviews";
import { CANON_PATHS } from "../lib/site";
import { LINKS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";
import { md } from "../lib/md";

// CA-VOICE-P1 batch 1 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-1/home.md, shipped as drafted.
// Cards are "**Title.** body [See X](href)"; the title, body and link are split out below.
const CARD = /^\*\*(.+?)\.\*\*\s+(.*?)\s+(\[See [^\]]+\]\([^)\s]+\))$/;
const splitCard = (s: string) => {
  const m = s.match(CARD);
  if (!m) throw new Error("home card: " + s);
  return { title: m[1], body: m[2], link: m[3] };
};
const audiences = (["**Gun shops.** Your store goes online on your domain, connected to the register you already run. [See FFL website design](/ecommerce)","**Online-only FFLs.** You can list 21 distributor catalogs and dropship to your buyers without keeping a shelf of your own. [See FFL dropshipping](/firearms-dropshipping)","**Ranges, gunsmiths and instructors.** Lane time, classes, and memberships sit on the same site as the store. [See range and instructor websites](/websites-for-ranges-gunsmiths-instructors)","**Firearms brands.** Your own builds go up front, with a full catalog behind them. [See what we built for Tier 1 Kinetics](/press/four-firearms-businesses-choose-coriolis-for-custom-woocommerce-stores)"] as const).map(splitCard);

type Pillar = {
  href: string;
  kicker: string;
  title: string;
  body: string;
  /** External absolute href; open in a new tab and skip withBase. */
  external?: boolean;
  /** CTA after "See "; defaults to title. */
  cta?: string;
  /** Inline external links inside `body`, in order (rendered above the card's stretched link). */
  links?: readonly { text: string; href: string }[];
};

const PILLAR_KICKERS = ["For FFLs, ranges, and brands", "Website integration", "On FFL Accelerator", "GunSearchEngine.com"] as const;
const MDLINK = /\[([^\]]+)\]\(([^)\s]+)\)/g;
const pillars: readonly Pillar[] = (["**Ecommerce.** We build a managed WooCommerce store you own, so you can sell your inventory, dropship, and connect the register you already run. [See Ecommerce](/ecommerce)","**Gun Store POS.** Website integration on Warlord and FFL Accelerator works with AIM, MicroBiz, Rapid Gun Systems, Trident 1, or any other POS that works with WooCommerce. [See Gun Store POS](/gun-store-pos)","**Email Marketing.** On FFL Accelerator we handle capture, list management, and the automated campaigns: welcome, abandoned cart, back in stock, and thank you. [See Email Marketing](/email-marketing-for-ffl-ecommerce)","**Consumer Search.** List inventory for shopper search on [GunSearchEngine.com](https://www.gunsearchengine.com/?utm_source=coriolisagency&utm_medium=referral&utm_campaign=home&utm_content=consumer-search). Free GSE Basic includes FFL Analytics, which shows what people typed on your site, including the searches that came back empty. [See the Dealer Program](https://www.gunsearchengine.com/for-dealers?utm_source=coriolisagency&utm_medium=referral&utm_campaign=home&utm_content=dealer-program)"] as const).map((item, i) => {
  const c = splitCard(item);
  const [, cta, href] = c.link.match(/^\[See ([^\]]+)\]\(([^)\s]+)\)$/)!;
  const links = [...c.body.matchAll(MDLINK)].map((m) => ({ text: m[1], href: m[2] }));
  const external = /^https?:/.test(href);
  return {
    href: external ? href : href.replace(/^\//, ""),
    external: external || undefined,
    kicker: PILLAR_KICKERS[i],
    title: c.title,
    cta: cta === c.title ? undefined : cta,
    body: c.body.replace(MDLINK, "$1"),
    links: links.length ? links : undefined,
  };
});

// gse-links (src/integrations/gse-links.mjs) links plain-text "GunSearchEngine.com" that is
// not inside an <a>. The pillar cards used to be one <a>, so the card text stayed plain.
// Keep it plain under the stretched link: an auto-link there would sit under the card
// overlay and could not be clicked. The empty comment splits the token; the text reads the same.
const GSE_LABEL = "GunSearchEngine.com";
const escapeHtml = (t: string) =>
  t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const plainCardText = (t: string) =>
  escapeHtml(t).split(GSE_LABEL).join("GunSearchEngine<!-- -->.com");

/** Split a card body into plain-text runs and its inline links, in order. */
type BodyPart = { text: string; href?: string };
const bodyParts = (p: Pillar): BodyPart[] => {
  const parts: BodyPart[] = [];
  let rest = p.body;
  for (const l of p.links ?? []) {
    const i = rest.indexOf(l.text);
    if (i === -1) throw new Error(`pillar "${p.title}": link text "${l.text}" not in body`);
    if (i > 0) parts.push({ text: rest.slice(0, i) });
    parts.push({ text: l.text, href: l.href });
    rest = rest.slice(i + l.text.length);
  }
  if (rest) parts.push({ text: rest });
  return parts;
};

// Global CSS sets `a { color: inherit }` outside Tailwind's layers, so it beats the
// `text-sky-400` utility in linkClass. `!text-sky-400` (important, as btnPlan does) keeps
// the inline card links sky-blue.
const cardLinkClass = `${linkClass} !text-sky-400 relative z-10`;

const heroSlides = [
  {
    src: CANON_PATHS.jkOutdoors,
    webp: CANON_PATHS.jkOutdoorsWebp,
    alt: "A Coriolis FFL ecommerce site in progress. JK Outdoors.",
    label: "JK Outdoors",
  },
  {
    src: CANON_PATHS.parapet,
    webp: CANON_PATHS.parapetWebp,
    alt: "A Coriolis FFL ecommerce site in progress. Parapet Outfitters & Supply.",
    label: "Parapet Outfitters & Supply",
  },
  {
    src: CANON_PATHS.guardianGuns,
    webp: CANON_PATHS.guardianGunsWebp,
    alt: "A Coriolis FFL ecommerce site in progress. Guardian Guns.",
    label: "Guardian Guns",
  },
  {
    src: CANON_PATHS.naplesGunShop,
    alt: "A live Coriolis FFL ecommerce site. Naples Gun Shop.",
    label: "Naples Gun Shop",
  },
  {
    src: CANON_PATHS.highlineFirearms,
    alt: "A Coriolis FFL ecommerce site in progress. Highline Firearms.",
    label: "Highline Firearms",
  },
  {
    src: CANON_PATHS.theGunRange,
    alt: "A Coriolis FFL ecommerce site in progress. The Gun Range.",
    label: "The Gun Range",
  },
] as const;
---

<BaseLayout
  title="FFL Ecommerce Websites for Gun Stores | Coriolis, LLC"
  description="Coriolis builds WooCommerce websites for gun stores on a domain you own, with FFL Cockpit dropshipping and the register you already run connected."
  path="/"
  ogImagePath={CANON_PATHS.storefront}
  faq={FAQ_HOME}
>
  <section class="relative overflow-hidden border-b border-zinc-800/80">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(212,160,23,0.10),transparent_50%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 py-14 sm:px-6 lg:py-20 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]"
    >
      <div class="flex min-h-0 w-full min-w-0 flex-col">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Coriolis, LLC
        </p>
        <h1
          class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-4xl leading-[1.2]"
        >
          Coriolis Builds Ecommerce Websites for FFLs, Retailers, and Brands
        </h1>
        <p class="mt-5 text-base leading-relaxed text-zinc-300 sm:text-lg" set:html={md("Coriolis builds WooCommerce websites for gun shops, online-only FFLs, ranges, and gunsmiths, on a domain you own. You can sell what's on the shelf, dropship through FFL Cockpit and FFL Checkout, or do both, and we can connect the register you already run. If you're leaving a template platform, we build the new store on your domain first so the switch doesn't take you offline.")} />
        <div class="mt-5 w-full min-w-0">
          <CtaRow
            primary="ecommerce"
            showGsa={false}
            showContact
            class="sm:!flex-nowrap"
          />
        </div>
        <p class="mt-4 text-sm text-zinc-400" data-proof-line data-membership-line set:html={md("Coriolis has 100+ clients and a [5-star Google rating](https://www.trustindex.io/reviews/coriolisagency.com) (5.0 out of 5 stars on [Google](https://g.page/r/Ca-DxrPglsXcEAI)), and is a proud member of NSSF, Firearms Policy Coalition and Gun Owners of America.")} />
      </div>
      <div
        class="hero-slider relative order-first w-full min-w-0 overflow-hidden xl:order-none rounded-2xl ring-1 ring-white/10 transition hover:ring-gold/50 focus-within:ring-gold/50"
        data-hero-slider
        role="region"
        aria-roledescription="carousel"
        aria-label="Coriolis FFL ecommerce sites"
      >
        <div class="grid w-full min-w-0">
          {
            heroSlides.map((slide, i) => {
              const slideSizes = "(min-width: 1280px) 55vw, 100vw";
              const img = (
                <picture>
                  {"webp" in slide ? (
                    <source
                      type="image/webp"
                      srcset={withBase(slide.webp)}
                      sizes={slideSizes}
                    />
                  ) : null}
                  <img
                    src={withBase(slide.src)}
                    alt={slide.alt}
                    width="1499"
                    height="1059"
                    sizes={slideSizes}
                    class="h-auto w-full object-cover object-center"
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "low"}
                  />
                </picture>
              );
              return (
                <div
                  class:list={[
                    "hero-slider__slide col-start-1 row-start-1 block w-full min-w-0",
                    i === 0 && "is-active",
                  ]}
                  data-slide={i}
                  aria-hidden={i === 0 ? "false" : "true"}
                >
                  {img}
                </div>
              );
            })
          }
        </div>
        <div
          class="pointer-events-none absolute inset-x-0 bottom-3 z-10 flex items-center justify-center gap-2"
        >
          {
            heroSlides.map((slide, i) => (
              <button
                type="button"
                class:list={["hero-slider__dot pointer-events-auto", i === 0 && "is-active"]}
                data-goto={i}
                aria-label={`Show ${slide.label}`}
                aria-current={i === 0 ? "true" : "false"}
              />
            ))
          }
        </div>
        <button
          type="button"
          class="hero-slider__arrow hero-slider__arrow--prev"
          data-dir="-1"
          aria-label="Previous site"
        >
          <span aria-hidden="true">‹</span>
        </button>
        <button
          type="button"
          class="hero-slider__arrow hero-slider__arrow--next"
          data-dir="1"
          aria-label="Next site"
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  </section>

  <style>
    .hero-slider__slide {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      z-index: 0;
      transition:
        opacity 0.55s ease,
        visibility 0.55s ease;
    }
    .hero-slider__slide.is-active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      z-index: 1;
    }
    .hero-slider__dot {
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 999px;
      border: 0;
      padding: 0;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.38);
      box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }
    .hero-slider__dot.is-active {
      background: #d4a017;
      transform: scale(1.18);
    }
    .hero-slider__dot:hover,
    .hero-slider__dot:focus-visible {
      background: #f0d078;
    }
    .hero-slider__arrow {
      position: absolute;
      top: 50%;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 999px;
      transform: translateY(-50%);
      cursor: pointer;
      color: #fff;
      font-size: 1.35rem;
      line-height: 1;
      background: rgba(10, 18, 32, 0.55);
      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
      transition: background 0.2s ease, color 0.2s ease;
    }
    .hero-slider__arrow:hover,
    .hero-slider__arrow:focus-visible {
      background: rgba(212, 160, 23, 0.92);
      color: #0a1220;
    }
    .hero-slider__arrow--prev {
      left: 0.6rem;
    }
    .hero-slider__arrow--next {
      right: 0.6rem;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-slider__slide {
        transition: none;
      }
    }
  </style>

  <script>
    (function () {
      const root = document.querySelector("[data-hero-slider]");
      if (!(root instanceof HTMLElement)) return;

      const slides = Array.from(root.querySelectorAll("[data-slide]"));
      const dots = Array.from(root.querySelectorAll("[data-goto]"));
      const arrows = Array.from(root.querySelectorAll("[data-dir]"));
      if (slides.length < 2) return;

      const INTERVAL_MS = 5500;
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      let index = 0;
      let timer = 0;

      function show(next: number) {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const on = i === index;
          slide.classList.toggle("is-active", on);
          slide.setAttribute("aria-hidden", on ? "false" : "true");
          if (slide instanceof HTMLAnchorElement) slide.tabIndex = on ? 0 : -1;
        });
        dots.forEach((dot, i) => {
          const on = i === index;
          dot.classList.toggle("is-active", on);
          dot.setAttribute("aria-current", on ? "true" : "false");
        });
      }

      function stop() {
        if (timer) {
          window.clearInterval(timer);
          timer = 0;
        }
      }

      function start() {
        if (reduceMotion || document.hidden) return;
        stop();
        timer = window.setInterval(() => show(index + 1), INTERVAL_MS);
      }

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const goto = Number(dot.getAttribute("data-goto"));
          if (Number.isFinite(goto)) show(goto);
          start();
        });
      });

      arrows.forEach((btn) => {
        btn.addEventListener("click", () => {
          const dir = Number(btn.getAttribute("data-dir")) || 1;
          show(index + dir);
          start();
        });
      });

      root.addEventListener("mouseenter", stop);
      root.addEventListener("mouseleave", start);
      root.addEventListener("focusin", stop);
      root.addEventListener("focusout", (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !root.contains(next)) start();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stop();
        else start();
      });

      start();
    })();
  </script>

  <PartnerLogos />

  <GoogleReviews intro={"These are Google reviews from shops we built, in the owners' own words:"} />

  <section class="border-b border-zinc-800/80 bg-zinc-950/40">
    <div class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6">
      <h2 class="text-2xl font-semibold tracking-tight text-white">{"What Coriolis builds and hosts for FFLs, ranges, and brands"}</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((p) => {
            const parts = bodyParts(p);
            return (
              <div class="group relative flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6 transition hover:border-gold/50">
                <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                  {p.kicker}
                </p>
                <h3 class="mt-2 text-xl font-semibold text-white group-hover:text-gold">
                  <a
                    href={p.external ? p.href : withBase(p.href)}
                    class="focus-visible:outline-none after:absolute after:inset-0 after:rounded-2xl after:content-[''] focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-gold"
                    target={p.external ? "_blank" : undefined}
                    rel={p.external ? "noopener noreferrer" : undefined}
                  >
                    {p.title}
                  </a>
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">
                  {parts.map((part) => part.href ? (<a href={part.href} target="_blank" rel="noopener noreferrer" class={cardLinkClass}>{part.text}</a>) : (<Fragment set:html={plainCardText(part.text)} />))}
                </p>
                <p class="mt-5 text-sm font-medium text-sky-400" aria-hidden="true">
                  See {p.cta ?? p.title} →
                </p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80" data-who-we-build-for>
    <div class="mx-auto w-full max-w-7xl px-4 py-14 sm:px-6">
      <h2 class="text-2xl font-semibold tracking-tight text-white">{"The gun shops, online FFLs, ranges, and brands we build for"}</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          audiences.map((a) => (
            <div class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/60 p-6">
              <h3 class="text-xl font-semibold text-white">{a.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-400">{a.body}</p>
              <p class="mt-5 text-sm" set:html={md(a.link)} />
            </div>
          ))
        }
      </div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Plans run from Minute Man at $169 a month to FFL Accelerator at $569, and setup is $500 or $2,500. See [FFL ecommerce plans](/ecommerce) for the full ladder. If you're comparing platforms, read [a side-by-side of nine FFL store platforms](/best-ffl-ecommerce-website). If you need a merchant account that allows guns, see [FFL payment processing](/ffl-payment-processing). If you need a host that allows a gun store, see [gun-friendly hosting](/gun-friendly-hosting).")} />
    </div>
  </section>

  <FaqBlock items={FAQ_HOME} heading={"The questions gun dealers ask us before they start"} />

  <section id="talk" class="border-t border-zinc-800/80 py-12">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-white">{"Tell us about the website you want and we'll make it happen."}</h2>
        <p class="mt-3 text-sm leading-relaxed text-zinc-400">{"We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time."}</p>
      </div>
      <LeadForm site="coriolisagency" defaultPillar="Ecommerce" />
    </div>
  </section>
</BaseLayout>
