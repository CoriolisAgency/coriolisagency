---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import SwitchChecklist from "../components/SwitchChecklist.astro";
import { FAQ_ORCHID } from "../lib/faq";
import { HOWTO_SWITCH_NEUTRAL } from "../lib/howto";
import { SWITCH_STEPS_NEUTRAL } from "../lib/switch";
import { linkClass } from "../lib/links";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

// Vendor facts: checked on the vendors' own sites, 2026-10-07 (SEO S4).
// No Orchid or FastBound prices are republished except POS Spark's $99/mo.
const VENDOR = {
  orchid: "https://orchidadvisors.com/",
  orchidPricing: "https://orchidadvisors.com/ffl-software-pricing/",
  posSpark: "https://orchidadvisors.com/orchid-pos-spark/",
  fastbound: "https://www.fastbound.com/",
  fastboundPricing: "https://www.fastbound.com/pricing/",
} as const;
const vendorRel = "nofollow noopener";

const BOUND_BOOK_ROWS = [
  [
    "What it is",
    "Electronic A&D bound book and e4473, from Orchid (which also sells Orchid POS, POS Spark and Orchid eCommerce)",
    "Electronic A&D bound book and e4473. FastBound says it sells compliance software only: no POS, no payments, no retail platform",
  ],
  [
    "Who it is for",
    "Gun stores, distributors and manufacturers; Orchid pitches one vendor for bound book, register and website",
    "FFLs that want the bound book separate from the register and the website",
  ],
  [
    "How it connects to a POS or store",
    "Built into Orchid POS and POS Spark; Orchid lists ERP integrations (NetSuite, Epicor and others)",
    "Published open API; FastBound lists integrations with dozens of POS, ERP and ecommerce apps",
  ],
  [
    "Where pricing is published",
    "Orchid’s own pricing page. POS Spark (POS + eCommerce) is published at $99/mo (Jan 2026 launch)",
    "FastBound’s own pricing page",
  ],
] as const;

const OWN_ROWS = [
  ["Domain", "Ask who the domain is registered to", "Registered to you; we build on it"],
  ["Content", "Ask whether you can edit and export every page", "Yours. Every page lives in your WordPress"],
  ["Titles and slugs", "Ask whether you set your own titles and URLs", "You write the H1, the title, the slug"],
  ["Schema", "Ask what structured data you control", "You control the schema on every page"],
  ["Export", "Ask for the export format for products, orders and customers", "Standard WooCommerce export"],
  ["Leaving", "Ask what you keep if you cancel", "You leave with the site, the domain and the data"],
] as const;
---

<BaseLayout
  title="Orchid alternative for your FFL website — keep eBound, own the store | Coriolis"
  description="Comparing Orchid eCommerce, POS Spark and eBound with a WooCommerce store you own. Keep the bound book you trust. We are not affiliated with Orchid."
  path="/orchid-alternative"
  ogImagePath={CANON_PATHS.rangeMckinney}
  faq={FAQ_ORCHID}
  extraJsonLd={[HOWTO_SWITCH_NEUTRAL]}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
      >
        Ecommerce · Orchid
      </p>
      <h1
        class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
      >
        Orchid alternative
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
        Orchid sells a bound book (eBound), a register (Orchid POS and POS
        Spark), and websites (Orchid eCommerce) as one stack. Coriolis builds
        the website only: WooCommerce on your domain, 21 distributor catalogs
        through FFL Cockpit, and the register you already run. Keep eBound if it
        works for you. We are not affiliated with Orchid.
      </p>
      <div class="mt-8">
        <CtaRow primary="ecommerce" showGsa={false} showAccelerator showContact />
      </div>
      <EcommerceCluster current="orchid-alternative" />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="fastbound-vs-orchid-ebound">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">FastBound vs Orchid eBound</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Both are electronic A&amp;D bound books with e4473. What follows is what
        each vendor publishes about itself, checked October 7, 2026. Read their
        pages before you pick:{" "}
        <a href={VENDOR.orchid} class={linkClass} target="_blank" rel={vendorRel}>Orchid</a>{" "}
        and{" "}
        <a href={VENDOR.fastbound} class={linkClass} target="_blank" rel={vendorRel}>FastBound</a>.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              <th class="py-3 pr-3 font-medium"></th>
              <th class="py-3 pr-3 font-medium">Orchid eBound</th>
              <th class="py-3 pr-3 font-medium">FastBound</th>
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              BOUND_BOOK_ROWS.map((row) => (
                <tr class="border-b border-zinc-800/80">
                  <th class="py-3 pr-3 font-medium text-zinc-300">{row[0]}</th>
                  <td class="py-3 pr-3">{row[1]}</td>
                  <td class="py-3 pr-3">{row[2]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Orchid eBound pricing: Orchid sets it; see{" "}
        <a href={VENDOR.orchidPricing} class={linkClass} target="_blank" rel={vendorRel}>Orchid’s pricing page</a>.
        POS Spark is published at $99/mo (Jan 2026 launch; see{" "}
        <a href={VENDOR.posSpark} class={linkClass} target="_blank" rel={vendorRel}>Orchid POS Spark</a>).
        FastBound pricing is on{" "}
        <a href={VENDOR.fastboundPricing} class={linkClass} target="_blank" rel={vendorRel}>FastBound’s pricing page</a>.
        We do not republish either fee card.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Coriolis does not sell a bound book and does not automate 4473 or NICS.
        Pick your bound book on compliance; pick your website on ownership.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="own-the-store">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        Orchid eCommerce vs a WooCommerce store you own
      </h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Orchid eCommerce is part of Orchid’s stack. A Coriolis store is
        WooCommerce on your domain. We do not republish Orchid’s fee card, and we
        do not guess at its internals. These are the ownership questions to put
        to any platform, with our answers next to them.
      </p>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              <th class="py-3 pr-3 font-medium"></th>
              <th class="py-3 pr-3 font-medium">Ask Orchid</th>
              <th class="py-3 pr-3 font-medium text-zinc-200">Coriolis WooCommerce</th>
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              OWN_ROWS.map((row) => (
                <tr class="border-b border-zinc-800/80">
                  <th class="py-3 pr-3 font-medium text-zinc-300">{row[0]}</th>
                  <td class="py-3 pr-3">{row[1]}</td>
                  <td class="py-3 pr-3 text-zinc-200">{row[2]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="pricing">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What it costs here</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        The published Coriolis ladder runs from Minute Man at $169/mo to FFL
        Accelerator at $569/mo; every tier is on the{" "}
        <a href={withBase("ecommerce")} class={linkClass}>plans page</a>. Setup
        $500 or $2,500. No annual contract. If you walk, you take the website.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="switch">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Switch without going dark</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Keep the live store until the new one is ready. Do not give notice
        first. Your bound book does not move.
      </p>
      <SwitchChecklist steps={SWITCH_STEPS_NEUTRAL} />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <p class="max-w-3xl text-sm text-zinc-400">
        Plans live on{" "}
        <a href={`${withBase("ecommerce")}#ffl-accelerator`} class={linkClass}
          >FFL ecommerce / Accelerator ($569)</a
        >. Leaving Gearfire?{" "}
        <a href={withBase("gearfire-alternative")} class={linkClass}>Gearfire alternative</a>.
        Leaving AmmoReady?{" "}
        <a href={withBase("ammoready-alternative")} class={linkClass}>AmmoReady alternative</a>.
      </p>
      <p class="max-w-3xl text-xs text-zinc-500">
        Orchid, eBound and FastBound are trademarks of their owners. We are not
        affiliated with Orchid or FastBound.
      </p>
      <CtaRow primary="ecommerce" showGsa={false} showAccelerator />
    </div>
  </section>

  <FaqBlock items={FAQ_ORCHID} />
</BaseLayout>
