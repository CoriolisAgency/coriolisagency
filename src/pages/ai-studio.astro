---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { STUDIO_PROOF } from "../lib/factory";
import { CANON_PATHS } from "../lib/site";
import { LINKS, linkClass, btnPlan, btnSecondary } from "../lib/links";
import { withBase } from "../lib/base";
import gsgHero from "../assets/gun-store-game-hero.png";

const ext = { target: "_blank", rel: "noopener noreferrer" };
---

<BaseLayout
  title="AI Studio — Build on what Coriolis already shipped | Coriolis, LLC"
  description="Coriolis AI Studio: bring the idea and the budget. Betsy AI, GunSearchAgent, Demand Intelligence, and Gun Store Game are live proof we can ship your app, platform, or agent."
  path="/ai-studio"
  ogImagePath={CANON_PATHS.gsgHero}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          AI Studio
        </p>
        <h1
          class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          You Have the Idea. We Already Shipped the Proof.
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-zinc-300">
          <a href={LINKS.betsy} class={linkClass} {...ext}>Betsy AI</a>,{" "}
          <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a>,{" "}
          <a href={LINKS.demandIntel} class={linkClass} {...ext}
            >Demand Intelligence</a
          >, and{" "}
          <a href={LINKS.gunStoreGame} class={linkClass} {...ext}
            >Gun Store Game</a
          >{" "}
          are live — not a deck. People with a budget come here when they want a
          blue-sky app, platform, or agent built by a team that already ships
          software. We are not the vibe-coding FFLs making AI promises they
          cannot keep.
        </p>
        <div class="mt-8 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
          <a href={withBase("contact")} class={btnPlan}>Talk to Coriolis</a>
          <a href={LINKS.gunStoreGame} class={btnSecondary} {...ext}
            >See Gun Store Game</a
          >
        </div>
      </div>
      <a href={LINKS.gunStoreGame} class="block min-w-0" {...ext}>
        <Image
          src={gsgHero}
          alt="Gun Store Game — a zombie bursts through the shop door. Betsy: I made you guys a game."
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="w-full min-w-0 rounded-2xl object-cover ring-1 ring-white/10 transition hover:ring-gold/50"
        />
      </a>
    </div>
  </section>

  <section class="border-b border-sky-500/25 bg-sky-950/25 py-10 sm:py-12">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-[minmax(0,16rem)_1fr]"
    >
      <img
        src={withBase(CANON_PATHS.grokBotBanner)}
        alt="Sample Grok Bot setup UI on a gun store counter."
        width="1920"
        height="1080"
        class="w-full min-w-0 max-w-[16rem]"
      />
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-300"
        >
          Setup
        </p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight text-white">
          Grok Bot setup
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-300">
          We already run on it. We will configure one Grok Bot on the Cursor
          seat you buy. One session. $995. We never rent you ours.
        </p>
        <a
          href={withBase("grok-bot-setup")}
          class={`${linkClass} mt-5 inline-flex text-sm`}
        >
          Grok Bot setup →
        </a>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.16em] text-gold"
      >
        Proof we already shipped
      </p>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400">
        Not a catalog. Evidence. Bring the brief — we execute.
      </p>
      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          STUDIO_PROOF.map((plate) => (
            <article class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {plate.urlLabel}
              </p>
              <h2 class="mt-2 text-xl font-semibold text-white">{plate.name}</h2>
              <p class="mt-3 text-sm leading-relaxed text-zinc-300">
                {plate.job}
              </p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-zinc-500">
                {plate.proof}
              </p>
              {plate.href ? (
                <a
                  href={plate.href}
                  class={`${linkClass} mt-5 text-sm`}
                  {...ext}
                >
                  {plate.cta} →
                </a>
              ) : (
                <p class="mt-5 text-xs uppercase tracking-[0.12em] text-zinc-600">
                  {plate.cta}
                </p>
              )}
            </article>
          ))
        }
      </div>
      <p class="mt-10 max-w-3xl text-sm text-zinc-500">
        Dealers start on{" "}
        <a href={LINKS.gsa} class={linkClass} {...ext}>GunSearchAgent</a>.
        Shoppers and brands start on{" "}
        <a href={LINKS.gse} class={linkClass} {...ext}>GunSearchEngine</a>.
        Betsy's home is{" "}
        <a href={LINKS.betsy} class={linkClass} {...ext}>2aBetsy</a>.
      </p>
    </div>
  </section>
</BaseLayout>
