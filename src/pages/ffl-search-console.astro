---
/**
 * SEO-U32 (b): /ffl-search-console rewrite. Copy is Brandy's FINAL (handoff/SEO-U32/FINAL.md),
 * from GSE's live copy. The old lede, the "Free today" block and the Pro block are cut.
 * One optional Pro line (Chief) matches GSE's live /pro wording.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { btnPlan, linkClass } from "../lib/links";
import { withBase } from "../lib/base";
import { FAQ_FFL_SEARCH_CONSOLE } from "../lib/faq";
import { FSC_TABS } from "../lib/fsc-tabs";
---

<BaseLayout
  title="FFL Search Console: See How Google Finds Your Gun Store | Coriolis"
  description="FFL Search Console shows the Google searches that find your gun store and what to fix this week. Read-only. Free with any GSE dealer account."
  path="/ffl-search-console"
  faq={FAQ_FFL_SEARCH_CONSOLE}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h1
        class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        FFL Search Console: see how Google finds your gun store
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-300">
        FFL Search Console is in your GunSearchEngine.com (GSE) dealer dashboard. It works with Google Search Console, it’s read-only, and it’s free with any GSE dealer account, no Pro required. Google Search Console shows how people find you on Google. FFL Search Console adds what shoppers searched for on your store and a short list of what to fix this week.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold tracking-tight text-white">Four tabs</h2>
      <ul class="mt-4 space-y-3 text-sm leading-relaxed text-zinc-300">
        {FSC_TABS.map((t) => (
          <li><strong class="text-white">{t.name}</strong> {t.body}</li>
        ))}
      </ul>

      <h2 class="mt-10 text-xl font-semibold tracking-tight text-white">How often it updates</h2>
      <p class="mt-4 text-sm leading-relaxed text-zinc-400">
        FFL Search Console pulls your Google data on a schedule: a starting baseline, then regular snapshots and updates. It isn’t a live, minute-by-minute view.
      </p>

      <h2 class="mt-10 text-xl font-semibold tracking-tight text-white">What it isn’t</h2>
      <p class="mt-4 text-sm leading-relaxed text-zinc-400">
        It doesn’t change anything in your Google account or on your website. It reads and shows, and you decide what to fix. It works alongside Google Search Console, not in place of it.
      </p>

      <p class="mt-8 text-sm leading-relaxed text-zinc-400">
        Want someone to do the SEO work for you? Coriolis does <a href={withBase("ffl-seo")} class={linkClass}>FFL SEO</a>.
      </p>

      <p class="mt-4 text-sm leading-relaxed text-zinc-400">
        <a href="https://gunsearchengine.com/pro" class={linkClass}>Want more? GunSearchEngine.com Pro is free through Dec 31, 2027 for dealers who sign up by Dec 31, 2026.</a>
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href="https://gunsearchengine.com/dealers/register?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ffl-search-console&ref=coriolis-ffl-search-console"
          class={btnPlan}
          target="_blank"
          rel="noopener noreferrer"
        >
          Create your free dealer account
        </a>
        <a
          href="https://www.gunsearchengine.com/dealers/ffl-search-console"
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer"
        >
          Already a dealer? Open FFL Search Console
        </a>
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_FFL_SEARCH_CONSOLE} />

  <section class="pb-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="text-xs leading-relaxed text-zinc-500">
        Not affiliated with Google. Google Search Console is a trademark of Google LLC.
      </p>
    </div>
  </section>
</BaseLayout>
