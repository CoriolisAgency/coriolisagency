---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import TalkSection from "../components/TalkSection.astro";
import { FAQ_COCKPIT } from "../lib/faq";
import { md } from "../lib/md";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

// CA-VOICE-P1 batch 1 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-1/ffl-cockpit.md, as drafted.
// Title and meta unchanged.
const split = ["**FFL Cockpit** handles distributor catalogs, lowest-cost routing, MAP and FFL Checkout. It's the part that runs behind your store, licensed at [fflcockpit.com](https://www.fflcockpit.com/).","**Coriolis** builds the public store your customers see: your domain, your theme, your pages. We build it, host it on WP Engine and support it, so the plugin has somewhere to sell."];
const setupSteps = ["Keep your domain. We build WooCommerce on it. If you're coming off another platform, we build first and you give notice after.","Licenses. On Militia and above, FFL Cockpit and FFL Checkout are included. Already have licenses? Bring them.","Connect your distributors. Link the houses you hold dealer accounts with. We turn on the catalogs at setup.","Set pricing rules. Your margins, what lists, and what stays off.","Turn on FFL Checkout. The buyer picks the receiving dealer. State limits show at checkout.","Turn on marketplaces. Militia lists your catalog on GunBroker.com, AmmoSeek.com and the other marketplaces on the plan.","Test a mixed cart. Buy a firearm and an accessory in one order and make sure it clears.","Point the domain. The store goes live on WP Engine."];
const compareTable = [["Item","FFL Cockpit Premium on your own WooCommerce","Coriolis Militia"],["Monthly price","$84.99/mo ([fflcockpit.com/pricing](https://fflcockpit.com/pricing/))","$269/mo ([FFL ecommerce plans](/ecommerce))"],["Sign-up or setup fee","Not listed*","Setup is $500 or $2,500"],["FFL Cockpit and FFL Checkout licenses","Included in Premium","Included"],["Distributor catalogs","See fflcockpit.com (read November 10, 2026)","21"],["Marketplaces","Included in Premium","13 listed on the plan, including GunBroker.com and AmmoSeek.com"],["Website build","Yours to build or hire","We build it on your domain"],["Hosting","Yours to buy and run","Included, on WP Engine, backed by a 99.95% uptime SLA"],["Who configures the plugin","You","We do, at setup"],["Support","FFL Cockpit for the plugin. You for the site.","Coriolis email support, 24-hour response"],["Contract","Month to month, no contracts","No contract. Cancel and the site goes with you."]];

const compare = compareTable.slice(1);

const p = "mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400";
const th = "py-3 pr-3 font-medium";
const td = "py-3 pr-3 align-top";
---

<BaseLayout
  title="FFL Cockpit Websites and Hosting Partner | Coriolis"
  description="FFL Cockpit websites from Coriolis, the hosting partner: we build and host your WooCommerce store. Militia ($269/mo) includes the Cockpit licenses."
  path="/ffl-cockpit"
  ogImagePath={CANON_PATHS.storefront}
  faq={FAQ_COCKPIT}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Ecommerce · FFL Cockpit
        </p>
        <h1
          class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          FFL Cockpit websites and WooCommerce hosting
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md("FFL Cockpit is the firearms plugin for distributor catalogs, FFL Checkout and automated dropshipping. Coriolis is a WooCommerce hosting partner: we do the FFL Cockpit setup, build the WooCommerce store it runs on, and host it, and the store is on your domain and you own it. FFL Cockpit licenses live on [fflcockpit.com](https://www.fflcockpit.com/), and on Militia and every plan above it, the licenses are included and we configure them for you.")} />
        <div class="mt-8">
          <CtaRow talk />
        </div>
        <EcommerceCluster current="ffl-cockpit" />
      </div>
      <img
        src={withBase(CANON_PATHS.storefront)}
        alt="A Coriolis-built gun store website: the storefront FFL Cockpit sells through."
        width="1600"
        height="900"
        class="w-full min-w-0 rounded-2xl object-cover ring-1 ring-white/10"
      />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Two ways to run FFL Cockpit, and who does which job"}</h2>
      <p class={p} set:html={md("You have two ways to run FFL Cockpit: license the plugin yourself and bring your own WooCommerce site and hosting, or have Coriolis build the store, set up the plugin, and host it all, and either way, the store is yours.")} />
      <ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 text-sm leading-relaxed text-zinc-400">
        {split.map((item) => <li set:html={md(item)} />)}
      </ul>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"What the FFL Cockpit plugin does, per the maker's site"}</h2>
      <p class={p} set:html={md("We last read the plugin maker's feature list on [fflcockpit.com](https://www.fflcockpit.com/) on November 10, 2026. FFL Cockpit syncs distributor catalogs to your store with images, UPCs, stock and cost, and it can push products to the price-comparison sites and marketplaces buyers shop; it runs on WooCommerce or BigCommerce, and Premium inventory sync is every 20 minutes. FFL Checkout routes serialized firearms to the buyer's chosen transfer dealer, with state limits enforced at checkout, and you set the pricing rules, including margins and what gets listed. For the plugin maker's current catalog count, marketplace count, the registers it pulls in-store stock from, and the full feature set, read [fflcockpit.com](https://www.fflcockpit.com/).")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"FFL Cockpit setup steps on a Coriolis build, in this order"}</h2>
      <ol class="mt-4 max-w-3xl list-decimal space-y-2 pl-5 text-sm leading-relaxed text-zinc-400">
        {setupSteps.map((s) => <li set:html={md(s)} />)}
      </ol>
      <p class={p} set:html={md("If you're doing it yourself, buy FFL Cockpit Premium on [fflcockpit.com](https://www.fflcockpit.com/) and install it on your own WooCommerce site. If you'd rather not run the hosting, we can take it over.")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"DIY plugin pricing versus Coriolis Militia, with list prices read November 10, 2026"}</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-zinc-500">
              <th class={th}><span class="sr-only">{compareTable[0][0]}</span></th>
              <th class={th}>{compareTable[0][1]}</th>
              <th class={`${th} text-zinc-200`}>{compareTable[0][2]}</th>
            </tr>
          </thead>
          <tbody class="text-zinc-400">
            {
              compare.map(([k, diy, coriolis]) => (
                <tr class="border-b border-zinc-800/80">
                  <th class={`${td} font-medium text-zinc-300`}>{k}</th>
                  <td class={td} set:html={md(diy)} />
                  <td class={`${td} text-zinc-200`} set:html={md(coriolis)} />
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 max-w-3xl text-xs leading-relaxed text-zinc-500" set:html={md("*Not listed on the source page we read November 10, 2026.")} />
      <p class={p} set:html={md("Minute Man ($169/mo) is own-inventory WooCommerce without the Cockpit licenses, while Militia ($269/mo), Gun Runner ($369/mo), Warlord ($469/mo) and FFL Accelerator ($569/mo) all include them. If you want us to run more of it, FFL Accelerator adds WordPress and plugin updates, backups, managed email and analytics monitoring; see [FFL ecommerce plans](/ecommerce).")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Connecting a register you already run, and listing the catalog on marketplaces"}</h2>
      <p class={p} set:html={md("Connecting a register and listing the catalog on marketplaces are two different jobs. FFL Cockpit Premium can merge your in-store stock with distributor products in one catalog, and the plugin maker publishes which registers it pulls from on [fflcockpit.com](https://www.fflcockpit.com/); that's their feature, the list can change, and you should check fflcockpit.com for the current list.")} />
      <p class={p} set:html={md("On Warlord and FFL Accelerator, we connect the register you already run to your WooCommerce store through an API, so the counter and the site share one inventory. That covers AIM, MicroBiz, Rapid Gun Systems, Trident 1 and any POS that works with WooCommerce; see [connecting the register you already run](/gun-store-pos).")} />
      <p class={p} set:html={md("Militia and above list your catalog on 13 marketplaces: GunBroker.com, AmmoSeek.com, Gun.Deals, WikiArms.com, AmmoBuy.com, ArmsAgora.com, GunAmmo.deals, AmmoBrowser.com, GunMade.com, CaliberKing.com, BulletScout.com, Guns.com and BulletBlaster.com.")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"If you already have FFL Cockpit and want a better store in front of it"}</h2>
      <p class={p} set:html={md("The usual job is that you already have the plugin and want a better store in front of it. We build custom WooCommerce on your domain, configure Cockpit, and host and support it. If you want more guns online without more on the shelf, add [FFL dropshipping](/firearms-dropshipping), and it all runs on your [FFL website design](/ecommerce), so your catalog and orders stay in one place.")} />
      <p class={p} set:html={md("Every Coriolis store runs on WP Engine, backed by WP Engine's 99.95% uptime SLA, with unlimited hosting on every plan, and Coriolis is a WP Engine agency partner. How hosting works on every plan is on [gun-friendly hosting](/gun-friendly-hosting).")} />
      <div class="mt-6">
        <CtaRow primary="ecommerce" />
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_COCKPIT} heading={"The questions gun dealers ask us about FFL Cockpit setup and hosting"} />

  <section class="border-t border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class={p} set:html={md("Coriolis doesn't own FFL Cockpit; it is a separate company, and its marks belong to it, and we build and host the WooCommerce stores it runs on.")} />
    </div>
  </section>

  <TalkSection heading={"Tell us about the website you want and we'll make it happen."} subline={"We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time."} contact={"You can also reach us at [(279) 258-6771](tel:+12792586771) or [support@coriolisagency.com](mailto:support@coriolisagency.com)."} />
</BaseLayout>
