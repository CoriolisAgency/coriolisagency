---
import BaseLayout from "../layouts/BaseLayout.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import PosHero from "../components/PosHero.astro";
import TalkSection from "../components/TalkSection.astro";
import {
  POS_PAGES,
  posBreadcrumbList,
  posBySlug,
  type PosInline,
} from "../lib/pos";
import { LINKS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";

export function getStaticPaths() {
  return POS_PAGES.map((page) => ({ params: { pos: page.slug } }));
}

const page = posBySlug(Astro.params.pos ?? "");
if (!page) {
  throw new Error(`Unknown POS slug: ${Astro.params.pos}`);
}

const ext = { target: "_blank", rel: "noopener noreferrer" };
const siblings = POS_PAGES.filter((p) => p.slug !== page.slug);

function inlineHref(part: Exclude<PosInline, string>) {
  if (part.href.startsWith("http")) return part.href;
  return withBase(part.href);
}

function isExternal(part: Exclude<PosInline, string>) {
  return Boolean(part.external) || part.href.startsWith("http");
}
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.path}
  ogImagePath={page.heroImage.src}
  faq={page.faq}
  extraJsonLd={[posBreadcrumbList(LINKS.home, page)]}
>
  <PosHero
    eyebrow="Gun Store POS"
    h1={page.h1}
    lede={page.lede}
    jumpLabel={page.jumpLabel}
    image={page.heroImage}
  />

  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
    <EcommerceCluster current="ecommerce" />
  </div>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{page.featuresTitle}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        {page.featuresIntro}
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          page.features.map((card) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <h3 class="text-base font-semibold text-white">{card.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-zinc-400">{card.body}</p>
            </article>
          ))
        }
      </div>
      {
        page.docsHref && page.docsLabel && (
          <p class="mt-6 max-w-3xl text-sm leading-relaxed text-zinc-400">
            {page.docsLead}
            <a href={page.docsHref} class={linkClass} {...ext}>
              {page.docsLabel}
            </a>
          </p>
        )
      }
    </div>
  </section>

  {
    page.featuresMore && page.featuresMoreTitle && (
      <section class="border-b border-zinc-800/80 py-12">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <h2 class="text-xl font-semibold text-white">{page.featuresMoreTitle}</h2>
          <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
            {page.featuresMore.map((card) => (
              <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
                <h3 class="text-base font-semibold text-white">{card.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-zinc-400">{card.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    page.onlineRange && (
      <section class="border-b border-zinc-800/80 py-12">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <h2 class="text-xl font-semibold text-white">{page.onlineRange.title}</h2>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
            {page.onlineRange.body}
          </p>
        </div>
      </section>
    )
  }

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Keep the register</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        {page.keepRegister}
      </p>
      {
        page.extra && (
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
            {page.extra.map((part) =>
              typeof part === "string" ? (
                part
              ) : (
                <a
                  href={inlineHref(part)}
                  class={linkClass}
                  {...(isExternal(part) ? ext : {})}
                >
                  {part.text}
                </a>
              ),
            )}
          </p>
        )
      }
      {
        page.vendorHref ? (
          <p class="mt-4 text-sm text-zinc-500">
            Vendor site:{" "}
            <a href={page.vendorHref} class={linkClass} {...ext}>
              {page.vendorHref.replace("https://", "")}
            </a>
            . Marks of their owners.
          </p>
        ) : (
          <p class="mt-4 text-sm text-zinc-500">{page.vendorNote}</p>
        )
      }
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{page.caseStudy.shop}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        {page.caseStudy.placeholder}
      </p>
      {
        page.caseStudy.href && page.caseStudy.linkLabel && (
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
            {page.caseStudy.linkLead}
            <a href={withBase(page.caseStudy.href)} class={linkClass}>
              {page.caseStudy.linkLabel}
            </a>
            .
          </p>
        )
      }
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">The other registers</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        {
          page.siblingsIntro.map((part) =>
            typeof part === "string" ? (
              part
            ) : (
              <a href={withBase(part.href)} class={linkClass}>
                {part.text}
              </a>
            ),
          )
        }
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          siblings.map((p) => (
            <li>
              <a href={withBase(p.slug)} class={linkClass}>
                {p.navLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm text-zinc-400">
        {
          page.linksLead.map((part) =>
            typeof part === "string" ? (
              part
            ) : (
              <a href={withBase(part.href)} class={linkClass}>
                {part.text}
              </a>
            ),
          )
        }
      </p>
    </div>
  </section>

  <FaqBlock items={page.faq} />

  <TalkSection />
</BaseLayout>
