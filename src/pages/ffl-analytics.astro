---
import BaseLayout from "../layouts/BaseLayout.astro";
import { btnPlan } from "../lib/links";
---

<BaseLayout
  title="FFL Analytics: Search Analytics for FFL Websites | Coriolis"
  description="See what shoppers search for on your gun store's website and what they couldn't find. Free with a Gun Search Engine dealer account. Works alongside Google Analytics."
  path="/ffl-analytics"
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h1
        class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Understand your gun store's website
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-300">
        See what shoppers search for on your site and what they couldn't find.
        FFL Analytics is free with a Gun Search Engine dealer account.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold tracking-tight text-white">Free today</h2>
      <ul
        class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-zinc-300"
      >
        <li>What shoppers typed into your site search</li>
        <li>What they searched for but couldn't find (searches with no results)</li>
        <li>The 6:30 AM morning email summarizing yesterday's searches</li>
        <li>Referrers: which sites sent the visitors who searched</li>
      </ul>

      <p class="mt-8 text-sm leading-relaxed text-zinc-400">
        Works alongside Google Analytics. Google Analytics shows how many people
        visited. FFL Analytics shows what they were looking for.
      </p>

      <div class="mt-8 rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
        <h2 class="text-xl font-semibold tracking-tight text-white">Pro</h2>
        <p class="mt-3 text-sm leading-relaxed text-zinc-300">
          Free through December 31, 2026.
        </p>
        <ul
          class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-zinc-300"
        >
          <li>Monthly Demand Intelligence reports</li>
          <li>More Pro features are on the way.</li>
        </ul>
      </div>

      <a
        href="https://gunsearchengine.com/dealers/register?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ffl-analytics&ref=coriolis-ffl-analytics"
        class={`${btnPlan} mt-8`}
      >
        Create a free dealer account
      </a>

      <p class="mt-8 text-xs leading-relaxed text-zinc-500">
        Not affiliated with Google. Google Analytics is a trademark of Google LLC.
      </p>
    </div>
  </section>
</BaseLayout>
