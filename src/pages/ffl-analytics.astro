---
import BaseLayout from "../layouts/BaseLayout.astro";
import { btnPlan } from "../lib/links";
---

<BaseLayout
  title="FFL Analytics: Search Analytics for FFL Websites | Coriolis"
  description="See what shoppers search for on your gun store's website and what they couldn't find. Free with a GunSearchEngine.com dealer account. Works alongside Google Analytics."
  path="/ffl-analytics"
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h1
        class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Understand your gun store's website
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-300">
        See what shoppers search for on your site and what they couldn't find.
        FFL Analytics is free with a GunSearchEngine.com dealer account.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold tracking-tight text-white">Free today</h2>
      <ul
        class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-zinc-300"
      >
        <li>What shoppers typed into your site search</li>
        <li>What they searched for but couldn't find (searches with no results)</li>
        <li>The 6:30 AM morning email summarizing yesterday's searches</li>
        <li>Referrers: which sites sent the visitors who searched</li>
      </ul>

      <p class="mt-8 text-sm leading-relaxed text-zinc-400">
        Works alongside Google Analytics. Google Analytics shows how many people
        visited. FFL Analytics shows what they were looking for.
      </p>

      <div
        class="relative mt-8 overflow-hidden rounded-2xl border border-gold/60 bg-black p-6 shadow-[0_18px_48px_-20px_rgba(200,150,12,0.55)] sm:p-8"
        data-pro-plate
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-gold to-transparent"
        ></div>
        <h2
          class="inline-flex items-center rounded-sm bg-gold px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-black"
        >
          Pro
        </h2>
        <p class="mt-4 text-base font-semibold leading-relaxed text-white">
          Sign up by Dec 31, 2026 and get Pro free through Dec 31, 2027. $99/month after that.
        </p>
        <ul class="mt-5 space-y-3 text-sm leading-relaxed text-zinc-200">
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-px shrink-0 font-semibold text-gold">✓</span>
            <span
              >Monthly Demand Intelligence reports{" "}
              <a
                href="/images/ffl-demand-intelligence-sample-august-2026.png"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-gold underline decoration-gold/60 underline-offset-2 hover:text-[#e0a910]"
                >(see sample)</a
              ></span
            >
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-px shrink-0 font-semibold text-gold">✓</span>
            <span>Sightline embed with custom styling{" "}
              <span class="text-zinc-400">(the Free plan gets the standard Sightline embed)</span></span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-px shrink-0 font-semibold text-gold">✓</span>
            <span>OtterText integration for Sightline alerts{" "}
              <span class="text-zinc-400">(uses your own OtterText account)</span></span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-px shrink-0 font-semibold text-gold">✓</span>
            <span>Pro (Verified) status on GunSearchEngine.com{" "}
              <span
                class="ml-1 inline-flex rounded-sm border border-gold/60 px-1.5 py-0.5 align-middle text-[11px] font-semibold uppercase tracking-[0.12em] text-gold"
                >Coming soon</span
              ></span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-px shrink-0 font-semibold text-gold">✓</span>
            <span>All future Pro features</span>
          </li>
        </ul>
      </div>

      <a
        href="https://gunsearchengine.com/dealers/register?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ffl-analytics&ref=coriolis-ffl-analytics"
        class={`${btnPlan} mt-8`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Create a free dealer account
      </a>

      <p class="mt-8 text-xs leading-relaxed text-zinc-500">
        Not affiliated with Google. Google Analytics is a trademark of Google LLC.
      </p>
    </div>
  </section>
</BaseLayout>
