---
import BaseLayout from "../layouts/BaseLayout.astro";
import { btnPlan } from "../lib/links";
import TalkSection from "../components/TalkSection.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_FFL_ANALYTICS } from "../lib/faq";
import { md } from "../lib/md";

// CA-VOICE-P1 batch 5 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-5/ffl-analytics.md, shipped as drafted.
const mdLink = (s: string) => {
  const m = s.match(/^\[([^\]]+)\]\(([^)\s]+)\)$/);
  if (!m) throw new Error("not a single link: " + s);
  return { text: m[1], href: m[2] };
};
const signup = mdLink("[Create a free dealer account](https://www.gunsearchengine.com/dealers/register?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ffl-analytics&utm_content=dealer-register-footer)");
---

<BaseLayout
  faq={FAQ_FFL_ANALYTICS}
  title="FFL Analytics: Search Analytics for FFL Websites | Coriolis"
  description="See what shoppers search for on your gun store's website and what they couldn't find. Free with a GunSearchEngine.com dealer account. Works alongside Google Analytics."
  path="/ffl-analytics"
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h1
        class="text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Understand your gun store's website
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-300" set:html={md("FFL Analytics shows what shoppers searched for on your gun store's website, including the searches that found nothing. It's free with any [GunSearchEngine.com](https://www.gunsearchengine.com/?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ffl-analytics&utm_content=consumer-search) (GSE) dealer account, including free GSE Basic, with no Pro required. [Create a free dealer account](https://www.gunsearchengine.com/dealers/register?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ffl-analytics&utm_content=dealer-register)")} />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold tracking-tight text-white">{"What the report covers"}</h2>
      <p class="mt-4 text-sm leading-relaxed text-zinc-400" set:html={md("Once the GSE script is on your website, the dashboard shows what shoppers typed into your site search, the searches that returned no results, and which sites sent the visitors who searched. You don't have to list any inventory on GunSearchEngine.com to use it.")} />
      <p class="mt-4 text-sm leading-relaxed text-zinc-400" set:html={md("A morning email, around 6:30 AM Eastern, summarizes the last 24 hours: sessions, searches, and the top calibers, brands and types shoppers looked for. Turn it on in your dealer settings once the script is running.")} />
      <p class="mt-4 text-sm leading-relaxed text-zinc-400" set:html={md("Google Analytics stays the traffic count, so run both side by side. FFL Analytics isn't affiliated with Google. Google Analytics is a trademark of Google LLC.")} />
      <p class="mt-4 text-sm leading-relaxed text-zinc-400" set:html={md("The same free GSE Basic account also includes premium SEO backlinks and a dedicated Seller page on GunSearchEngine.com. The weekly fix list and the Google searches that find you are in [FFL Search Console](/ffl-search-console).")} />

      <h2 class="mt-10 text-xl font-semibold tracking-tight text-white">{"GSE Pro, which is optional"}</h2>

      <div
        class="relative mt-8 overflow-hidden rounded-2xl border border-gold/60 bg-black p-6 shadow-[0_18px_48px_-20px_rgba(200,150,12,0.55)] sm:p-8"
        data-pro-plate
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-gold to-transparent"
        ></div>
        <p
          class="inline-flex items-center rounded-sm bg-gold px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-black"
        >
          Pro
        </p>
        <p class="mt-4 text-base font-semibold leading-relaxed text-white" set:html={md("GSE Pro is optional. Coriolis quotes Pro at $99 a month. [GSE Pro](https://www.gunsearchengine.com/pro?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ffl-analytics&utm_content=gse-pro), read November 10, 2026, says: \"Activate by Dec 31, 2026 and get Pro free through Dec 31, 2027.\"")} />
        <p class="mt-4 text-sm leading-relaxed text-zinc-200" set:html={md("Pro adds monthly Demand Intelligence reports ([see sample](/images/ffl-demand-intelligence-sample-august-2026.png)), a Sightline embed with custom styling (the Free plan gets the standard Sightline embed), OtterText integration for Sightline alerts (uses your own OtterText account), and Pro (Verified) status on GunSearchEngine.com.")} />
      </div>

      <a href={signup.href} class={`${btnPlan} mt-8`} target="_blank" rel="noopener noreferrer">{signup.text}</a>
    </div>
  </section>

  <FaqBlock items={FAQ_FFL_ANALYTICS} heading={"Questions we get"} />

  <TalkSection heading={"Tell us about the website you want and we'll make it happen."} subline={"We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time."} />
</BaseLayout>
