//   title        = Brandy's title, cleared by Karp 5:18 PM ET 2026-11-27 (TITLE-META-FINAL.md, sha8 fcfc6565). The string already
//                  ends in " | Coriolis" and BaseLayout does not append a suffix, so it is passed whole.
//   description  = Brandy's meta description, same clearance, verbatim.
//   H1           = "The five monthly plans, from Minute Man through FFL Accelerator" (HostingPlansSection headingTag="h1"), cleared verbatim.
import BaseLayout from "../layouts/BaseLayout.astro";
import HostingPlansSection from "../components/HostingPlansSection.astro";
import SetupPackagesSection from "../components/SetupPackagesSection.astro";
