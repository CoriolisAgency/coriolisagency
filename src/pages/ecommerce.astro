---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_ECOMMERCE } from "../lib/faq";
import { LINKS, linkClass, btnPlan, btnSecondary } from "../lib/links";
import { CAPABILITIES, PLANS, SETUP } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const checkout = {
  checkoutBasic: LINKS.checkoutBasic,
  checkoutRetail: LINKS.checkoutRetail,
} as const;
---

<BaseLayout
  title="FFL Ecommerce Plans — WooCommerce + FFL Cockpit | Coriolis"
  description="WooCommerce and FFL Cockpit hosting for FFLs. Minute Man $169 through FFL Accelerator $569. Setup $500 or $2,500. The site is yours. Betsy on it is included."
  path="/ecommerce"
  ogImagePath={CANON_PATHS.rangeMckinney}
  faq={FAQ_ECOMMERCE}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          Ecommerce
        </p>
        <h1
          class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          WooCommerce and FFL Cockpit hosting for FFLs
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
          We build, host, support, and promote ATF-aware WooCommerce for
          online-only FFLs, gun stores, shooting ranges, and firearms brands. Sell your
          inventory, dropship from distributor catalogs, or both.
        </p>
        <div class="mt-8">
          <CtaRow />
        </div>
        <EcommerceCluster current="ecommerce" />
      </div>
      <a
        href="https://store.therangeinmckinney.com/"
        class="block min-w-0"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={withBase(CANON_PATHS.rangeMckinney)}
          alt="The Range in McKinney — a Coriolis FFL ecommerce site. Browse and buy online, pick up in store."
          width="1283"
          height="965"
          class="w-full min-w-0 rounded-2xl object-contain ring-1 ring-white/10 bg-[#111] transition hover:ring-gold/50"
        />
      </a>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="setup">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">One-time setup</h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        Pay for setup online. Monthly hosting starts after we talk.
      </p>
      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          SETUP.map((s) => (
            <article class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {s.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{s.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-white">
                ${s.price.toLocaleString()}
                <span class="text-sm font-medium text-zinc-500"> one time</span>
              </p>
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {s.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a
                href={checkout[s.checkoutKey]}
                class={`${btnPlan} mt-6`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Buy {s.name}
              </a>
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-xs leading-relaxed text-zinc-500">
        By subscribing to any plan or purchasing any setup package you agree to
        the{" "}
        <a href={LINKS.msa} class={linkClass}>Master Services Agreement</a>.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="plans">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-xl font-semibold text-white">Monthly plans</h2>
          <p class="mt-2 max-w-2xl text-sm text-zinc-400">
            Each plan includes everything in the one below it. Monthly hosting
            starts after we talk. We set the site up with you.
          </p>
        </div>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-5">
        {
          PLANS.map((plan) => (
            <article
              class:list={[
                "flex flex-col rounded-2xl border p-5",
                plan.featured
                  ? "border-gold/60 bg-gold/5 lg:col-span-1"
                  : "border-zinc-800 bg-zinc-950/50",
              ]}
            >
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {plan.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{plan.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${plan.price}
                <span class="text-sm font-medium text-zinc-500">/mo</span>
              </p>
              {plan.includesFrom && (
                <p class="mt-2 text-xs text-zinc-500">
                  Everything in {plan.includesFrom} +
                </p>
              )}
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              {plan.featured && (
                <a
                  href={LINKS.fflaccelerator}
                  class={`${linkClass} mt-4 text-sm`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  FFL Accelerator program →
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What the store can do</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          CAPABILITIES.map((c) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <h3 class="text-sm font-semibold text-sky-300">{c.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400">{c.body}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-zinc-500">
        FFL Cockpit and FFL Checkout licenses live on{" "}
        <a
          href={LINKS.fflCockpit}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">fflcockpit.com</a
        >. We configure them as part of setup.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <div class="flex flex-col gap-2.5 sm:flex-row">
        <a href={withBase("contact")} class={btnPlan}>Talk to Coriolis</a>
        <a href="#setup" class={btnSecondary}>See setup packages</a>
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_ECOMMERCE} />
</BaseLayout>
