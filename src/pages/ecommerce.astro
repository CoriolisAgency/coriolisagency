---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_ECOMMERCE } from "../lib/faq";
import { HOWTO_SWITCH, HOWTO_WOO_SELL_GUNS } from "../lib/howto";
import { POS_PAGES } from "../lib/pos";
import { LINKS, linkClass, btnPlan } from "../lib/links";
import { PLANS, SETUP } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const switchSteps = [
  "Keep your domain. We build the new WooCommerce store on it before you give notice.",
  "Move the catalog you care about (your stock, the distributor feeds, or both) and redirect the pages that already rank.",
  "Turn on FFL Checkout, payments, and tax. Buy a mixed cart yourself and make sure it clears.",
  "Connect the register only if you want the counter and the site to share inventory.",
  "Point the domain. You leave with the site.",
] as const;
---

<BaseLayout
  title="FFL Ecommerce Website Builder & Plans for Gun Stores | Coriolis"
  description="FFL ecommerce websites you own: WooCommerce + FFL Cockpit, published plans from $169/mo, setup $500 or $2,500. Dealer website, dropshipping, and the register you already run."
  path="/ecommerce"
  ogImagePath={CANON_PATHS.rangeMckinney}
  faq={FAQ_ECOMMERCE}
  extraJsonLd={[HOWTO_SWITCH, HOWTO_WOO_SELL_GUNS]}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          FFL ecommerce
        </p>
        <h1
          class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          FFL ecommerce website builder and plans
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
          This is the Coriolis FFL ecommerce page: dealer website, builder, and
          published pricing. Most gun store “websites” are template platforms
          you don’t control. AmmoReady and Gearfire put your inventory on pages
          you don’t own — same templates, ads you can’t strip, titles and slugs
          you don’t write. Coriolis replaces that with WooCommerce on your
          domain: sell what’s on the shelf, dropship from twenty-one
          distributors, or both. Works with AIM, MicroBiz, Rapid Gun Systems,
          Trident 1, and Corestore. Monthly plans start at Minute Man $169.
          FFL Accelerator is $569. Setup is $500 or $2,500. All plans include{" "}
          <a href={LINKS.gsa} class={linkClass} target="_blank" rel="noopener noreferrer">GunSearchAgent.com</a> Pro.
        </p>
        <div class="mt-8">
          <CtaRow showGsa={false} />
        </div>
        <EcommerceCluster current="ecommerce" />
      </div>
      <a
        href="https://store.therangeinmckinney.com/"
        class="block w-full min-w-0 overflow-hidden rounded-2xl ring-1 ring-white/10 transition hover:ring-gold/50"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={withBase(CANON_PATHS.rangeMckinney)}
          alt="A live Coriolis FFL ecommerce site. Browse and buy online, pick up in store. Opens in a new tab."
          width="1283"
          height="965"
          class="w-full min-w-0 object-contain bg-[#111]"
        />
      </a>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="plans">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">
        {
          PLANS.map((plan) => (
            <article
              id={plan.id}
              class:list={[
                "flex scroll-mt-24 flex-col rounded-2xl border p-5",
                plan.featured
                  ? "border-gold/60 bg-gold/5 lg:col-span-1"
                  : "border-zinc-800 bg-zinc-950/50",
              ]}
            >
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {plan.featured ? "Most Popular" : plan.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{plan.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${plan.price}
                <span class="text-sm font-medium text-zinc-500">/mo</span>
              </p>
              {plan.includesFrom ? (
                <p class="mt-2 text-xs text-zinc-500">
                  Everything in {plan.includesFrom} +
                </p>
              ) : null}
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="setup">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        FFL Website Setup Packages
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          SETUP.map((s) => (
            <article class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {s.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{s.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${s.price.toLocaleString()}
                <span class="text-sm font-medium text-zinc-500"> one-time</span>
              </p>
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {s.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a
                href={LINKS[s.checkoutKey]}
                class={`${btnPlan} mt-6`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.name}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="scroll-mt-24 border-b border-zinc-800/80 py-12"
    id="replace-template-website"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        Replace a template website with one that works
      </h2>
      <div class="mt-4 max-w-3xl space-y-4 text-sm leading-relaxed text-zinc-400">
        <p>
          If your website is covered in ads you can’t remove, it’s not your
          website. AmmoReady and Gearfire run template storefronts: inventory
          changes, the page does not; you don’t control the title, the slugs, or
          the copy; you’re in the same HTML race as every other dealer on that
          platform. Coriolis is not affiliated with Gearfire or RetailBI.
        </p>
        <p>
          Keep the register you already run. We replace the website. WooCommerce
          can sell guns when a licensed FFL owns the store and checkout is built
          for dealer transfer — see the questions below. That is not a second
          URL. Old “can you use WooCommerce to sell guns” and “is WooCommerce
          good for firearms” posts 301 here.
        </p>
        <p>Switch, in order:</p>
      </div>
      <ol
        class="mt-4 max-w-3xl list-decimal space-y-2 pl-5 text-sm leading-relaxed text-zinc-400"
      >
        {switchSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="pos">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Keep your POS</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Warlord ($469/mo) and FFL Accelerator ($569/mo) connect the register you
        already run. One page per register. No fake screenshots.
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          POS_PAGES.map((p) => (
            <li>
              <a href={withBase(p.slug)} class={linkClass}>
                {p.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="woocommerce">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        WooCommerce for firearms
      </h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Yes — when the dealer is a licensed FFL and checkout is built for
        transfer. Serialized firearms ship FFL-to-FFL. You write the titles and
        slugs. Coriolis does not run 4473, NICS, or the bound book. This is not
        legal advice. Shopify is a different platform; we do not sell a Shopify
        gun-store product. See{" "}
        <a href={withBase("woocommerce-vs-shopify-for-gun-stores")} class={linkClass}
          >WooCommerce vs Shopify for gun stores</a
        >.
      </p>
    </div>
  </section>

  <FaqBlock items={FAQ_ECOMMERCE} />

  <section class="border-b border-zinc-800/80 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-500">
        By subscribing to any plan or purchasing any setup package you are
        agreeing to the terms of our{" "}
        <a href={withBase("msa")} class={linkClass}>Master Services Agreement</a
        >.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <CtaRow showGsa={false} />
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
        Our Founder and CEO is the guy that built and ran AmmoReady.com for 9
        years.
      </p>
    </div>
  </section>
</BaseLayout>
