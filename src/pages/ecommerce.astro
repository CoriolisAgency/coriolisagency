---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_ECOMMERCE } from "../lib/faq";
import { LINKS, linkClass, btnPlan } from "../lib/links";
import { PLANS, SETUP } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

const switchSteps = [
  "Keep your domain. We build the new WooCommerce store on it before you give notice.",
  "Move the catalog you care about (your stock, the distributor feeds, or both) and redirect the pages that already rank.",
  "Turn on FFL Checkout, payments, and tax. Buy a mixed cart yourself and make sure it clears.",
  "Connect the register only if you want the counter and the site to share inventory.",
  "Point the domain. You leave with the site.",
] as const;
---

<BaseLayout
  title="WooCommerce and FFL Cockpit hosting for FFLs | Coriolis"
  description="Most gun stores do not own their website. Coriolis builds WooCommerce on your domain. FFL Accelerator is $569 a month."
  path="/ecommerce"
  ogImagePath={CANON_PATHS.rangeMckinney}
  faq={FAQ_ECOMMERCE}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          FFL ecommerce
        </p>
        <h1
          class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          WooCommerce and FFL Cockpit hosting for FFLs
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300">
          Most gun stores do not own their website. They rent a catalog, hope
          the platform ranks, and find out too late that they cannot take the
          shop with them. Coriolis builds WooCommerce on your domain and runs
          it with you. You sell what is on the shelf, you dropship from
          twenty-one distributors, or you do both. The plan built for that is
          FFL Accelerator.
        </p>
        <div class="mt-8">
          <CtaRow showGsa={false} showAccelerator />
        </div>
        <p class="mt-6 text-sm text-zinc-500">
          <a href="#setup" class={linkClass}>FFL Website Setup Packages</a>
        </p>
        <EcommerceCluster current="ecommerce" />
      </div>
      <a
        href="https://store.therangeinmckinney.com/"
        class="block w-full min-w-0 overflow-hidden rounded-2xl ring-1 ring-white/10 transition hover:ring-gold/50"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={withBase(CANON_PATHS.rangeMckinney)}
          alt="A live Coriolis FFL ecommerce site. Browse and buy online, pick up in store. Opens in a new tab."
          width="1283"
          height="965"
          class="w-full min-w-0 object-contain bg-[#111]"
        />
      </a>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="plans">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">
        {
          PLANS.map((plan) => (
            <article
              id={plan.id}
              class:list={[
                "flex scroll-mt-24 flex-col rounded-2xl border p-5",
                plan.featured
                  ? "border-gold/60 bg-gold/5 lg:col-span-1"
                  : "border-zinc-800 bg-zinc-950/50",
              ]}
            >
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {plan.featured ? "Most Popular" : plan.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{plan.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${plan.price}
                <span class="text-sm font-medium text-zinc-500">/mo</span>
              </p>
              {plan.includesFrom ? (
                <p class="mt-2 text-xs text-zinc-500">
                  Everything in {plan.includesFrom} +
                </p>
              ) : null}
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {plan.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="setup">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        FFL Website Setup Packages
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          SETUP.map((s) => (
            <article class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {s.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{s.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${s.price.toLocaleString()}
                <span class="text-sm font-medium text-zinc-500"> one-time</span>
              </p>
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {s.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a
                href={LINKS[s.checkoutKey]}
                class={`${btnPlan} mt-6`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.name}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="scroll-mt-24 border-b border-zinc-800/80 py-12"
    id="leave-a-rented-storefront"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Leave a rented storefront</h2>
      <div class="mt-4 max-w-3xl space-y-4 text-sm leading-relaxed text-zinc-400">
        <p>
          AmmoReady and Gearfire rent you a catalog. Inventory changes; the page
          does not. You do not control title, slugs, or copy. Coriolis is not
          affiliated with Gearfire or RetailBI.
        </p>
        <p>Switch, in order:</p>
      </div>
      <ol
        class="mt-4 max-w-3xl list-decimal space-y-2 pl-5 text-sm leading-relaxed text-zinc-400"
      >
        {switchSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <FaqBlock items={FAQ_ECOMMERCE} />

  <section class="border-b border-zinc-800/80 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-500">
        By subscribing to any plan or purchasing any setup package you are
        agreeing to the terms of our{" "}
        <a href={withBase("msa")} class={linkClass}>Master Services Agreement</a
        >.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <CtaRow showGsa={false} showAccelerator />
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
        Our Founder and CEO is the guy that built and ran AmmoReady.com for 9
        years.
      </p>
    </div>
  </section>
</BaseLayout>
