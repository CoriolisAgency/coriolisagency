---
import BaseLayout from "../layouts/BaseLayout.astro";
import BulletList from "../components/BulletList.astro";
import CtaRow from "../components/CtaRow.astro";
import EcommerceCluster from "../components/EcommerceCluster.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_ECOMMERCE } from "../lib/faq";
import { HOWTO_SWITCH, HOWTO_WOO_SELL_GUNS } from "../lib/howto";
import { POS_PAGES } from "../lib/pos";
import { LINKS, linkClass, btnPlan } from "../lib/links";
import { PLANS, SETUP, type PlanId } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
import { md } from "../lib/md";
import { TRUSTINDEX_REVIEWS_HREF } from "../lib/google-reviews";

const PLAN_TAGLINE_EMOJI: Record<PlanId, string> = {
  "minute-man": "📦",
  militia: "🚚",
  "gun-runner": "🎧",
  warlord: "🏪",
  "ffl-accelerator": "🔥",
};

// CA-VOICE-P1 batch 1 (Paul yes via Chief, 2026-11-10 12:49 PM ET): copy from batch-1/ecommerce.md, as drafted.
// Plan cards and setup packages stay as template blocks (plans.ts).
const buildIncludes = ["**Your domain.** The store lives on your domain, and it stays yours if you leave.","**FFL Checkout.** The buyer picks the receiving dealer at checkout, and serialized guns route to that FFL. We configure it at setup. The license is included on Militia and above.","**Distributor catalogs.** FFL Cockpit puts 21 distributor catalogs on your store, with inventory updates every 20 minutes, included on Militia and above. See [FFL dropshipping](/firearms-dropshipping).","**Firearm-friendly payments.** We install and test a payment gateway tied to a merchant account approved for firearms. We work with GOAT Payments and Payroc, or you can bring your own. See [FFL payment processing](/ffl-payment-processing).","**Migration with redirects.** If you're coming off another platform, we build on your domain before you give notice, move the catalog you care about, and redirect the pages that already rank.","**Gun-friendly hosting.** Every store runs on WP Engine, backed by a 99.95% uptime SLA. See [gun-friendly hosting](/gun-friendly-hosting).","**GunSearchEngine.com.** Your inventory goes on [GunSearchEngine.com](https://www.gunsearchengine.com/?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ecommerce&utm_content=gse-free-plan) on the free plan."];

const caseStudies = ["[Naples Gun Shop](/case-studies/naples-gun-shop). A full-line gun shop, with the store connected to AIM POS.","[Allegheny Arms](/case-studies/allegheny-arms). An online store with a big catalog shoppers filter by category, brand, price and stock.","[Target Shotguns](/case-studies/target-shotguns). A shotgun specialist on MicroBiz POS, with drop ship items kept apart from in-store stock."];

const newClients = ["[Tier 1 Kinetics](https://tier1kinetics.com/). A rifle maker, with house builds up front and a full retail catalog behind them.","[Jim's Armory](https://jimsarmory.com/). The store behind the [Jim's Armory YouTube channel](https://www.youtube.com/@JimsArmory), with a blog post for each video.","[Green Mountain Sporting Goods](https://gmsgvt.com/). A family outfitter in Vermont, with a page for each in-house service.","[Guardian Guns & Ammo](https://gstny.com/). A New York retailer and training center, with online class registration."];

const switchSteps = ["Keep your domain. We build the new WooCommerce store on it before you give notice.","Move the catalog you care about (your stock, the distributor feeds, or both) and redirect the pages that already rank.","Turn on FFL Checkout, payments, and tax. Buy a mixed cart yourself and make sure it clears.","Connect the register only if you want the counter and the site to share inventory.","Point the domain. You leave with the site."];
import TalkSection from "../components/TalkSection.astro";
---

<BaseLayout
  title="FFL Website Design and Ecommerce for Gun Stores | Coriolis"
  description="FFL website design you own: WooCommerce on your domain. Plans from $169/mo, setup $500 or $2,500. Add dropshipping or the register you already run."
  path="/ecommerce"
  ogImagePath={CANON_PATHS.rangeMckinney}
  faq={FAQ_ECOMMERCE}
  extraJsonLd={[HOWTO_SWITCH, HOWTO_WOO_SELL_GUNS]}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          FFL ecommerce
        </p>
        <h1
          class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl"
        >
          FFL Website Design and Ecommerce for Gun Stores
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-300" set:html={md("FFL website design at Coriolis is a WooCommerce store on your own domain that we build, host, and support, and you own it. You can sell what's on the shelf, dropship from 21 distributor catalogs, or both, and keep the register you already run. Plans run from Minute Man at $169 a month to FFL Accelerator at $569, and setup is $500 or $2,500, with no contract.")} />
        <div class="mt-8">
          <CtaRow talk showGsa={false} />
        </div>
        <EcommerceCluster current="ecommerce" />
      </div>
      <a
        href="https://store.therangeinmckinney.com/"
        class="order-first block w-full min-w-0 overflow-hidden rounded-2xl ring-1 ring-white/10 transition hover:ring-gold/50 lg:order-none"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          src={withBase(CANON_PATHS.rangeMckinney)}
          alt="A live Coriolis FFL ecommerce site. Browse and buy online, pick up in store. Opens in a new tab."
          width="1283"
          height="965"
          class="w-full min-w-0 object-contain bg-[#111]"
        />
      </a>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="plans">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="mb-6 text-sm text-zinc-400" set:html={md("Coriolis has 100+ clients and a [5-star Google rating](https://www.trustindex.io/reviews/coriolisagency.com), and is a member of NSSF, FPC and GOA.")} />
      <h2 class="mb-6 text-xl font-semibold text-white">{"The five monthly plans, from Minute Man through FFL Accelerator"}</h2>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">
        {
          PLANS.map((plan) => (
            <article
              id={plan.id}
              class:list={[
                "relative flex scroll-mt-24 flex-col rounded-2xl border p-5 lg:max-xl:px-3",
                plan.featured
                  ? "border-gold/60 bg-gold/5 lg:col-span-1"
                  : "border-zinc-800 bg-zinc-950/50",
                plan.badge ? "mt-3 lg:mt-0" : null,
              ]}
            >
              {plan.badge ? (
                <span class="pointer-events-none absolute bottom-[calc(100%+1px)] left-1/2 -translate-x-1/2 whitespace-nowrap rounded-t-full rounded-b-none bg-gold px-4 pt-1 pb-0.5 text-[11px] font-semibold leading-4 tracking-[0.04em] text-zinc-950">
                  {plan.badge}
                </span>
              ) : null}
              <p class="text-[13.2px] lg:text-[length:clamp(9px,calc(1.25vw_-_4px),12px)] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {plan.hook} <span aria-hidden="true">{PLAN_TAGLINE_EMOJI[plan.id]}</span>
              </p>
              <h3 class="mt-2 text-[1.35rem]/[2.1rem] lg:max-xl:text-[19px]/[2.1rem] font-semibold text-white">{plan.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${plan.price}
                <span class="text-sm font-medium text-zinc-500">/mo</span>
              </p>
              {plan.includesFrom ? (
                <p class="mt-2 text-xs text-zinc-500">
                  Everything in {plan.includesFrom} +
                </p>
              ) : null}
              {plan.description ? (
                <p class="mt-2 text-xs leading-relaxed text-zinc-300">{plan.description}</p>
              ) : null}
              <BulletList
                items={plan.features}
                variant={plan.bullets ?? "default"}
                listKey={plan.id}
                class="mt-4 flex-1 space-y-1.5 text-sm lg:max-xl:text-[12.5px] text-zinc-400"
              />
              {plan.offerSite ? (
                <p class="mt-4 text-sm">
                  <a href={plan.offerSite.href} class={linkClass} target="_blank" rel="noopener">
                    {plan.offerSite.label}
                  </a>
                </p>
              ) : null}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <TalkSection
    id="talk-plans"
    heading={"If you're not sure which plan fits, tell us how you sell today and we'll point you to the right one."}
    subline=""
  />

  <section class="border-b border-zinc-800/80 py-12" id="every-build">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"What every FFL website we build includes at setup"}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Every gun store website we build ships with the pieces an FFL needs to sell online.")} />
      <ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 text-sm leading-relaxed text-zinc-400">
        {buildIncludes.map((item) => <li set:html={md(item)} />)}
      </ul>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="stores-we-built">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Case studies of gun store websites we have already built"}</h2>
      <ul class="mt-4 max-w-3xl space-y-2 text-sm leading-relaxed text-zinc-400">
        {caseStudies.map((item) => <li set:html={md(item)} />)}
      </ul>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("These four client stores, announced in November 2026, are live now:")} />
      <ul class="mt-3 max-w-3xl space-y-2 text-sm leading-relaxed text-zinc-400">
        {newClients.map((item) => <li set:html={md(item)} />)}
      </ul>
      <p class="mt-6 max-w-3xl text-sm text-zinc-400" set:html={md("You can [read the November release](/press/four-firearms-businesses-choose-coriolis-for-custom-woocommerce-stores) or see [all of the case studies](/case-studies).")} />
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("If you're comparing other options first, read [a comparison of nine FFL store platforms](/best-ffl-ecommerce-website). If you already run the plugin, see [FFL Cockpit setup](/ffl-cockpit).")} />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="setup">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"One-time setup packages: Basic Setup at $500 or Retail Setup at $2,500"}</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          SETUP.map((s) => (
            <article class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {s.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{s.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${s.price.toLocaleString()}
                <span class="text-sm font-medium text-zinc-500"> one-time</span>
              </p>
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {s.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <a
                href={LINKS[s.checkoutKey]}
                class={`${btnPlan} mt-6`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {s.name}
              </a>
            </article>
          ))
        }
      </div>
      <p class="mt-6 max-w-3xl text-sm text-zinc-400" set:html={md("Setup and monthly, side by side, are on [what an FFL website costs](/ffl-website-cost). If you're not a retail shop, we also build [websites for ranges, gunsmiths and instructors](/websites-for-ranges-gunsmiths-instructors).")} />
    </div>
  </section>

  <section
    class="scroll-mt-24 border-b border-zinc-800/80 py-12"
    id="replace-template-website"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Replacing a template storefront with a WooCommerce site you own"}</h2>
      <div class="mt-4 max-w-3xl space-y-4 text-sm leading-relaxed text-zinc-400">
        <p set:html={md("AmmoReady and Gearfire put your inventory on pages you don't own: the same templates, ads you can't strip, and titles and slugs you don't write. Coriolis replaces that with WooCommerce on your domain, where you can sell what's on the shelf, dropship from twenty-one distributors, or both. Warlord and FFL Accelerator connect any POS that works with WooCommerce, such as AIM, MicroBiz, Trident 1 or Rapid Gun Systems. Monthly plans start at Minute Man $169, FFL Accelerator is $569, and setup is $500 or $2,500, and every plan includes gun-friendly hosting and [GunSearchEngine.com](https://www.gunsearchengine.com/for-dealers?utm_source=coriolisagency&utm_medium=referral&utm_campaign=ecommerce&utm_content=dealer-program).")} />
        <p set:html={md("On those template platforms, inventory changes while the page does not; you don't control the title, the slugs, or the copy, and you're in the same HTML as every other dealer on that platform. Coriolis is not affiliated with Gearfire or RetailBI.")} />
        <p set:html={md("Keep the register you already run, and we replace the website. WooCommerce can sell guns when a licensed FFL owns the store and checkout is built for dealer transfer, and the full answer is on [Can you use WooCommerce to sell guns?](/can-you-use-woocommerce-to-sell-guns)")} />
      </div>
      <h2 class="mt-10 text-xl font-semibold text-white">{"How a switch off another platform is done, in this order"}</h2>
      <ol
        class="mt-4 max-w-3xl list-decimal space-y-2 pl-5 text-sm leading-relaxed text-zinc-400"
      >
        {switchSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="pos">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Keep the register you already run, and connect it later if you want it synced"}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Warlord ($469/mo) and FFL Accelerator ($569/mo) connect the register you already run.")} />
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <li>
          <a href={withBase("gun-store-pos")} class={linkClass}>Gun Store POS</a>
        </li>
        {
          POS_PAGES.map((p) => (
            <li>
              <a href={withBase(p.slug)} class={linkClass}>
                {p.navLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="woocommerce">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">{"Selling guns on WooCommerce, and what that requires of the licensed dealer"}</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Yes, when the dealer is a licensed FFL and checkout is built for transfer. Serialized firearms ship FFL-to-FFL, and you write the titles and slugs. Shopify is a different platform, and we do not sell a Shopify gun-store product; see [WooCommerce vs Shopify for gun stores](/woocommerce-vs-shopify-for-gun-stores). Card processing sits outside the plan price; see [FFL payment processing](/ffl-payment-processing).")} />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Online-only FFLs need a valid FFL and a store; Militia ($269/mo) adds 21 distributor catalogs, firearm orders ship to a receiving FFL, and you can start with [FFL dropshipping](/firearms-dropshipping).")} id="online-only" />
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Militia and above list your catalog on 13 marketplaces, including GunBroker.com, AmmoSeek.com, Gun.Deals and WikiArms.com.")} />
    </div>
  </section>

  <FaqBlock items={FAQ_ECOMMERCE} heading={"The questions gun dealers ask us before they start a site"} />

  <section class="border-b border-zinc-800/80 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-500" set:html={md("By subscribing to any plan or purchasing any setup package you are agreeing to the terms of our [Master Services Agreement](/msa).")} />
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 space-y-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400" set:html={md("Use [FFL dropshipping](/firearms-dropshipping) to list distributor stock you don't keep on hand. Then bring buyers back with [FFL email marketing](/email-marketing-for-ffl-ecommerce) built for gun stores.")} />
      <CtaRow showGsa={false} />
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400">{"Our Founder and CEO is the guy that built and ran AmmoReady.com for 9 years."}</p>
    </div>
  </section>

  <TalkSection heading={"Tell us about the website you want and we'll make it happen."} subline={"We build, host, and support your open source WooCommerce website. There is no contract and you can cancel at any time."} contact={"You can reach us at [(279) 258-6771](tel:+12792586771) or [support@coriolisagency.com](mailto:support@coriolisagency.com)."} />
</BaseLayout>
